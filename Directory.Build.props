<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Pre-1.0: APIs change freely; packages are published as previews. -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview</VersionSuffix>
    <PackageProjectUrl>https://github.com/joadan/RioCharts</PackageProjectUrl>
    <RepositoryUrl>https://github.com/joadan/RioCharts</RepositoryUrl>
    <PackageTags>charts;blazor;svg</PackageTags>
    <Authors>Joakim Dangården</Authors>
    <Copyright>Copyright (c) 2026 Joakim Dangården</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/joadan/RioCharts/blob/master/CHANGELOG.md</PackageReleaseNotes>

    <!-- Symbols and Source Link, so users can step into the library code. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1734</NoWarn>
  </PropertyGroup>

  <!-- Deterministic paths in CI builds (GitHub Actions sets GITHUB_ACTIONS=true). -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)assets/icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)assets/nuget-readme.md" Pack="true" PackagePath="\README.md" Visible="false" />
  </ItemGroup>
</Project>
