<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Pre-1.0: APIs change freely; packages are published as previews. -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview</VersionSuffix>
    <PackageProjectUrl>https://github.com/joadan/RioCharts</PackageProjectUrl>
    <RepositoryUrl>https://github.com/joadan/RioCharts</RepositoryUrl>
    <PackageTags>charts;blazor;svg</PackageTags>
    <Authors>Joakim Dangården</Authors>
    <Copyright>Copyright (c) 2026 Joakim Dangården</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
</Project>
