<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- The packages target the current LTS and the latest .NET; apps and samples stay on the LTS. -->
    <LibraryTargetFrameworks>net10.0;net11.0</LibraryTargetFrameworks>

    <!-- Versions come from version.json and the git height (Nerdbank.GitVersioning).
         1.0 release candidate: the API is frozen; packages are published as -rc prereleases. -->
    <PackageProjectUrl>https://riocharts.com/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/joadan/RioCharts</RepositoryUrl>
    <PackageTags>charts;blazor;svg</PackageTags>
    <Authors>Joakim Dangården</Authors>
    <Copyright>Copyright (c) 2026 Joakim Dangården</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/joadan/RioCharts/blob/master/CHANGELOG.md</PackageReleaseNotes>

    <!-- Symbols and Source Link, so users can step into the library code. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1573;CS1734</NoWarn>
    <!-- Missing XML docs (CS1591) warn in the libraries under src only. -->
    <NoWarn Condition="!$(MSBuildProjectDirectory.Replace('\', '/').Contains('/src/'))">$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Deterministic paths in CI builds (GitHub Actions sets GITHUB_ACTIONS=true). -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.9.50" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)assets/icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)assets/nuget-readme.md" Pack="true" PackagePath="\README.md" Visible="false" />
  </ItemGroup>
</Project>
