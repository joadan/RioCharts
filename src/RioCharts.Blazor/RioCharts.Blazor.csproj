<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
    <Nullable>enable</Nullable>
    <!-- Trimming and native AOT: turns on the analyzers and marks the assembly trimmable. -->
    <IsAotCompatible>true</IsAotCompatible>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>Blazor charts rendered as SVG, built on RioCharts.Core. Provides a responsive &lt;RioChart&gt; with line, area, bar, pie, donut and radial bar series, tooltips, zoom and pan, annotations, live data, an interactive legend, light and dark themes through CSS variables, and a tiny JS module for measurement and interaction.</Description>
    <PackageTags>$(PackageTags);dataviz;time-series;razor</PackageTags>
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RioCharts.Tests" />
    <InternalsVisibleTo Include="RioCharts.Blazor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Each target framework builds against its own ASP.NET Core. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0" Condition="'$(TargetFramework)' == 'net11.0'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RioCharts.Core\RioCharts.Core.csproj" />
  </ItemGroup>

</Project>
