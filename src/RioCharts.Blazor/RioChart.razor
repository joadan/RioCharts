@namespace RioCharts.Blazor
@typeparam TItem
@attribute [CascadingTypeParameter(nameof(TItem))]
@implements IAsyncDisposable
@using RioCharts.Blazor.Rendering

<CascadingValue TValue="IChartContext" Value="this" IsFixed="true">
    @ChildContent
</CascadingValue>

@{
    var layout = EnsureLayout();
    var scene = layout.Scene;
    var texts = CurrentTexts;
    var label = string.IsNullOrWhiteSpace(Title) ? texts.Chart : Title;
    var keys = KeyboardEnabled(layout);
}

<div @ref="_container" class="rio-chart @Class" style="@ContainerStyle">
    <svg class="rio-chart-svg"
         xmlns="http://www.w3.org/2000/svg"
         width="100%"
         height="@SvgWriter.N(scene.Height)"
         viewBox="0 0 @SvgWriter.N(scene.Width) @SvgWriter.N(scene.Height)"
         role="@(keys ? "application" : "img")"
         aria-roledescription="@(keys ? texts.ChartRole : null)"
         tabindex="@(keys ? "0" : null)"
         aria-label="@label"
         aria-describedby="@(keys ? $"{_id}-desc {_id}-keys" : _id + "-desc")">
        <title>@label</title>
        <desc id="@(_id + "-desc")">@scene.Description</desc>
        <SvgSceneRenderer Scene="scene" IdPrefix="@_id" OnInteraction="HandleInteraction" OmitSeries="UsesCanvas" LegendTips="Live" />
    </svg>
    @if (keys)
    {
        <span id="@(_id + "-keys")" class="rio-sr-only">@KeyboardHelp(layout)</span>
        @* Written by the JS module when a point gets keyboard focus; Blazor renders it empty. *@
        <div class="rio-live rio-sr-only" aria-live="polite" aria-atomic="true"></div>
    }
    @if (UsesCanvas)
    {
        @* Painted by the JS module; Blazor renders it empty. *@
        <canvas class="rio-canvas" aria-hidden="true" style="@($"height:{SvgWriter.N(scene.Height)}px")"></canvas>
    }
    @if (Live)
    {
        @* Filled by the JS module on hover; Blazor renders them empty and never touches their content.
           With a TooltipTemplate, Blazor fills the tooltip and JS only shows and places it. *@
        <svg class="rio-hover" aria-hidden="true" width="100%" height="@SvgWriter.N(scene.Height)"
             viewBox="0 0 @SvgWriter.N(scene.Width) @SvgWriter.N(scene.Height)"></svg>
        @* The legend items' summaries, shown by the JS module on hover and focus. *@
        <div class="rio-tooltip rio-legend-tip" aria-hidden="true"></div>
        <div class="rio-tooltip" aria-hidden="true">
            @if (TooltipTemplate is not null)
            {
                @TooltipHostFragment
            }
        </div>
    }
    @if (SpecErrors.Count > 0)
    {
        <ul class="rio-spec-errors" role="alert">
            @foreach (var error in SpecErrors.Take(5))
            {
                <li><code>@error.Path</code> @error.Message</li>
            }
        </ul>
    }
    @if (Zoomable && layout.Zoomed)
    {
        <button type="button" class="rio-reset-zoom" @onclick="OnResetZoomClick"
                style="@($"top:{SvgWriter.N(layout.Plot.Y + 4)}px;right:{SvgWriter.N(scene.Width - layout.Plot.Right + 4 + (Exportable && Live && ExportFormats != ExportFormats.None ? 32 : 0))}px")">@texts.ResetZoom</button>
    }
    @if (Exportable && Live && ExportFormats != ExportFormats.None)
    {
        var offered = OfferedFormats();
        var single = offered.Count == 1;
        var buttonLabel = single ? ChartTexts.Format(texts.DownloadFormat, Culture, null, ChartTexts.English.DownloadFormat, offered[0].Label) : texts.DownloadChart;
        <div class="rio-export @(_exportMenuOpen ? "rio-export-open" : null)" @onkeydown="OnExportMenuKey">
            <button type="button" class="rio-export-button" title="@buttonLabel" aria-label="@buttonLabel"
                    aria-haspopup="@(single ? null : "menu")" aria-expanded="@(single ? null : _exportMenuOpen ? "true" : "false")"
                    aria-controls="@(single ? null : _id + "-export")"
                    @onclick="OnExportButtonClick">
                <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <path d="M8 2.5v7.5M4.75 6.75 8 10l3.25-3.25M3 12.5h10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </button>
            @if (_exportMenuOpen && !single)
            {
                <div class="rio-export-backdrop" @onclick="CloseExportMenu"></div>
                <div class="rio-export-menu" role="menu" id="@(_id + "-export")" aria-label="@texts.Download">
                    @for (var i = 0; i < offered.Count; i++)
                    {
                        var format = offered[i].Format;
                        if (i == 0)
                        {
                            <button type="button" role="menuitem" @ref="_exportFirstItem" @onclick="@(() => ExportFromMenu(format))">@offered[i].Label</button>
                        }
                        else
                        {
                            <button type="button" role="menuitem" @onclick="@(() => ExportFromMenu(format))">@offered[i].Label</button>
                        }
                    }
                </div>
            }
        </div>
    }
</div>
