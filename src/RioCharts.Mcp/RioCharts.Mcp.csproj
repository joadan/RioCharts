<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>riocharts-mcp</ToolCommandName>
    <PackageId>RioCharts.Mcp</PackageId>
    <Description>A local MCP server (stdio) that lets AI agents such as Claude Code, Claude Desktop or GitHub Copilot render charts as PNG or SVG files from a JSON spec, with data from CSV and JSON files or inline rows. Install with dotnet tool install -g RioCharts.Mcp and run riocharts-mcp.</Description>
    <PackageTags>charts;dataviz;ai;agents;mcp;png;svg</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RioCharts.AI\RioCharts.AI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
  </ItemGroup>

  <!--
    SkiaSharp ships native Windows PDBs (about 100 MB each) next to libSkiaSharp.dll. A tool package
    contains its publish output, so they would bloat the package and, being Windows PDBs rather than
    portable ones, make NuGet reject the symbol package. Only native PDBs are dropped.
  -->
  <Target Name="DropNativePdbs" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Extension)' == '.pdb' and $([System.String]::Copy('%(RelativePath)').Replace('\', '/').StartsWith('runtimes/'))" />
    </ItemGroup>
  </Target>

</Project>
