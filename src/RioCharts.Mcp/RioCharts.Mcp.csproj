<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>riocharts-mcp</ToolCommandName>
    <PackageId>RioCharts.Mcp</PackageId>
    <Description>A local MCP server (stdio) that lets AI agents such as Claude Code, Claude Desktop or GitHub Copilot render charts as PNG or SVG files from a JSON spec, with data from CSV and JSON files or inline rows. Install with dotnet tool install -g RioCharts.Mcp and run riocharts-mcp.</Description>
    <PackageTags>charts;dataviz;ai;agents;mcp;png;svg</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RioCharts.AI\RioCharts.AI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
  </ItemGroup>

  <!--
    A tool package contains its publish output, including SkiaSharp's native library for every
    platform it supports (17) and its native Windows PDBs (about 100 MB each). The tool keeps the
    native library for the common platforms only, and no native PDBs: those are Windows PDBs, which
    would also make NuGet reject the symbol package.
  -->
  <PropertyGroup>
    <ToolPlatforms>;win-x64;win-arm64;win-x86;linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;osx;</ToolPlatforms>
  </PropertyGroup>

  <Target Name="TrimNativeAssets" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_NativeAsset Include="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(RelativePath)').Replace('\', '/').StartsWith('runtimes/'))">
        <Platform>$([System.String]::Copy('%(RelativePath)').Replace('\', '/').Split('/')[1])</Platform>
      </_NativeAsset>
      <ResolvedFileToPublish Remove="@(_NativeAsset)" Condition="'%(_NativeAsset.Extension)' == '.pdb' or !$(ToolPlatforms.Contains(';%(_NativeAsset.Platform);'))" />
    </ItemGroup>
  </Target>

</Project>
