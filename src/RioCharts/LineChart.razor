@typeparam TItem

<h3>LineChart</h3>

<div style="width:@Width;height:@Height">
    <svg viewBox="0 0 @boxWidth @boxHeight" style="border:1px solid lightgrey">

       @*Chart Axis*@
        <line x1="@origoX" y1="@origoY" x2="@origoX" y2="@topPadding" stroke="red" />
       
        <line x1="@origoX" y1="@origoY" x2="600"  y2="@origoY" stroke="red" />


    </svg>

</div>



