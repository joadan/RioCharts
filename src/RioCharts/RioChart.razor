@namespace RioCharts
@using RioCharts.Layout
@using RioCharts.Rendering

@{
    var plot = _layout.Plot;
    var tooltip = CurrentTooltip();
    var focusPoint = FocusPoint();
}

<div class="rio-chart @CssClass" style="@ContainerStyle">
    <svg @ref="_svg"
         class="@SvgClass"
         xmlns="http://www.w3.org/2000/svg"
         viewBox="0 0 @N(Width) @N(Height)"
         width="@N(Width)" height="@N(Height)"
         role="img"
         aria-label="@(string.IsNullOrWhiteSpace(Title) ? "Chart" : Title)"
         aria-describedby="@(_id + "-desc")"
         tabindex="@(EnableInteractions ? "0" : null)"
         @onkeydown="SvgKeyDown">
        <title>@(string.IsNullOrWhiteSpace(Title) ? "Chart" : Title)</title>
        <desc id="@(_id + "-desc")">@_summary</desc>

        <defs>
            <clipPath id="@ClipId">
                <rect x="@N(plot.Left)" y="@N(plot.Top)" width="@N(plot.Width)" height="@N(plot.Height)" />
            </clipPath>
        </defs>

        <rect class="rio-background" x="0" y="0" width="@N(Width)" height="@N(Height)" fill="@BackgroundColor" />

        @if (!string.IsNullOrWhiteSpace(Title))
        {
            <g class="rio-title-group">
                <text class="rio-title" x="@N(Width / 2)" y="@N(_chart.Margin.Top / 2)" text-anchor="middle" dominant-baseline="middle">@Title</text>
            </g>
        }

        @* ---------- Grid lines and axes ---------- *@
        @if (_layout.HasCartesian && _layout.XAxis is { } xAxis)
        {
            <g class="rio-grid" aria-hidden="true">
                @if (xAxis.Axis.ShowGridLines)
                {
                    @foreach (var tick in xAxis.Ticks)
                    {
                        var px = xAxis.ToPixel(tick);
                        <line x1="@N(px)" y1="@N(plot.Top)" x2="@N(px)" y2="@N(plot.Bottom)"
                              stroke="@xAxis.Axis.GridLineColor" stroke-width="@N(xAxis.Axis.GridLineWidth)" />
                    }
                }
                @if (_layout.YAxes.Count > 0 && _layout.YAxes[0] is { Axis.ShowGridLines: true } y0)
                {
                    @foreach (var tick in y0.Ticks)
                    {
                        var py = y0.ToPixel(tick);
                        <line x1="@N(plot.Left)" y1="@N(py)" x2="@N(plot.Right)" y2="@N(py)"
                              stroke="@y0.Axis.GridLineColor" stroke-width="@N(y0.Axis.GridLineWidth)" />
                    }
                }
            </g>

            <g class="rio-axis rio-axis-x" aria-label="@AxisAriaLabel("X axis", xAxis)">
                <line x1="@N(plot.Left)" y1="@N(plot.Bottom)" x2="@N(plot.Right)" y2="@N(plot.Bottom)" class="rio-axis-line" />
                @foreach (var tick in xAxis.Ticks)
                {
                    var px = xAxis.ToPixel(tick);
                    var ly = plot.Bottom + 8 + xAxis.Axis.LabelFontSize;
                    var ry = plot.Bottom + 10;
                    <g class="rio-tick">
                        <line x1="@N(px)" y1="@N(plot.Bottom)" x2="@N(px)" y2="@N(plot.Bottom + 5)" class="rio-axis-line" />
                        @if (xAxis.Axis.LabelRotation == 0)
                        {
                            <g>
                                <text x="@N(px)" y="@N(ly)" text-anchor="middle" fill="@xAxis.Axis.LabelColor"
                                      font-size="@N(xAxis.Axis.LabelFontSize)">@xAxis.FormatLabel(tick)</text>
                            </g>
                        }
                        else
                        {
                            <g>
                                <text x="@N(px)" y="@N(ry)" text-anchor="end" dominant-baseline="hanging" fill="@xAxis.Axis.LabelColor"
                                      font-size="@N(xAxis.Axis.LabelFontSize)"
                                      transform="rotate(@N(-xAxis.Axis.LabelRotation) @N(px) @N(ry))">@xAxis.FormatLabel(tick)</text>
                            </g>
                        }
                    </g>
                }
                @if (!string.IsNullOrWhiteSpace(xAxis.Axis.Title))
                {
                    <g>
                        <text class="rio-axis-title" x="@N(plot.CenterX)" y="@N(plot.Bottom + 14 + XLabelExtent() + 12)"
                              text-anchor="middle" dominant-baseline="hanging">@xAxis.Axis.Title</text>
                    </g>
                }
            </g>

            @foreach (var yAxis in _layout.YAxes)
            {
                var left = yAxis.Side == AxisSide.Left;
                var labelX = left ? yAxis.Offset - 8 : yAxis.Offset + 8;
                var anchor = left ? "end" : "start";
                <g class="rio-axis rio-axis-y" aria-label="@AxisAriaLabel(yAxis.Index == 0 ? "Y axis" : $"Y axis {yAxis.Index + 1}", yAxis)">
                    <line x1="@N(yAxis.Offset)" y1="@N(plot.Top)" x2="@N(yAxis.Offset)" y2="@N(plot.Bottom)" class="rio-axis-line" />
                    @foreach (var tick in yAxis.Ticks)
                    {
                        var py = yAxis.ToPixel(tick);
                        <g class="rio-tick">
                            <line x1="@N(yAxis.Offset)" y1="@N(py)" x2="@N(left ? yAxis.Offset - 5 : yAxis.Offset + 5)" y2="@N(py)" class="rio-axis-line" />
                            <text x="@N(labelX)" y="@N(py)" text-anchor="@anchor" dominant-baseline="middle" fill="@yAxis.Axis.LabelColor"
                                  font-size="@N(yAxis.Axis.LabelFontSize)">@yAxis.FormatLabel(tick)</text>
                        </g>
                    }
                    @if (!string.IsNullOrWhiteSpace(yAxis.Axis.Title))
                    {
                        var extent = YLabelExtent(yAxis) + 22;
                        var tx = left ? yAxis.Offset - extent : yAxis.Offset + extent;
                        <g>
                            <text class="rio-axis-title" x="@N(tx)" y="@N(plot.CenterY)" text-anchor="middle"
                                  transform="rotate(@(left ? "-90" : "90") @N(tx) @N(plot.CenterY))">@yAxis.Axis.Title</text>
                        </g>
                    }
                </g>
            }
        }

        @* ---------- Cartesian series (clipped to the plot area) ---------- *@
        <g class="rio-plot" clip-path="url(#@ClipId)">
            @* Pan/zoom previews transform this group until Blazor re-renders at the new range. *@
            <g class="rio-plot-content">
            @foreach (var s in _layout.Series)
            {
                if (!s.Series.Visible || s.IsEmpty)
                {
                    continue;
                }

                @if (s.Series is XYSeries xy)
                {
                    var markerColor = string.IsNullOrEmpty(xy.MarkerColor) ? s.Color : xy.MarkerColor;
                    <g @key="s.SeriesIndex" class="@SeriesClass(s)" opacity="@N(xy.Opacity)" aria-label="@SeriesAriaLabel(s)" role="group">
                        @if (s.BaselineY is { } baseline)
                        {
                            <path class="rio-area" d="@Svg.AreaPath(s.ScreenPoints, baseline)" fill="@FillFor(xy, s)"
                                  fill-opacity="@N(xy.FillOpacity)" stroke="none" />
                        }
                        @if (xy.ShowLine && xy.StrokeWidth > 0 && s.ScreenPoints.Count > 1)
                        {
                            <path class="rio-line" d="@Svg.LinePath(s.ScreenPoints)" fill="none" stroke="@s.Color"
                                  stroke-width="@N(LineWidth(xy, s))" stroke-linejoin="round" stroke-linecap="round"
                                  pathLength="@(EnableAnimations ? "1" : null)" />
                        }
                        @if (xy.Marker != MarkerStyle.None)
                        {
                            <g class="rio-markers">
                                @foreach (var p in s.ScreenPoints)
                                {
                                    @if (xy.Marker == MarkerStyle.Circle)
                                    {
                                        <circle cx="@N(p.X)" cy="@N(p.Y)" r="@N(xy.MarkerSize / 2)" fill="@markerColor" />
                                    }
                                    else if (Svg.IsStrokeMarker(xy.Marker))
                                    {
                                        <path d="@Svg.MarkerPath(xy.Marker, p.X, p.Y, xy.MarkerSize)" fill="none" stroke="@markerColor" stroke-width="1.5" />
                                    }
                                    else
                                    {
                                        <path d="@Svg.MarkerPath(xy.Marker, p.X, p.Y, xy.MarkerSize)" fill="@markerColor" />
                                    }
                                }
                            </g>
                        }
                        @if (DrawHitTargets(s))
                        {
                            var hitRadius = HitRadius(xy);
                            <g class="rio-hit">
                                @for (var i = 0; i < s.ScreenPoints.Count; i++)
                                {
                                    var index = i;
                                    var p = s.ScreenPoints[i];
                                    <circle cx="@N(p.X)" cy="@N(p.Y)" r="@N(hitRadius)" fill="transparent"
                                            @onmouseenter="() => PointEnter(s, index, false)"
                                            @onmouseleave="PointLeave"
                                            @onclick="e => PointClick(s, index, false, e)" />
                                }
                            </g>
                        }
                    </g>
                }
                else if (s.Series is XYZSeries xyz)
                {
                    var stroke = string.IsNullOrEmpty(xyz.StrokeColor) ? s.Color : xyz.StrokeColor;
                    <g @key="s.SeriesIndex" class="@SeriesClass(s)" opacity="@N(xyz.Opacity)" aria-label="@SeriesAriaLabel(s)" role="group">
                        @for (var i = 0; i < s.ScreenPoints.Count; i++)
                        {
                            var index = i;
                            var p = s.ScreenPoints[i];
                            @if (s.Intensities is { } intensities)
                            {
                                <rect class="rio-cell" x="@N(p.X - s.CellWidth / 2)" y="@N(p.Y - s.CellHeight / 2)"
                                      width="@N(s.CellWidth)" height="@N(s.CellHeight)"
                                      fill="@s.Color" fill-opacity="@N(0.08 + 0.92 * intensities[i])"
                                      stroke="@(xyz.StrokeColor ?? BackgroundColor)" stroke-width="@N(xyz.StrokeWidth)"
                                      @onmouseenter="() => PointEnter(s, index, false)"
                                      @onmouseleave="PointLeave"
                                      @onclick="e => PointClick(s, index, false, e)" />
                            }
                            else
                            {
                                var r = s.BubbleSizes?[i] ?? xyz.MinBubbleSize;
                                <circle class="rio-bubble" cx="@N(p.X)" cy="@N(p.Y)" r="@N(r)"
                                        fill="@s.Color" fill-opacity="0.6" stroke="@stroke"
                                        stroke-width="@N(xyz.StrokeWidth + (xyz.IsSelected ? 1.5 : 0))"
                                        @onmouseenter="() => PointEnter(s, index, false)"
                                        @onmouseleave="PointLeave"
                                        @onclick="e => PointClick(s, index, false, e)" />
                            }
                        }
                    </g>
                }
            }

            @if (focusPoint is { } fp)
            {
                <circle class="rio-focus-ring" cx="@N(fp.X)" cy="@N(fp.Y)" r="8" fill="none" />
            }
            </g>
        </g>

        @if (EnableCrosshair && EnableInteractions && _layout.HasCartesian)
        {
            <g class="rio-crosshair" visibility="hidden" pointer-events="none" aria-hidden="true">
                <line class="rio-crosshair-v" />
                <line class="rio-crosshair-h" />
                <g class="rio-crosshair-xlabel">
                    <rect rx="2" />
                    <text dominant-baseline="central"></text>
                </g>
                <g class="rio-crosshair-ylabel">
                    <rect rx="2" />
                    <text dominant-baseline="central"></text>
                </g>
            </g>
        }

        @if (EnablePanZoom && IsZoomed)
        {
            var bx = plot.Right - 84;
            var by = plot.Top - 26;
            <g class="rio-reset-zoom" role="button" tabindex="0" aria-label="Reset zoom"
               @onclick="ResetZoom" @onkeydown="ResetZoomKey" @onkeydown:stopPropagation="true">
                <rect x="@N(bx)" y="@N(by)" width="84" height="22" rx="4" />
                <text x="@N(bx + 42)" y="@N(by + 11)" text-anchor="middle" dominant-baseline="central">Reset zoom</text>
            </g>
        }

        @* ---------- Pie, donut and funnel series ---------- *@
        @foreach (var s in _layout.Series)
        {
            if (s.Series is not ValueSeries vs || !vs.Visible || s.Slices is not { Count: > 0 } slices)
            {
                continue;
            }

            <g @key="s.SeriesIndex" class="@SeriesClass(s)" opacity="@N(vs.Opacity)" aria-label="@SeriesAriaLabel(s)" role="group">
                @for (var i = 0; i < slices.Count; i++)
                {
                    var index = i;
                    var slice = slices[i];
                    var hovered = _hover is { IsSlice: true } h && h.SeriesIndex == s.SeriesIndex && h.ScreenIndex == i;
                    var focused = _focus is { IsSlice: true } f && f.SeriesIndex == s.SeriesIndex && f.ScreenIndex == i;
                    var d = slice.Polygon is { } poly
                        ? Svg.PolygonPath(poly)
                        : Svg.ArcPath(slice.Center, slice.OuterRadius, slice.InnerRadius, slice.StartAngle, slice.EndAngle);
                    <path class="rio-slice @(hovered ? "rio-slice-hover" : null) @(focused ? "rio-slice-focus" : null)"
                          d="@d" fill="@slice.Color" stroke="@BackgroundColor" stroke-width="1.5"
                          aria-label="@SliceAriaLabel(slice)"
                          @onmouseenter="() => PointEnter(s, index, true)"
                          @onmouseleave="PointLeave"
                          @onclick="e => PointClick(s, index, true, e)" />
                }
                @if (vs.ShowLabels)
                {
                    @foreach (var slice in slices)
                    {
                        var label = vs.Type == ValueSeriesType.Funnel ? FunnelLabel(slice) : slice.Fraction >= 0.05 ? slice.Fraction.ToString("P0") : null;
                        var outside = slice.Polygon is { } fp2 && label is not null
                            && ChartLayoutEngine.EstimateTextWidth(label, 12) + 8 > ((fp2[1].X - fp2[0].X) + (fp2[2].X - fp2[3].X)) / 2;
                        @if (label is not null && outside)
                        {
                            <g>
                                <text class="rio-slice-label rio-slice-label-outside" x="@N(Math.Max(slice.Polygon![1].X, slice.Polygon[2].X) + 8)"
                                      y="@N(slice.LabelPosition.Y)" dominant-baseline="middle">@label</text>
                            </g>
                        }
                        else if (label is not null)
                        {
                            <g>
                                <text class="rio-slice-label" x="@N(slice.LabelPosition.X)" y="@N(slice.LabelPosition.Y)"
                                      text-anchor="middle" dominant-baseline="middle" fill="@Svg.ContrastText(slice.Color)">@label</text>
                            </g>
                        }
                    }
                }
            </g>
        }

        @if (!_layout.HasData)
        {
            <g>
                <text class="rio-no-data" x="@N(plot.CenterX)" y="@N(plot.CenterY)" text-anchor="middle" dominant-baseline="middle">No data available</text>
            </g>
        }

        @* ---------- Legend ---------- *@
        @if (_layout.Legend is { } legend)
        {
            var ls = _chart.Legend;
            <g class="rio-legend">
                <rect x="@N(legend.X)" y="@N(legend.Y)" width="@N(legend.Width)" height="@N(legend.Height)" rx="3"
                      fill="@ls.BackgroundColor" fill-opacity="@N(ls.Opacity)" stroke="@ls.BorderColor" stroke-width="@N(ls.BorderWidth)" />
                @foreach (var item in legend.Items)
                {
                    var cy = item.Y + item.Height / 2;
                    var color = item.IsEmpty ? "#bbbbbb" : item.Color;
                    var symbolWidth = item.IsLine ? Math.Max(18, ls.MarkerSize * 1.8) : ls.MarkerSize;
                    <g class="rio-legend-item @(item.Enabled ? null : "rio-legend-off") @(item.IsEmpty ? "rio-legend-empty" : null)"
                       role="@(EnableInteractions ? "button" : null)"
                       tabindex="@(EnableInteractions ? "0" : null)"
                       aria-pressed="@(EnableInteractions ? (item.Enabled ? "true" : "false") : null)"
                       aria-label="@LegendAriaLabel(item)"
                       @onclick="() => LegendClick(item)"
                       @onkeydown="e => LegendKeyDown(item, e)">
                        <rect x="@N(item.X - 2)" y="@N(item.Y)" width="@N(item.Width + 4)" height="@N(item.Height)" fill="transparent" />
                        @if (item.IsLine)
                        {
                            <line x1="@N(item.X)" y1="@N(cy)" x2="@N(item.X + symbolWidth)" y2="@N(cy)" stroke="@color" stroke-width="2.5" />
                            @if (item.Marker == MarkerStyle.Circle)
                            {
                                <circle cx="@N(item.X + symbolWidth / 2)" cy="@N(cy)" r="@N(ls.MarkerSize / 3)" fill="@color" />
                            }
                            else if (item.Marker != MarkerStyle.None)
                            {
                                <path d="@Svg.MarkerPath(item.Marker, item.X + symbolWidth / 2, cy, ls.MarkerSize * 0.7)"
                                      fill="@(Svg.IsStrokeMarker(item.Marker) ? "none" : color)" stroke="@color" />
                            }
                        }
                        else if (item.Marker == MarkerStyle.Circle)
                        {
                            <circle cx="@N(item.X + symbolWidth / 2)" cy="@N(cy)" r="@N(ls.MarkerSize / 2)" fill="@color" />
                        }
                        else if (item.Marker is MarkerStyle.None or MarkerStyle.Square)
                        {
                            <rect x="@N(item.X)" y="@N(cy - ls.MarkerSize / 2)" width="@N(ls.MarkerSize)" height="@N(ls.MarkerSize)" rx="2" fill="@color" />
                        }
                        else
                        {
                            <path d="@Svg.MarkerPath(item.Marker, item.X + symbolWidth / 2, cy, ls.MarkerSize)"
                                  fill="@(Svg.IsStrokeMarker(item.Marker) ? "none" : color)" stroke="@color" stroke-width="1.5" />
                        }
                        <text x="@N(item.X + symbolWidth + 6)" y="@N(cy)" dominant-baseline="central"
                              font-size="@N(ls.FontSize)" fill="@(item.IsEmpty ? "#999999" : ls.FontColor)">@item.Label</text>
                    </g>
                }
            </g>
        }
    </svg>

    @if (tooltip is not null)
    {
        <div class="rio-tooltip" role="status" style="@TooltipStyle(tooltip)">@tooltip.Text</div>
    }
</div>

@code {
    private async Task ResetZoomKey(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " " or "Spacebar")
        {
            await ResetZoom();
        }
    }

    private static string AxisAriaLabel(string name, AxisLayout axis)
    {
        var title = string.IsNullOrWhiteSpace(axis.Axis.Title) ? name : $"{name}: {axis.Axis.Title}";
        return $"{title}, from {axis.FormatLabel(axis.Min)} to {axis.FormatLabel(axis.Max)}";
    }

    private static string SliceAriaLabel(SliceLayout slice) =>
        string.Format(System.Globalization.CultureInfo.CurrentCulture, "{0}: {1:N2} ({2:P1})", slice.Point.Label, slice.Point.Value, slice.Fraction);

    private static string FunnelLabel(SliceLayout slice) =>
        string.Format(System.Globalization.CultureInfo.CurrentCulture, "{0}: {1:N0}", slice.Point.Label, slice.Point.Value);

    private static string LegendAriaLabel(LegendItemLayout item)
    {
        var state = item.Enabled ? "shown" : "hidden";
        var empty = item.IsEmpty ? ", no data" : "";
        return $"{item.Label}, {state}{empty}";
    }
}
