<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Trimming and native AOT: turns on the analyzers and marks the assembly trimmable. -->
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Server-side export for RioCharts: renders the same chart model and layout as the Blazor components to SVG or PNG with SkiaSharp, with real text measurement. For reports, emails, Teams messages and AI agents.</Description>
    <PackageTags>charts;dataviz;time-series;svg;png;skia;export</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RioCharts.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RioCharts.Core\RioCharts.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.157.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.157.0" />
  </ItemGroup>

</Project>
