<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Trimming and native AOT: turns on the analyzers and marks the assembly trimmable. -->
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Charts for .NET: the RioCharts engine, with no UI dependencies, behind the Blazor component, server-side PNG/SVG export and AI chart tools. It turns a serializable chart definition plus data into a render-agnostic scene. It includes scales, nice and calendar-aware time ticks, culture-aware label formatting, line/area/bar layout, LTTB downsampling and hit-testing.</Description>
    <PackageTags>charts;dataviz;time-series</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RioCharts.Tests" />
    <EmbeddedResource Include="Geo\WorldCountries.txt" LogicalName="RioCharts.Core.Geo.WorldCountries.txt" />
  </ItemGroup>

</Project>
