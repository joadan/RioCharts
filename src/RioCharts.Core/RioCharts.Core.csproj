<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Trimming and native AOT: turns on the analyzers and marks the assembly trimmable. -->
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Charts for .NET: the RioCharts engine, with no UI dependencies, behind the Blazor component, server-side PNG/SVG export and AI chart tools. It holds the serializable chart model, the data types (columnar series, live buffers) and JSON chart definitions with their schema; the layout behind them handles scales, nice and calendar-aware time ticks, culture-aware labels and LTTB downsampling.</Description>
    <PackageTags>charts;dataviz;time-series</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RioCharts.Tests" />
    <InternalsVisibleTo Include="RioCharts.Blazor" />
    <InternalsVisibleTo Include="RioCharts.Blazor.Tests" />
    <InternalsVisibleTo Include="RioCharts.Skia" />
    <InternalsVisibleTo Include="RioCharts.AI" />
    <InternalsVisibleTo Include="RioCharts.Benchmarks" />
    <InternalsVisibleTo Include="RioCharts.AotSmoke" />
    <EmbeddedResource Include="Geo\WorldCountries.txt" LogicalName="RioCharts.Core.Geo.WorldCountries.txt" />
  </ItemGroup>

</Project>
