<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Trimming and native AOT: turns on the analyzers and marks the assembly trimmable. -->
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Chart engine for RioCharts with no UI dependencies. It turns a serializable chart spec plus data into a render-agnostic scene. It includes scales, nice and calendar-aware time ticks, culture-aware label formatting, line/area/bar layout, LTTB downsampling and hit-testing.</Description>
    <PackageTags>charts;dataviz;time-series</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RioCharts.Tests" />
  </ItemGroup>

</Project>
