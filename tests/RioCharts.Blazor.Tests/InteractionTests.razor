@inherits ChartTestBase

@code {
    [Fact]
    public void Legend_click_hides_the_series_and_raises_the_events()
    {
        IReadOnlyCollection<string>? hidden = null;
        LegendClickEventArgs? clicked = null;
        var cut = Render<RioChart<Reading>>(@<RioChart TItem="Reading"
                                                      HiddenSeriesChanged="@((IReadOnlyCollection<string> h) => hidden = h)"
                                                      OnLegendClick="@((LegendClickEventArgs e) => clicked = e)">
            <LineSeries Id="supply" Items="Supply" Name="Supply" XValue="r => r.Time" YValue="r => r.Value" />
            <LineSeries Id="extract" Items="Extract" Name="Extract" XValue="r => r.Time" YValue="r => r.Value" />
        </RioChart>);
        var supply = cut.FindAll("[role=button][aria-pressed]").First(e => e.TextContent.Contains("Supply"));
        Assert.Equal("true", supply.GetAttribute("aria-pressed"));

        supply.Click();

        Assert.Equal(["supply"], hidden);
        Assert.Equal(new LegendClickEventArgs("supply", "Supply", false), clicked);
        var after = cut.FindAll("[role=button][aria-pressed]").First(e => e.TextContent.Contains("Supply"));
        Assert.Equal("false", after.GetAttribute("aria-pressed"));
    }

    [Fact]
    public void Legend_responds_to_the_keyboard()
    {
        LegendClickEventArgs? clicked = null;
        var cut = Render<RioChart<Reading>>(@<RioChart TItem="Reading" OnLegendClick="@((LegendClickEventArgs e) => clicked = e)">
            <LineSeries Id="supply" Items="Supply" Name="Supply" XValue="r => r.Time" YValue="r => r.Value" />
            <LineSeries Id="extract" Items="Extract" Name="Extract" XValue="r => r.Time" YValue="r => r.Value" />
        </RioChart>);

        cut.FindAll("[role=button][aria-pressed]").First(e => e.TextContent.Contains("Extract")).KeyDown(new KeyboardEventArgs { Key = "Enter" });

        Assert.Equal("extract", clicked?.SeriesId);
    }

    [Fact]
    public void ZoomTo_raises_VisibleRangeChanged_with_the_range()
    {
        ChartRange? range = null;
        var cut = Render<RioChart<Reading>>(@<RioChart TItem="Reading" Zoomable="true" VisibleRangeChanged="@((ChartRange? r) => range = r)">
            <LineSeries Items="Supply" Name="Supply" XValue="r => r.Time" YValue="r => r.Value" />
        </RioChart>);

        cut.InvokeAsync(() => cut.Instance.ZoomToAsync(ChartRange.Of(Start.AddHours(1), Start.AddHours(2))));

        Assert.Equal(Start.AddHours(1), range?.Min);
        Assert.Equal(Start.AddHours(2), range?.Max);
        Assert.NotNull(cut.Instance.GetVisibleRange());
        Assert.NotEmpty(cut.FindAll(".rio-reset-zoom"));
    }

    [Fact]
    public void OnZoomChanging_can_cancel_a_zoom()
    {
        var changed = false;
        var cut = Render<RioChart<Reading>>(@<RioChart TItem="Reading" Zoomable="true"
                                                      OnZoomChanging="@((ZoomChangingEventArgs e) => e.Cancel = true)"
                                                      VisibleRangeChanged="@((ChartRange? _) => changed = true)">
            <LineSeries Items="Supply" Name="Supply" XValue="r => r.Time" YValue="r => r.Value" />
        </RioChart>);

        cut.InvokeAsync(() => cut.Instance.ZoomToAsync(ChartRange.Of(Start.AddHours(1), Start.AddHours(2))));

        Assert.False(changed);
        Assert.Null(cut.Instance.GetVisibleRange());
        Assert.Empty(cut.FindAll(".rio-reset-zoom"));
    }

    [Fact]
    public void Point_click_reports_every_item_of_an_aggregated_point()
    {
        PointClickEventArgs<Alarm>? clicked = null;
        var cut = Render<RioChart<Alarm>>(@<RioChart TItem="Alarm" Items="Alarms" OnPointClick="@((PointClickEventArgs<Alarm> e) => clicked = e)">
            <BarSeries Id="alarms" Name="Alarm time" XValue="a => a.Unit" YValue="a => a.Minutes" Aggregate="Aggregate.Sum" />
        </RioChart>);

        cut.InvokeAsync(() => cut.Instance.OnPointClicked("alarms", 0)); // what the JS module calls

        Assert.Equal("AHU 1", clicked?.X);
        Assert.Equal(15, clicked?.Y);
        Assert.Equal([Alarms[0], Alarms[2]], clicked?.Items);
        Assert.Equal(Alarms[0], clicked?.Item);
    }

    [Fact]
    public void Point_click_out_of_range_is_ignored()
    {
        var raised = false;
        var cut = Render<RioChart<Reading>>(@<RioChart TItem="Reading" OnPointClick="@((PointClickEventArgs<Reading> _) => raised = true)">
            <LineSeries Id="supply" Items="Supply" Name="Supply" XValue="r => r.Time" YValue="r => r.Value" />
        </RioChart>);

        cut.InvokeAsync(() => cut.Instance.OnPointClicked("supply", 99));
        cut.InvokeAsync(() => cut.Instance.OnPointClicked("nope", 0));

        Assert.False(raised);
    }

    [Fact]
    public void Legend_items_carry_their_summary_for_the_styled_tooltip()
    {
        var cut = Render<RioChart<Reading>>(@<RioChart TItem="Reading" Culture="System.Globalization.CultureInfo.InvariantCulture">
            <LineSeries Items="Supply" Name="Supply" XValue="r => r.Time" YValue="r => r.Value" Format="0.0 °C" />
            <LineSeries Items="Extract" Name="Extract" XValue="r => r.Time" YValue="r => r.Value" />
        </RioChart>);

        var item = cut.Find(".rio-legend-item");
        Assert.StartsWith("Supply: ", item.GetAttribute("data-tip"));
        Assert.Equal(item.GetAttribute("data-tip"), item.GetAttribute("aria-description"));
        Assert.Empty(item.QuerySelectorAll("title")); // no second, native tooltip
        Assert.Single(cut.FindAll(".rio-legend-tip"));
    }

    [Fact]
    public void Scatter_series_draw_markers_and_ask_for_2D_hover()
    {
        var cut = Render<RioChart<Reading>>(@<RioChart TItem="Reading">
            <ScatterSeries Items="Supply" Name="Supply" XValue="r => r.Value" YValue="r => r.Value + 2" TrendLine="true" />
        </RioChart>);

        Assert.NotEmpty(cut.FindAll("path.rio-marker"));
        Assert.NotEmpty(cut.FindAll("path.rio-trend"));
        var model = Payload(Calls("update")[^1]);
        Assert.False(model.GetProperty("shared").GetBoolean());
        Assert.True(model.GetProperty("series")[0].GetProperty("dots").GetBoolean());
    }

    [Fact]
    public void Heatmap_rows_draw_cells_and_send_cell_sizes()
    {
        var cut = Render<RioChart<Reading>>(@<RioChart TItem="Reading">
            <HeatmapSeries Items="Supply" Name="Mon" XValue="r => r.Time" YValue="r => r.Value" />
            <HeatmapSeries Items="Extract" Name="Tue" XValue="r => r.Time" YValue="r => r.Value" />
        </RioChart>);

        Assert.Equal(["Mon", "Tue"], cut.FindAll("text.rio-row-label").Select(t => t.TextContent));
        Assert.NotEmpty(cut.FindAll("g.rio-series-heatmap rect"));
        var series = Payload(Calls("update")[^1]).GetProperty("series")[0];
        Assert.True(series.GetProperty("ch").GetSingle() > 0);
    }

    [Fact]
    public void Range_area_takes_low_and_high_selectors()
    {
        var cut = Render<RioChart<Reading>>(@<RioChart TItem="Reading" Culture="System.Globalization.CultureInfo.InvariantCulture">
            <RangeAreaSeries Items="Supply" Name="Range" XValue="r => r.Time" LowValue="r => r.Value - 1" HighValue="r => r.Value + 1" Format="0.0" />
        </RioChart>);

        Assert.Single(cut.FindAll("path.rio-range"));
        var values = Payload(Calls("update")[^1]).GetProperty("series")[0].GetProperty("v");
        Assert.Equal("18.5 – 20.5", values[0].GetString());
    }

    [Fact]
    public void An_aggregated_range_keeps_the_lowest_low()
    {
        var cut = Render<RioChart<Reading>>(@<RioChart TItem="Reading" Culture="System.Globalization.CultureInfo.InvariantCulture">
            <RangeAreaSeries Items="Supply" Name="Range" XValue="r => r.Time.Date" LowValue="r => r.Value" HighValue="r => r.Value" Aggregate="Aggregate.Max" Format="0.0" />
        </RioChart>);

        var values = Payload(Calls("update")[^1]).GetProperty("series")[0].GetProperty("v");
        Assert.Equal("19.5 – 20.8", values[0].GetString()); // min and max of the day's readings
    }

    [Fact]
    public void Horizontal_bar_charts_send_each_bar_size()
    {
        var cut = Render<RioChart<Alarm>>(@<RioChart TItem="Alarm" Items="Alarms" Horizontal="true">
            <BarSeries Name="Minutes" XValue="a => a.Unit" YValue="a => a.Minutes" Aggregate="Aggregate.Sum" />
        </RioChart>);

        Assert.Equal(["AHU 1", "AHU 2"], cut.FindAll("text.rio-row-label").Select(t => t.TextContent));
        var series = Payload(Calls("update")[^1]).GetProperty("series")[0];
        Assert.Equal(2, series.GetProperty("cw").GetArrayLength());
        Assert.True(series.GetProperty("ch").GetSingle() > 0);
    }
}
