@inherits ChartTestBase

@code {
    [Fact]
    public void Legend_click_hides_the_series_and_raises_the_events()
    {
        IReadOnlyCollection<string>? hidden = null;
        LegendClickEventArgs? clicked = null;
        var cut = Render<RioChart<Reading>>(@<RioChart TItem="Reading"
                                                      HiddenSeriesChanged="@((IReadOnlyCollection<string> h) => hidden = h)"
                                                      OnLegendClick="@((LegendClickEventArgs e) => clicked = e)">
            <LineSeries Id="london" Items="London" Name="London" XValue="r => r.Time" YValue="r => r.Value" />
            <LineSeries Id="toronto" Items="Toronto" Name="Toronto" XValue="r => r.Time" YValue="r => r.Value" />
        </RioChart>);
        var london = cut.FindAll("[role=button][aria-pressed]").First(e => e.TextContent.Contains("London"));
        Assert.Equal("true", london.GetAttribute("aria-pressed"));

        london.Click();

        Assert.Equal(["london"], hidden);
        Assert.Equal(new LegendClickEventArgs("london", "London", false), clicked);
        var after = cut.FindAll("[role=button][aria-pressed]").First(e => e.TextContent.Contains("London"));
        Assert.Equal("false", after.GetAttribute("aria-pressed"));
    }

    [Fact]
    public void Legend_responds_to_the_keyboard()
    {
        LegendClickEventArgs? clicked = null;
        var cut = Render<RioChart<Reading>>(@<RioChart TItem="Reading" OnLegendClick="@((LegendClickEventArgs e) => clicked = e)">
            <LineSeries Id="london" Items="London" Name="London" XValue="r => r.Time" YValue="r => r.Value" />
            <LineSeries Id="toronto" Items="Toronto" Name="Toronto" XValue="r => r.Time" YValue="r => r.Value" />
        </RioChart>);

        cut.FindAll("[role=button][aria-pressed]").First(e => e.TextContent.Contains("Toronto")).KeyDown(new KeyboardEventArgs { Key = "Enter" });

        Assert.Equal("toronto", clicked?.SeriesId);
    }

    [Fact]
    public void A_zoom_from_code_reaches_the_linked_charts()
    {
        ChartRange? bound = null;
        var cut = Render<RioChart<Reading>>(@<RioChart TItem="Reading" Zoomable="true" Group="g" VisibleRange="bound">
            <LineSeries Items="London" Name="London" XValue="r => r.Time" YValue="r => r.Value" />
        </RioChart>);
        Assert.Empty(Module.Invocations["zoomGroup"]);

        // A bound VisibleRange set by the parent (e.g. a "Zoom to" button), ZoomToAsync and ResetZoomAsync.
        bound = ChartRange.Of(Start.AddHours(1), Start.AddHours(2));
        cut.Render(p => p.Add(c => c.VisibleRange, bound));
        cut.InvokeAsync(() => cut.Instance.ResetZoomAsync());

        var calls = Calls("zoomGroup");
        Assert.Equal(2, calls.Count);
        Assert.Equal(TimeValue.FromDateTime(Start.AddHours(1)), (double)calls[0].Arguments[1]!);
        Assert.Null(calls[1].Arguments[1]); // all data

        // A drag in the browser: the JS module zooms the linked charts itself.
        cut.InvokeAsync(() => cut.Instance.OnZoom(TimeValue.FromDateTime(Start.AddHours(1)), TimeValue.FromDateTime(Start.AddHours(3))));
        Assert.Equal(2, Calls("zoomGroup").Count);
    }

    [Fact]
    public void ZoomTo_raises_VisibleRangeChanged_with_the_range()
    {
        ChartRange? range = null;
        var cut = Render<RioChart<Reading>>(@<RioChart TItem="Reading" Zoomable="true" VisibleRangeChanged="@((ChartRange? r) => range = r)">
            <LineSeries Items="London" Name="London" XValue="r => r.Time" YValue="r => r.Value" />
        </RioChart>);

        cut.InvokeAsync(() => cut.Instance.ZoomToAsync(ChartRange.Of(Start.AddHours(1), Start.AddHours(2))));

        Assert.Equal(Start.AddHours(1), range?.Min);
        Assert.Equal(Start.AddHours(2), range?.Max);
        Assert.NotNull(cut.Instance.GetVisibleRange());
        Assert.NotEmpty(cut.FindAll(".rio-reset-zoom"));
    }

    [Fact]
    public void Reset_zoom_sits_in_the_top_row_when_it_fits_and_in_the_plot_otherwise()
    {
        var titled = Render<RioChart<Reading>>(@<RioChart TItem="Reading" Zoomable="true" Width="640" Title="Temperature">
            <LineSeries Items="London" Name="London" XValue="r => r.Time" YValue="r => r.Value" />
        </RioChart>);
        var bare = Render<RioChart<Reading>>(@<RioChart TItem="Reading" Zoomable="true" Width="640">
            <LineSeries Items="London" Name="London" XValue="r => r.Time" YValue="r => r.Value" />
        </RioChart>);
        var range = ChartRange.Of(Start.AddHours(1), Start.AddHours(2));

        titled.InvokeAsync(() => titled.Instance.ZoomToAsync(range));
        bare.InvokeAsync(() => bare.Instance.ZoomToAsync(range));

        // Above the plot, at the right edge (no download button here).
        var button = titled.Find(".rio-reset-zoom");
        Assert.Equal("top:0px;right:0px", button.GetAttribute("style"));
        // An icon, named by the chart's text.
        Assert.Equal("Reset zoom", button.GetAttribute("aria-label"));
        Assert.Equal("Reset zoom", button.GetAttribute("title"));
        Assert.Equal("", button.TextContent.Trim());
        // Nothing above the plot: inside its top right corner.
        var style = bare.Find(".rio-reset-zoom").GetAttribute("style")!;
        Assert.DoesNotContain("top:0px", style, StringComparison.Ordinal);
        Assert.StartsWith("top:", style, StringComparison.Ordinal);
    }

    [Fact]
    public void OnZoomChanging_can_cancel_a_zoom()
    {
        var changed = false;
        var cut = Render<RioChart<Reading>>(@<RioChart TItem="Reading" Zoomable="true"
                                                      OnZoomChanging="@((ZoomChangingEventArgs e) => e.Cancel = true)"
                                                      VisibleRangeChanged="@((ChartRange? _) => changed = true)">
            <LineSeries Items="London" Name="London" XValue="r => r.Time" YValue="r => r.Value" />
        </RioChart>);

        cut.InvokeAsync(() => cut.Instance.ZoomToAsync(ChartRange.Of(Start.AddHours(1), Start.AddHours(2))));

        Assert.False(changed);
        Assert.Null(cut.Instance.GetVisibleRange());
        Assert.Empty(cut.FindAll(".rio-reset-zoom"));
    }

    [Fact]
    public void Point_click_reports_every_item_of_an_aggregated_point()
    {
        PointClickEventArgs<Alarm>? clicked = null;
        var cut = Render<RioChart<Alarm>>(@<RioChart TItem="Alarm" Items="Alarms" OnPointClick="@((PointClickEventArgs<Alarm> e) => clicked = e)">
            <BarSeries Id="alarms" Name="Alarm time" XValue="a => a.Store" YValue="a => a.Minutes" Aggregate="Aggregate.Sum" />
        </RioChart>);

        cut.InvokeAsync(() => cut.Instance.OnPointClicked("alarms", 0)); // what the JS module calls

        Assert.Equal("Store 1", clicked?.X);
        Assert.Equal(15, clicked?.Y);
        Assert.Equal([Alarms[0], Alarms[2]], clicked?.Items);
        Assert.Equal(Alarms[0], clicked?.Item);
    }

    [Fact]
    public void Point_click_out_of_range_is_ignored()
    {
        var raised = false;
        var cut = Render<RioChart<Reading>>(@<RioChart TItem="Reading" OnPointClick="@((PointClickEventArgs<Reading> _) => raised = true)">
            <LineSeries Id="london" Items="London" Name="London" XValue="r => r.Time" YValue="r => r.Value" />
        </RioChart>);

        cut.InvokeAsync(() => cut.Instance.OnPointClicked("london", 99));
        cut.InvokeAsync(() => cut.Instance.OnPointClicked("nope", 0));

        Assert.False(raised);
    }

    [Fact]
    public void Legend_items_carry_their_summary_for_the_styled_tooltip()
    {
        var cut = Render<RioChart<Reading>>(@<RioChart TItem="Reading" Culture="System.Globalization.CultureInfo.InvariantCulture">
            <LineSeries Items="London" Name="London" XValue="r => r.Time" YValue="r => r.Value" Format="0.0 °C" />
            <LineSeries Items="Toronto" Name="Toronto" XValue="r => r.Time" YValue="r => r.Value" />
        </RioChart>);

        var item = cut.Find(".rio-legend-item");
        Assert.StartsWith("London: ", item.GetAttribute("data-tip"));
        Assert.Equal(item.GetAttribute("data-tip"), item.GetAttribute("aria-description"));
        Assert.Empty(item.QuerySelectorAll("title")); // no second, native tooltip
        Assert.Single(cut.FindAll(".rio-legend-tip"));
    }

    [Fact]
    public void The_chart_has_no_native_tooltip_over_it()
    {
        var cut = Render<RioChart<Reading>>(@<RioChart TItem="Reading" Title="Temperature">
            <LineSeries Items="London" Name="London" XValue="r => r.Time" YValue="r => r.Value" />
        </RioChart>);

        var svg = cut.Find("svg.rio-chart-svg");
        Assert.DoesNotContain(svg.Children, c => c.LocalName == "title"); // a browser would show it on hover
        Assert.Equal("Temperature", svg.GetAttribute("aria-label"));
    }

    [Fact]
    public void Scatter_series_draw_markers_and_ask_for_2D_hover()
    {
        var cut = Render<RioChart<Reading>>(@<RioChart TItem="Reading">
            <ScatterSeries Items="London" Name="London" XValue="r => r.Value" YValue="r => r.Value + 2" TrendLine="true" />
        </RioChart>);

        Assert.NotEmpty(cut.FindAll("path.rio-marker"));
        Assert.NotEmpty(cut.FindAll("path.rio-trend"));
        var model = Payload(Calls("update")[^1]);
        Assert.False(model.GetProperty("shared").GetBoolean());
        Assert.True(model.GetProperty("series")[0].GetProperty("dots").GetBoolean());
    }

    [Fact]
    public void Heatmap_rows_draw_cells_and_send_cell_sizes()
    {
        var cut = Render<RioChart<Reading>>(@<RioChart TItem="Reading">
            <HeatmapSeries Items="London" Name="Mon" XValue="r => r.Time" YValue="r => r.Value" />
