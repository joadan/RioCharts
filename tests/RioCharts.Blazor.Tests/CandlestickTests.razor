@inherits ChartTestBase

@code {
    private sealed record Temp(DateTime Time, double? Value);

    private sealed record Day(DateTime Date, double First, double Max, double Min, double Last);

    // Supply air temperature in °C every 15 minutes for two hours.
    private static readonly Temp[] Temps = Enumerable.Range(0, 8).Select(i => new Temp(Start.AddMinutes(15 * i), 20 + i % 4 * 0.5)).ToArray();

    [Fact]
    public void Readings_become_one_candle_per_bucket()
    {
        var cut = Render<RioChart<Temp>>(@<RioChart TItem="Temp" Items="Temps" Culture="System.Globalization.CultureInfo.InvariantCulture">
            <CandlestickSeries Id="t" Name="Supply" XValue="t => t.Time" YValue="t => t.Value" Bucket="TimeBucket.Hour" Format="0.0" />
        </RioChart>);

        Assert.Equal(2, cut.FindAll(".rio-candle").Count);
        var series = Payload(Calls("update")[^1]).GetProperty("series")[0];
        Assert.Equal("21.5", series.GetProperty("v")[0].GetString()); // the close
        Assert.Equal("Open", series.GetProperty("pl")[0].GetString());
        Assert.Equal("+1.5 (+7.5%)", series.GetProperty("pv")[0][4].GetString());
    }

    [Fact]
    public void Changing_the_bucket_rebuilds_the_candles()
    {
        var cut = Render<RioChart<Temp>>(@<RioChart TItem="Temp" Items="Temps">
            <CandlestickSeries Id="t" XValue="t => t.Time" YValue="t => t.Value" Bucket="TimeBucket.Hour" />
        </RioChart>);
        Assert.Equal(2, cut.FindAll(".rio-candle").Count);

        // The page renders again with a day bucket.
        cut.Render(p => p.Add(c => c.ChildContent, @<CandlestickSeries TItem="Temp" Id="t" XValue="t => t.Time" YValue="t => t.Value" Bucket="TimeBucket.Day" />));

        Assert.Single(cut.FindAll(".rio-candle"));
    }

    [Fact]
    public void Precomputed_candles_take_one_item_per_period()
    {
        Day[] days = [new(Start, 20, 22, 19, 21), new(Start.AddDays(1), 21, 21.5, 18.5, 19)];
        var cut = Render<RioChart<Day>>(@<RioChart TItem="Day" Items="days">
            <CandlestickSeries Id="d" XValue="d => d.Date" OpenValue="d => d.First" HighValue="d => d.Max" LowValue="d => d.Min" CloseValue="d => d.Last" />
        </RioChart>);

        Assert.Single(cut.FindAll(".rio-candle-up"));
        Assert.Single(cut.FindAll(".rio-candle-down"));
    }

    [Fact]
    public void Clicking_a_candle_selects_its_readings()
    {
        var cut = Render<RioChart<Temp>>(@<RioChart TItem="Temp" Items="Temps" Selection="SelectionMode.Points">
            <CandlestickSeries Id="t" XValue="t => t.Time" YValue="t => t.Value" Bucket="TimeBucket.Hour" />
        </RioChart>);

        cut.InvokeAsync(() => cut.Instance.OnPointClicked("t", 1, false));

        Assert.Equal(Temps.Skip(4), cut.Instance.GetSelectedItems());
    }
}
