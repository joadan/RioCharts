@inherits ChartTestBase

@code {
    private sealed record Step(string Name, double? Amount, bool IsTotal = false);

    // A month's result in k€.
    private static readonly Step[] Steps =
    [
        new("Revenue", 420), new("Cost of sales", -180), new("Gross profit", null, true), new("Salaries", -150), new("Result", null, true),
    ];

    [Fact]
    public void Items_marked_as_totals_show_the_running_total()
    {
        var cut = Render<RioChart<Step>>(@<RioChart TItem="Step" Items="Steps" Culture="System.Globalization.CultureInfo.InvariantCulture">
            <WaterfallSeries Id="w" Name="Result" XValue="s => s.Name" YValue="s => s.Amount" IsTotal="s => s.IsTotal" />
        </RioChart>);

        Assert.Equal(5, cut.FindAll(".rio-waterfall").Count);
        Assert.Equal(2, cut.FindAll(".rio-waterfall-total").Count);
        Assert.Single(cut.FindAll(".rio-connectors"));
        var series = Payload(Calls("update")[^1]).GetProperty("series")[0];
        // Hit-tested as a bar in its own slot, over the slot's whole height (the bars float).
        Assert.True(series.GetProperty("bar").GetBoolean());
        Assert.True(series.GetProperty("col").GetBoolean());
        Assert.Equal("90", series.GetProperty("v")[4].GetString()); // the result
        Assert.Equal("240", series.GetProperty("pv")[1][0].GetString()); // the running total after cost of sales
    }

    [Fact]
    public void Clicking_a_total_gives_its_item()
    {
        Step? clicked = null;
        var cut = Render<RioChart<Step>>(@<RioChart TItem="Step" Items="Steps" OnPointClick="e => clicked = e.Item">
            <WaterfallSeries Id="w" XValue="s => s.Name" YValue="s => s.Amount" IsTotal="s => s.IsTotal" />
        </RioChart>);

        cut.InvokeAsync(() => cut.Instance.OnPointClicked("w", 2, false));

        Assert.Equal(Steps[2], clicked);
    }
}
