@inherits ChartTestBase

@code {
    [Fact]
    public void Lays_out_at_the_width_the_browser_reports()
    {
        var cut = Render<RioChart<Reading>>(@<RioChart TItem="Reading" Height="240">
            <LineSeries Items="London" Name="London" XValue="r => r.Time" YValue="r => r.Value" />
        </RioChart>);

        Assert.Equal($"0 0 {Width} 240", cut.Find("svg.rio-chart-svg").GetAttribute("viewBox"));
        Assert.Single(Calls("init"));
        Assert.NotEmpty(Calls("update")); // the hover model went to JS
    }

    [Fact]
    public void Renders_without_JS_at_the_fallback_width()
    {
        Init.SetException(new JSException("No JS (static rendering)"));

        var cut = Render<RioChart<Reading>>(@<RioChart TItem="Reading" Title="Temperature">
            <LineSeries Items="London" Name="London" XValue="r => r.Time" YValue="r => r.Value" />
        </RioChart>);

        var svg = cut.Find("svg.rio-chart-svg");
        Assert.Equal("0 0 640 300", svg.GetAttribute("viewBox"));
        Assert.Equal("Temperature", svg.GetAttribute("aria-label"));
        Assert.NotEmpty(cut.FindAll("path"));
    }

    [Theory]
    [InlineData(0)]
    [InlineData(1)]
    public void Empty_and_single_point_data_render_a_clean_chart(int count)
    {
        var items = London.Take(count).ToArray();

        var cut = Render<RioChart<Reading>>(@<RioChart TItem="Reading" Items="items" Exportable="true">
            <LineSeries Name="London" XValue="r => r.Time" YValue="r => r.Value" />
        </RioChart>);

        Assert.NotNull(cut.Find("svg.rio-chart-svg"));
        Assert.Empty(cut.FindAll(".rio-spec-errors"));
        Assert.StartsWith("x,London", cut.Instance.ExportCsv());
    }

    [Fact]
    public void Spec_errors_are_listed()
    {
        var spec = new ChartDefinition
        {
            Data = [new Dictionary<string, object?> { ["time"] = "2026-11-16T00:00:00", ["temp"] = 20.5 }],
            Series = [new SeriesOptions { Id = "t", X = "time", Y = "tmep" }],
        };

        var cut = Render<RioChart<object>>(@<RioChart TItem="object" Definition="spec" />);

        Assert.NotEmpty(cut.Instance.DefinitionErrors);
        Assert.Contains("tmep", cut.Find(".rio-spec-errors").TextContent);
    }

    [Fact]
    public void Changing_items_lays_out_again()
    {
        var cut = Render<RioChart<Reading>>(@<RioChart TItem="Reading" Items="London.Take(2).ToArray()">
            <LineSeries Name="London" XValue="r => r.Time" YValue="r => r.Value" />
        </RioChart>);
        var before = cut.Instance.Layout;

        cut.Render(p => p.Add(c => c.Items, London));

        Assert.NotSame(before, cut.Instance.Layout);
        Assert.Contains("4 values", cut.Instance.Layout!.Scene.Description);
    }

    [Fact]
    public async Task Disposing_releases_the_module()
    {
        var cut = Render<RioChart<Reading>>(@<RioChart TItem="Reading">
            <LineSeries Items="London" Name="London" XValue="r => r.Time" YValue="r => r.Value" />
        </RioChart>);

        await DisposeComponentsAsync();

        Assert.Single(Calls("dispose"));
    }

    [Fact]
    public async Task JS_calls_only_get_arguments_that_are_safe_in_trimmed_apps()
    {
        // Blazor serializes interop arguments with reflection. In trimmed apps (Blazor WebAssembly
        // publish) and native AOT, anything but primitives breaks: anonymous types lose their
        // constructor parameter names. Payloads go as source-generated UTF-8 JSON bytes instead.
        var cut = Render<RioChart<Reading>>(@<RioChart TItem="Reading" Zoomable="true" Exportable="true" SeriesLayer="SeriesLayer.Canvas"
                                                       OnPointClick="@((PointClickEventArgs<Reading> _) => { })">
            <LineSeries Items="London" Name="London" XValue="r => r.Time" YValue="r => r.Value" />
            <ReferenceLine Value="20" Draggable="true" />
        </RioChart>);
        await cut.InvokeAsync(() => cut.Instance.DownloadPngAsync(options: new ChartImageOptions { Scale = 3 }));

        Assert.NotEmpty(Calls("paint"));
        var arguments = JSInterop.Invocations.Concat(Module.Invocations).SelectMany(i => i.Arguments).ToList();
        Assert.All(arguments, a => Assert.True(
            a is null or string or bool or double or float or int or long or byte[] or Microsoft.AspNetCore.Components.ElementReference
                || a.GetType().IsGenericType && a.GetType().GetGenericTypeDefinition() == typeof(DotNetObjectReference<>),
            $"{a!.GetType()} goes through reflection-based interop JSON"));
    }

    [Fact]
    public void Animate_false_marks_the_chart_still()
    {
        var moving = Render<RioChart<Reading>>(@<RioChart TItem="Reading" Class="mine">
            <LineSeries Items="London" Name="London" XValue="r => r.Time" YValue="r => r.Value" />
        </RioChart>);
        var still = Render<RioChart<Reading>>(@<RioChart TItem="Reading" Class="mine" Animate="false">
            <LineSeries Items="London" Name="London" XValue="r => r.Time" YValue="r => r.Value" />
        </RioChart>);

        Assert.Equal(["rio-chart", "mine"], moving.Find("div.rio-chart").ClassList);
        Assert.Equal(["rio-chart", "rio-still", "mine"], still.Find("div.rio-chart").ClassList);
    }
}
