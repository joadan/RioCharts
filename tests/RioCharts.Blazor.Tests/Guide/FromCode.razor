@* A chart built in code | A ChartSpec (the same model as JSON specs) with datasets instead of child components, e.g. for charts chosen at runtime. Fields are camelCase property names. *@
@using RioCharts.Core.Specs

<RioChart TItem="object" Spec="spec" Datasets="datasets" Height="280" />

@code {
    private sealed record Sale(string Region, double Amount);

    private readonly ChartSpec spec = new()
    {
        Title = "Sales per region",
        Series = [new SeriesSpec { Id = "sales", Type = SeriesType.Bar, Dataset = "sales", X = "region", Y = "amount", Aggregate = Aggregate.Sum }],
    };

    private readonly Dictionary<string, ChartDataset> datasets = new()
    {
        ["sales"] = ChartDataset.FromItems("sales", new[] { new Sale("North", 120), new Sale("South", 95), new Sale("North", 40) }),
    };
}
