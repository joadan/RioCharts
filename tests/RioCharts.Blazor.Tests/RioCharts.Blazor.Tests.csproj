<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Component tests for RioCharts.Blazor with bUnit: parameters, events, binding and markup.
       The JS module does not run here; JS calls are checked through bUnit's JS interop. -->
  <PropertyGroup>
    <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- BL0016 (.NET 11: guard JS interop with try/catch) is for app code; the tests call fakes on purpose. -->
    <NoWarn>$(NoWarn);BL0016</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" Version="2.15.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RioCharts.Blazor\RioCharts.Blazor.csproj" />
  </ItemGroup>

</Project>
