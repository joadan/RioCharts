<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Proves the libraries work trimmed and compiled with native AOT:
      dotnet publish tests/RioCharts.AotSmoke -c Release
    then run the published executable; it exits with 0 when every check passes.
    The publish must finish without IL2xxx/IL3xxx warnings.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGet audit advisories on the ILCompiler that ships with the SDK stay warnings: they are fixed by updating the SDK. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RioCharts.Core\RioCharts.Core.csproj" />
    <ProjectReference Include="..\..\src\RioCharts.Skia\RioCharts.Skia.csproj" />
    <ProjectReference Include="..\..\src\RioCharts.AI\RioCharts.AI.csproj" />
  </ItemGroup>

</Project>
