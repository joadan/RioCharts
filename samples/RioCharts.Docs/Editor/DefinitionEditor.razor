@* A chart editor for people, not for the JSON: pick the data and the fields to show, then one of the charts
   that fit them (drawn small with the data), adjust which field goes where, and fine-tune in a few folded sections that say what is set. "All options" at the end lists every option of
   the definition by its JSON name, for developers. It edits the JSON object it is given and raises Changed
   after every edit. Built in the docs site with a future editor component in mind; not part of 1.0. *@
@using System.Text.Json.Nodes
@using RioCharts.Core.Definitions

<div class="ce">
    @if (Definition is null)
    {
        <p class="ce-note">The JSON has an error. Fix it, and the options show here again.</p>
    }
    else
    {
        var seriesList = DefinitionProperties.List(Definition, "series");
        var index = seriesList is { Count: > 0 } ? Math.Min(_series, seriesList.Count - 1) : 0;
        var series = seriesList is { Count: > 0 } ? seriesList[index] as JsonObject : null;
        var dataset = DefinitionProperties.DatasetOf(Definition, series, Datasets);
        var kind = ChartKinds.Find(_parsed, index, dataset, _goal);
        var goal = _goal ?? kind?.Goal;

        @if (seriesList is { Count: > 1 })
        {
            <div class="ce-tabs" role="tablist" aria-label="Series">
                @for (var i = 0; i < seriesList.Count; i++)
                {
                    var n = i;
                    var s = seriesList[n] as JsonObject;
                    var active = n == index;
                    <button type="button" role="tab" aria-selected="@(active ? "true" : "false")" class="@(active ? "active" : null)" @onclick="() => SelectSeries(n)">
                        @(s?["name"]?.ToString() ?? s?["y"]?.ToString() ?? $"Series {n + 1}")
                    </button>
                }
            </div>
        }

        <h4 class="ce-step"><span>1</span> Your data</h4>
        <div class="ce-row">
            <label class="ce-label" for="ce-dataset">Data</label>
            <div class="ce-inputs">
                <select id="ce-dataset" value="@(Definition["dataset"]?.ToString() ?? "")" @onchange="e => SetDataset(e.Value?.ToString(), kind, series)">
                    @if (Definition["data"] is JsonArray { Count: > 0 })
                    {
                        <option value="">Rows in the definition</option>
                    }
                    else if (Definition["dataset"] is null)
                    {
                        <option value="">Choose</option>
                    }
                    @foreach (var name in Datasets.Keys)
                    {
                        <option value="@name" selected="@(string.Equals(name, Definition["dataset"]?.ToString(), StringComparison.OrdinalIgnoreCase))">@name</option>
                    }
                </select>
            </div>
            @if (dataset?.Description is { Length: > 0 } about)
            {
                <p class="ce-hint">@about</p>
            }
        </div>

        @if (dataset is not null)
        {
            var picked = Picked(dataset);
            <p class="ce-hint ce-fields-hint">Pick the fields to show:</p>
            <div class="ce-fields" role="group" aria-label="Fields to show">
                @foreach (var field in dataset.Fields)
                {
                    var on = picked.Contains(field);
                    <button type="button" class="ce-field @(on ? "picked" : null)" aria-pressed="@(on ? "true" : "false")"
                            @onclick="() => TogglePick(field, kind, series, dataset)">
                        <span class="ce-field-type" aria-hidden="true">@TypeMark(field.Type)</span>@field.Name
                    </button>
                }
            </div>
            @if (!_noChart && series is not null && kind?.Slots.Any(s => s.Part == SlotPart.Aggregate) == true)
            {
                @* How rows with the same category or period become one value: the choice that changes the numbers most. *@
                <div class="ce-row ce-aggregate">
                    <label class="ce-label" for="ce-aggregate">Combine rows</label>
                    <div class="ce-inputs">
                        <select id="ce-aggregate" value="@(series["aggregate"]?.ToString() ?? "")" @onchange="e => SetAggregate(e.Value?.ToString())">
                            @foreach (var (value, label) in ChartKinds.Aggregates)
                            {
                                var text = value switch
                                {
                                    "" => "Each value as it is",
                                    "count" => "Count the rows",
                                    _ => $"{label} {(seriesList is { Count: > 1 } ? "each value" : series["y"]?.ToString() ?? "the value")}",
                                };
                                <option value="@value" selected="@(value == (series["aggregate"]?.ToString() ?? ""))">@text</option>
                            }
                        </select>
                    </div>
                </div>
            }

            <h4 class="ce-step"><span>2</span> Pick a chart</h4>
            var suggestions = Suggestions(picked, index, dataset);
            @if (picked.Count == 0)
            {
                <p class="ce-note">Pick one or more fields above, and the charts that fit them show here.</p>
            }
            else if (suggestions.Count == 0)
            {
                <p class="ce-note">No chart shows these fields together. Pick fewer, or another mix, or choose under All charts.</p>
            }
            else
            {
                var shown = Shown(dataset);
                <div class="ce-suggestions">
                    @foreach (var (suggestion, preview) in suggestions.Take(4))
                    {
                        var current = suggestion.Kind == kind && shown.SetEquals(suggestion.Fields);
                        <div class="ce-suggestion @(current ? "selected" : null)" @key="@($"{suggestion.Kind.Id}/{suggestion.Caption}")">
                            <div class="ce-suggestion-chart" aria-hidden="true">
                                @if (preview is not null)
                                {
                                    <RioChart TItem="object" Definition="preview" Datasets="Datasets" Height="84" Compact="true" Interactive="false" Animate="false" />
                                }
                            </div>
                            <button type="button" class="ce-pick" aria-pressed="@(current ? "true" : "false")" @onclick="() => UseSuggestion(suggestion, kind, series, dataset)">
                                <strong>@suggestion.Kind.Label</strong>
                                <span>@suggestion.Caption</span>
                            </button>
                        </div>
                    }
                </div>
                @if (suggestions.Count > 4)
                {
                    <div class="ce-kinds ce-more">
                        <span class="ce-hint">Also:</span>
                        @foreach (var (suggestion, _) in suggestions.Skip(4))
                        {
                            var current = suggestion.Kind == kind && shown.SetEquals(suggestion.Fields);
                            <button type="button" class="ce-kind @(current ? "selected" : null)" title="@suggestion.Caption"
                                    @onclick="() => UseSuggestion(suggestion, kind, series, dataset)">@suggestion.Kind.Label</button>
                        }
                    </div>
                }
            }
        }

        <details class="ce-section ce-all-charts" open="@(dataset is null)">
            <summary><span class="ce-section-label">All charts</span><span class="ce-summary">@(kind?.Label ?? "By what you want to show")</span></summary>
            <div class="ce-section-body">
                <div class="ce-goals">
                    @foreach (var g in ChartKinds.Goals)
                    {
                        var selected = g.Id == goal;
                        // A goal none of whose charts this data can draw stays clickable, greyed, to say what it would need.
                        var fits = g.Id == kind?.Goal || ChartKinds.Of(g.Id).Any(k => ChartKinds.Missing(k, dataset) is null);
                        <button type="button" class="ce-goal @(selected ? "selected" : null) @(fits ? null : "unfit")" aria-pressed="@(selected ? "true" : "false")"
                                title="@(fits ? g.Hint : $"{g.Hint}. Not with this data.")"
                                @onclick="() => PickGoal(g, kind, series, dataset)">
                            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="@g.Icon" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
                            <span>@g.Label</span>
                        </button>
                    }
                </div>
                @if (goal is not null)
                {
                    <p class="ce-hint ce-goal-hint">@ChartKinds.Goal(goal).Hint@(kind is not null && kind.Goal != goal ? $". Pick one to switch from {kind.Label}." : "")</p>
                    <div class="ce-kinds" role="radiogroup" aria-label="Chart">
                        @foreach (var k in ChartKinds.Of(goal))
                        {
                            var selected = k == kind;
                            // The chart the series is stays pickable even when the data does not fit it.
                            var missing = selected ? null : ChartKinds.Missing(k, dataset);
                            <button type="button" role="radio" aria-checked="@(selected ? "true" : "false")" class="ce-kind @(selected ? "selected" : null)"
                                    disabled="@(missing is not null)" title="@(missing is null ? null : $"Needs {missing}")"
                                    @onclick="() => PickKind(k, kind, series, dataset)">@k.Label</button>
                        }
                    </div>
                    var unfit = ChartKinds.Of(goal).Where(k => k != kind).Select(k => (k.Label, Missing: ChartKinds.Missing(k, dataset))).Where(k => k.Missing is not null).ToList();
                    @if (unfit.Count > 0)
                    {
                        <p class="ce-hint ce-unfit">
                            Not with this data: @string.Join("; ", unfit.Select(k => $"{k.Label} needs {k.Missing}")).
                        </p>
                    }
                }
            </div>
        </details>

        @if (series is null)
        {
            <p class="ce-note">This definition has no series yet. Pick fields and a chart above to start one.</p>
        }
        else if (kind is null && _parsed?.Series.ElementAtOrDefault(index)?.Type == SeriesType.Auto)
        {
            <p class="ce-note">The chart type is automatic: picked from the data when it is drawn. Pick a chart above to choose one and see its options.</p>
        }
        else if (kind is null)
        {
            <p class="ce-note">
                This chart (<code>@(series["type"]?.ToString() ?? "line")</code>) has no simple form here yet. Pick a chart above to switch, or edit
                it under All options.
            </p>
        }
        else
        {
            <h4 class="ce-step"><span>3</span> Fields</h4>

            @foreach (var slot in kind.Slots)
            {
                @* Keyed by chart, slot, dataset and series: a select reused for another slot can keep showing its old field. *@
                <SlotRow @key="@($"{index}/{kind.Id}/{slot.Property}/{dataset?.Name}")" Slot="slot" Series="series" Dataset="dataset" Changed="Changed" />
            }

            @if (kind.Slots.Any(s => s.Property == "y"))
            {
                <button type="button" class="ce-link" @onclick="AddSeries">Add another value as a second series</button>
            }
            @if (seriesList!.Count > 1)
            {
                <button type="button" class="ce-link" @onclick="() => RemoveSeries(series)">Remove this series</button>
            }

            <h4 class="ce-step"><span>4</span> Fine-tune</h4>
            <div class="ce-sections">
                @foreach (var id in kind.Sections)
                {
                    @if (id == "lines")
                    {
                        <ReferenceLines Chart="Definition" Changed="Changed" />
                    }
                    else
                    {
                        var section = ChartKinds.Section(id);
                        <details class="ce-section">
                            <summary><span class="ce-section-label">@section.Label</span><span class="ce-summary">@Summary(section, series)</span></summary>
                            <div class="ce-section-body">
                                @foreach (var option in section.Options)
                                {
                                    <OptionRow @key="@($"{index}/{section.Id}/{option.Scope}/{option.Property}")" Chart="Definition" Series="series" Option="option" Changed="Changed" />
                                }
                            </div>
                        </details>
                    }
                }
            </div>
        }

        <details class="ce-section ce-all" open="@(kind is null)">
            <summary><span class="ce-section-label">All options</span><span class="ce-summary">Every option by its JSON name, for developers</span></summary>
            <div class="ce-section-body pe">
                <input class="pe-search" type="search" placeholder="Search, e.g. legend, format, stack" aria-label="Search all options"
                       value="@_search" @oninput="e => _search = e.Value?.ToString()" />
                @if (series is not null)
                {
                    <h5 class="pe-heading">This series</h5>
                    <PropertyGroup Target="series" Properties="SeriesProperty.Properties" Dataset="dataset" Search="@_search" MoreLabel="Series options" Changed="Changed" />
                }
                <h5 class="pe-heading">The chart</h5>
                <PropertyGroup Target="Definition" Properties="ChartProperties" Dataset="DefinitionProperties.DatasetOf(Definition, null, Datasets)" Search="@_search"
                               MoreLabel="Chart options" Changed="Changed" />
            </div>
        </details>
    }
</div>

@code {
    /// <summary>The definition as JSON; null while the text is not valid JSON.</summary>
    [Parameter] public JsonObject? Definition { get; set; }

    /// <summary>The datasets the editor offers and the field pickers read.</summary>
    [Parameter, EditorRequired] public IReadOnlyDictionary<string, ChartDataset> Datasets { get; set; } = default!;

    /// <summary>Raised after every edit of <see cref="Definition"/>.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    /// <summary>
    /// Raised with false when the fields picked make no chart (the chart shown would not match them, so the page
    /// hides it), and with true when they make one again.
    /// </summary>
    [Parameter] public EventCallback<bool> ChartShown { get; set; }

    private static readonly DefinitionProperty SeriesProperty = DefinitionProperties.Root.Child("series")!;

    private static readonly IReadOnlyList<DefinitionProperty> ChartProperties =
        [.. DefinitionProperties.Root.Properties.Where(p => p.Name is not ("series" or "data" or "version"))];

    private ChartDefinition? _parsed;
    private string? _goal;
    private string? _search;
    private int _series;

    // The definition as read (synonyms such as column or donut resolved), to tell which chart it is.
    protected override void OnParametersSet()
    {
        _parsed = Definition is null ? null : ChartDefinitionJson.Parse(Definition.ToJsonString()).Definition;
        if (!ReferenceEquals(_visitedFor, Definition))
        {
            _visited.Clear();
            _lastKind.Clear();
            _picked = null;
            _visitedFor = Definition;
        }
    }

    private Task SelectSeries(int index)
    {
        _series = index;
        _goal = null;
        _picked = null;
        return ShowChart(true);
    }

    // A goal switches to a chart at once: the one this series last was under that goal, else the goal's first.
    // Going back to a chart restores the series as it was there (see _visited), so looking around loses nothing.
    private Task PickGoal(ChartGoal goal, ChartKind? current, JsonObject? series, ChartDataset? dataset)
    {
        _goal = goal.Id;
        if (current?.Goal == goal.Id)
        {
            return Task.CompletedTask;
        }

        // The data must fit: a remembered chart may not after the dataset changed. None fits: the goal only shows
        // its charts, greyed, with what they need.
        var remembered = series is not null && _lastKind.TryGetValue(series, out var last) && last.TryGetValue(goal.Id, out var id)
            ? ChartKinds.All.First(k => k.Id == id)
            : null;
        var kind = remembered is not null && ChartKinds.Missing(remembered, dataset) is null
            ? remembered
            : ChartKinds.Of(goal.Id).FirstOrDefault(k => ChartKinds.Missing(k, dataset) is null);
        return kind is null ? Task.CompletedTask : PickKind(kind, current, series, dataset);
    }

    // Each series as it was under each chart it has been, so going back to a chart brings its fields back
    // instead of filling them in again, and the chart it last was under each goal. Kept until the definition is
    // replaced (an example, the JSON edited).
    private readonly Dictionary<JsonObject, Dictionary<string, JsonObject>> _visited = new(ReferenceEqualityComparer.Instance);
    private readonly Dictionary<JsonObject, Dictionary<string, string>> _lastKind = new(ReferenceEqualityComparer.Instance);
    private JsonObject? _visitedFor;

    private async Task PickKind(ChartKind kind, ChartKind? current, JsonObject? series, ChartDataset? dataset)
    {
        _goal = kind.Goal;
        if (kind == current)
        {
            return;
        }

        series ??= NewSeries();
        var states = Remember(series, current, kind);
        if (states.TryGetValue(kind.Id, out var earlier))
        {
            ChartKinds.Restore(kind, Definition!, series, earlier);
        }
        else
        {
            ChartKinds.Apply(kind, current, Definition!, series, dataset);
        }

        _picked = null;
        await Changed.InvokeAsync();
        await ShowChart(true);
    }

    private JsonObject NewSeries()
    {
        var series = new JsonObject();
        DefinitionProperties.List(Definition!, "series", create: true)!.Add(series);
        return series;
    }

    // Keeps the series as it is under the chart it is leaving, and which chart it was under each goal.
    private Dictionary<string, JsonObject> Remember(JsonObject series, ChartKind? current, ChartKind next)
    {
        if (!_visited.TryGetValue(series, out var states))
        {
            _visited[series] = states = [];
        }

        if (!_lastKind.TryGetValue(series, out var lastKind))
        {
            _lastKind[series] = lastKind = [];
        }

        if (current is not null)
        {
            states[current.Id] = (JsonObject)series.DeepClone();
            lastKind[current.Goal] = current.Id;
        }

        lastKind[next.Goal] = next.Id;
        return states;
    }

    // ----- Data first: pick fields, then one of the charts that fit them -----

    // The fields picked; null while they are the ones the chart shows (they follow the field pickers below).
    private List<string>? _picked;

    private IReadOnlyList<DataField> Picked(ChartDataset dataset) => _picked is null
        ? ChartKinds.FieldsOf(Definition, dataset)
        : [.. _picked.Select(dataset.Field).OfType<DataField>()];

    private HashSet<string> Shown(ChartDataset dataset) => [.. ChartKinds.FieldsOf(Definition, dataset).Select(f => f.Name)];

    // A pick changes the chart at once, to the best fit for the fields picked. When no chart fits (nothing
    // picked, or a mix none shows), the chart hides until the fields fit one, so it never shows fields the chips
    // say are not picked.
    private Task TogglePick(DataField field, ChartKind? current, JsonObject? series, ChartDataset dataset)
    {
        _picked ??= [.. ChartKinds.FieldsOf(Definition, dataset).Select(f => f.Name)];
        if (!_picked.Remove(field.Name))
        {
            _picked.Add(field.Name);
        }

        // Always the best fit, whatever the chart was: the same fields give the same chart in any order of taps
        // (a calendar of timestamp does not stay a calendar when revenue is added). Another card is one tap away.
        if (ChartKinds.Suggest([.. _picked.Select(dataset.Field).OfType<DataField>()]).FirstOrDefault() is { } best)
        {
            return UseSuggestion(best, current, series, dataset);
        }

        return ShowChart(false);
    }

    // Whether the fields picked make a chart; the page hides it while they do not.
    private bool _noChart;

    private Task ShowChart(bool shown)
    {
        if (_noChart == !shown)
        {
            return Task.CompletedTask;
        }

        _noChart = !shown;
        return ChartShown.InvokeAsync(shown);
    }

    // For every series: the fields picked make the chart as a whole (sessions and revenue are both summed).
    private Task SetAggregate(string? value)
    {
        foreach (var series in DefinitionProperties.List(Definition!, "series")?.OfType<JsonObject>() ?? [])
        {
            if (string.IsNullOrEmpty(value))
            {
                series.Remove("aggregate");
            }
            else
            {
                series["aggregate"] = value;
            }
        }

        return Changed.InvokeAsync();
    }

    private static string TypeMark(FieldType type) => type switch
    {
        FieldType.Number => "#",
        FieldType.Time => "◷",
        _ => "Aa",
    };

    // The suggestions and their previews, made again only when what they are made from changes.
    private IReadOnlyList<(ChartSuggestion Suggestion, ChartDefinition? Preview)> _suggestions = [];
    private string? _suggestionsFor;

    private IReadOnlyList<(ChartSuggestion Suggestion, ChartDefinition? Preview)> Suggestions(IReadOnlyList<DataField> picked, int index, ChartDataset dataset)
    {
        var key = $"{index}\n{dataset.Name}\n{string.Join("\n", picked.Select(f => f.Name))}\n{Definition!.ToJsonString()}";
        if (key != _suggestionsFor)
        {
            var all = ChartKinds.Suggest(picked);
            _suggestions = [.. all.Select((s, i) => (s, i < 4 ? Preview(s, index, dataset) : null))];
            _suggestionsFor = key;
        }

        return _suggestions;
    }

    // The chart as the suggestion would make it, small: this series alone, no title, legend or reference lines.
    private ChartDefinition? Preview(ChartSuggestion suggestion, int index, ChartDataset dataset)
    {
        var chart = (JsonObject)Definition!.DeepClone();
        var list = DefinitionProperties.List(chart, "series", create: true)!;
        var series = index < list.Count && list[index] is JsonObject s ? s : new JsonObject();
        list.Clear();
        list.Add(series);
        ChartKinds.Use(suggestion, null, chart, series, dataset);
        chart.Remove("title");
        chart.Remove("annotations");
        chart["legend"] = new JsonObject { ["mode"] = "hide" };
        return ChartDefinitionJson.Parse(chart.ToJsonString()).Definition;
    }

    private async Task UseSuggestion(ChartSuggestion suggestion, ChartKind? current, JsonObject? series, ChartDataset? dataset)
    {
        series ??= NewSeries();
        Remember(series, current, suggestion.Kind);
        ChartKinds.Use(suggestion, current, Definition!, series, dataset);
        _series = 0;
        _goal = suggestion.Kind.Goal;
        _picked = null;
        await Changed.InvokeAsync();
        await ShowChart(true);
    }

    private Task SetDataset(string? name, ChartKind? kind, JsonObject? series)
    {
        if (string.IsNullOrEmpty(name))
        {
            return Task.CompletedTask;
        }

        Definition!["dataset"] = name;
        Definition.Remove("data");
        _picked = null;
        _ = ShowChart(true);
        if (kind is null || series is null)
        {
            return Changed.InvokeAsync();
        }

        series.Remove("dataset");
        // The fields of another dataset rarely have the same names: start the slots again from its fields.
        if (Datasets.TryGetValue(name, out var dataset))
        {
            foreach (var slot in kind.Slots.Where(s => series[s.Property]?.ToString() is { } f && dataset.Field(f) is null))
            {
                series.Remove(slot.Property);
            }

            ChartKinds.Apply(kind, kind, Definition, series, dataset);
        }

        return Changed.InvokeAsync();
    }

    private Task AddSeries()
    {
        var list = DefinitionProperties.List(Definition!, "series", create: true)!;
        var copy = list.Count > 0 && list[^1] is JsonObject last ? (JsonObject)last.DeepClone() : new JsonObject { ["type"] = "line" };
        copy.Remove("id");
        copy.Remove("name");
        copy.Remove("y");
        list.Add(copy);
        _series = list.Count - 1;
        return Changed.InvokeAsync();
    }

    private Task RemoveSeries(JsonObject series)
    {
        DefinitionProperties.List(Definition!, "series")?.Remove(series);
        _series = Math.Max(0, _series - 1);
        return Changed.InvokeAsync();
    }

    /// <summary>What a folded section has set, in its own words: "Largest first, top 10", or "Automatic".</summary>
    private string Summary(EditorSection section, JsonObject series)
    {
        var parts = new List<string>();
        foreach (var option in section.Options)
        {
            if (ChartKinds.Target(Definition!, series, option.Scope, create: false)?[option.Property] is not { } node)
            {
                continue;
            }

            var text = ChartKinds.Canonical(OptionRow.Text(node));
            var label = option.Choices?.FirstOrDefault(c => c.Value == text).Label;
            parts.Add(option.Control switch
            {
                OptionControl.Toggle => text == "true" ? option.Label : "",
                OptionControl.Choice => label ?? text,
                OptionControl.Text when option.Property == "title" && option.Scope == OptionScope.Chart => $"\"{text}\"",
                _ => $"{option.Label.ToLowerInvariant()} {text}",
            });
        }

        parts.RemoveAll(p => p.Length == 0);
        if (parts.Count == 0)
        {
            return "Automatic";
        }

        var summary = string.Join(", ", parts);
        return summary.Length > 60 ? summary[..57] + "…" : summary;
    }

    /// <summary>Shows the first series again, e.g. after a new definition was loaded.</summary>
    public void Reset()
    {
        _series = 0;
        _goal = null;
        _visited.Clear();
        _lastKind.Clear();
        _picked = null;
    }
}
