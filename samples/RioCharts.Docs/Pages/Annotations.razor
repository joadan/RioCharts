@page "/annotations"

<PageTitle>Annotations · RioCharts for Blazor and .NET</PageTitle>

<h1>Annotations</h1>
<p class="lead">
    Mark what matters on a chart: target lines, campaign periods, maintenance windows and events. Muted by default, so they support the data.
</p>

<Example Title="Lines, bands, points and callouts" Code="@AllCode">
    <Description>
        <p>
            Reference lines expand the axis so they are always visible; bands do not. Values can be numbers, times or category names. Here an
            evening sale and a night-time maintenance window are bands on the time axis, the traffic target is a line, and the peak and the
            newsletter are marked on the data. Hover an annotation for its value.
        </p>
    </Description>
    <ChildContent>
        <RioChart TItem="Reading" YAxis="Sessions" OnAnnotationClick="e => _clicked = e.Label">
            <ReferenceLine Value="200" Label="Target" />
            <ReferenceBand Axis="AnnotationAxis.X" From="_saleStart" To="_saleEnd" Label="Evening sale" />
            <ReferenceBand Axis="AnnotationAxis.X" From="_maintenanceStart" To="_maintenanceEnd" Label="Maintenance" Color="#d9480f" />
            <ReferenceLine Axis="AnnotationAxis.X" Value="_now" Label="Now" />
            <PointAnnotation X="_peak" Y="252" Label="Peak: 252 sessions" Color="#d9480f" />
            <Callout X="_newsletter" Y="34" Label="Newsletter sent" OffsetX="-30" OffsetY="-36" />
            <LineSeries Items="WebSessions" Name="Web" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" />
            <LineSeries Items="AppSessions" Name="App" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" />
        </RioChart>
        <p class="note">Clicked: @(_clicked ?? "nothing yet (click an annotation)")</p>
    </ChildContent>
</Example>

<Example Title="Draggable threshold" Code="@DragCode">
    <Description><p>With <code>Draggable</code>, the user can move a reference line; <code>@@bind-Value</code> receives the new value. Here it sets when to send a high-traffic alert.</p></Description>
    <ChildContent>
        <RioChart Items="WebSessions" YAxis="Sessions" Height="240">
            <ReferenceLine @bind-Value="_alertAt" Label="@($"Alert at {_alertAt:#,0} sessions")" Draggable="true" />
            <LineSeries Name="Web" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" />
        </RioChart>
        <p class="note">Alert at @_alertAt.ToString("#,0") sessions per 15 min. Drag the dashed line.</p>
    </ChildContent>
</Example>

<Example Title="Pins: click a point to add one, click the pin to remove it" Code="@PinsCode">
    <Description>
        <p>
            <code>OnPointClick</code> gives the item behind a point, so pinning it is a <code>PointAnnotation</code> at its x and y.
            With <code>OnAnnotationClick</code> set, point annotations and callouts are buttons: a click on the pin (its marker or
            label) raises <code>OnAnnotationClick</code> even though the pin sits on a data point, so removing a pin is a click on the pin.
        </p>
    </Description>
    <ChildContent>
        <RioChart TItem="Reading" Items="DailyOrders" Height="240" YAxis="OrdersAxis" OnPointClick="Pin" OnAnnotationClick="Unpin">
            <LineSeries Name="Orders" XValue="r => r.Time" YValue="r => r.Value" Format="0 'orders'" />
            @foreach (var pin in _pins)
            {
                <PointAnnotation @key="pin.Time" Id="@PinId(pin)" X="pin.Time" Y="pin.Value ?? 0" Label="@($"{pin.Value:0}")" Color="#d9480f" />
            }
        </RioChart>
        <p class="note">@(_pins.Count == 0 ? "Click a point to pin it." : $"{_pins.Count} pinned. Click a pin to remove it.")</p>
    </ChildContent>
</Example>

@code {
    private static readonly AxisOptions OrdersAxis = new() { Title = "Orders per day" };
    private readonly List<Reading> _pins = [];

    private static string PinId(Reading r) => "pin-" + r.Time.Ticks;

    private void Pin(PointClickEventArgs<Reading> e)
    {
        if (e.Item is { } item && !_pins.Contains(item))
        {
            _pins.Add(item);
        }
    }

    private void Unpin(AnnotationClickEventArgs e) => _pins.RemoveAll(p => PinId(p) == e.AnnotationId);

    private const string PinsCode = """
        <RioChart TItem="Reading" Items="orders" OnPointClick="Pin" OnAnnotationClick="Unpin">
            <LineSeries Name="Orders" XValue="r => r.Time" YValue="r => r.Value" />
            @foreach (var pin in pins)
            {
                <PointAnnotation @key="pin.Time" Id="@PinId(pin)" X="pin.Time" Y="pin.Value ?? 0" Label="@($"{pin.Value:0}")" />
            }
        </RioChart>

        @code {
            List<Reading> pins = [];
            static string PinId(Reading r) => "pin-" + r.Time.Ticks;
            void Pin(PointClickEventArgs<Reading> e) { if (e.Item is { } item && !pins.Contains(item)) pins.Add(item); }
            void Unpin(AnnotationClickEventArgs e) => pins.RemoveAll(p => PinId(p) == e.AnnotationId);
        }
        """;

    private static readonly AxisOptions Sessions = new() { Title = "Sessions per 15 min" };
    private static readonly DateTime _saleStart = Start.AddHours(16), _saleEnd = Start.AddHours(23), _now = Start.AddHours(44);
    private static readonly DateTime _maintenanceStart = Start.AddHours(26), _maintenanceEnd = Start.AddHours(28);
    private static readonly DateTime _peak = Start.AddHours(20), _newsletter = Start.AddHours(31);
    private double _alertAt = 220;
    private string? _clicked;

    private const string AllCode = """
        <RioChart TItem="Reading" YAxis="@(new AxisOptions { Title = "Sessions per 15 min" })" OnAnnotationClick="e => clicked = e.Label">
            <ReferenceLine Value="200" Label="Target" />
            <ReferenceBand Axis="AnnotationAxis.X" From="saleStart" To="saleEnd" Label="Evening sale" />
            <ReferenceBand Axis="AnnotationAxis.X" From="maintenanceStart" To="maintenanceEnd" Label="Maintenance" Color="#d9480f" />
            <ReferenceLine Axis="AnnotationAxis.X" Value="now" Label="Now" />
            <PointAnnotation X="peak" Y="252" Label="Peak: 252 sessions" Color="#d9480f" />
            <Callout X="newsletterSent" Y="34" Label="Newsletter sent" OffsetX="-30" OffsetY="-36" />
            <LineSeries ... />
        </RioChart>
        """;

    private const string DragCode = """
        <ReferenceLine @bind-Value="alertAt" Label="Alert" Draggable="true" />

        @code { double alertAt = 220; }
        """;
}
