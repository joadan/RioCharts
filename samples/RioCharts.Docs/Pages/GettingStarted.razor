@page "/getting-started"

<PageTitle>Getting started · RioCharts</PageTitle>

<h1>Getting started</h1>
<p class="lead">Add the package, two usings, and a chart. Zero configuration gives a finished chart.</p>

<h2>Install</h2>
<p>RioCharts is on <a href="https://www.nuget.org/packages?q=RioCharts" target="_blank" rel="noopener">NuGet</a>. For Blazor (Server, WebAssembly or Auto), add one package:</p>
<CodeBlock Language="shell" Code="dotnet add package RioCharts.Blazor --prerelease" />
<p>Then in <code>_Imports.razor</code>:</p>
<CodeBlock Code="@ImportsCode" />
<p>Styles come with your app's <code>{App}.styles.css</code> bundle automatically; there is nothing else to register.</p>

<h3>All packages</h3>
<p>
    Take the parts you need; each brings in what it depends on. The packages are previews until 1.0, so add <code>--prerelease</code>
    (or tick <em>Include prerelease</em> in Visual Studio). All target .NET 10.
</p>
<table class="docs">
    <tr><th>Package</th><th>For</th></tr>
    @foreach (var p in Packages)
    {
        <tr>
            <td><a href="@($"https://www.nuget.org/packages/{p.Id}")" target="_blank" rel="noopener"><code>@p.Id</code></a></td>
            <td>@p.Text</td>
        </tr>
    }
</table>
<CodeBlock Language="shell" Code="@InstallCode" />
<p>
    <code>riocharts-mcp</code> is a .NET tool rather than a library; see <a href="ai#local-agents">AI agents and MCP</a>.
    Update it with <code>dotnet tool update -g RioCharts.Mcp --prerelease</code>.
</p>

<Example Title="Your first chart" Code="@FirstCode">
    <Description>
        <p>Pass items and say which property is x and which is y. The axis type follows the data: times give a time axis, numbers a linear axis, strings a category axis.</p>
    </Description>
    <ChildContent>
        <RioChart Items="Supply">
            <LineSeries XValue="r => r.Time" YValue="r => r.Value" />
        </RioChart>
    </ChildContent>
</Example>

<Example Title="Several series" Code="@SeveralCode">
    <Description>
        <p>More series add a legend. Click a legend item to hide a series; the axis refits and colors stay put.</p>
    </Description>
    <ChildContent>
        <RioChart TItem="Reading" YAxis="Celsius">
            <LineSeries Items="Supply" Name="Supply" XValue="r => r.Time" YValue="r => r.Value" />
            <LineSeries Items="Extract" Name="Extract" XValue="r => r.Time" YValue="r => r.Value" />
        </RioChart>
    </ChildContent>
</Example>

<Example Title="Arrays instead of items" Code="@ArraysCode">
    <Description>
        <p>For large data, pass columns directly with <code>SeriesData.From</code>: no per-item cost. The chart then needs some <code>TItem</code>, e.g. <code>double</code>.</p>
    </Description>
    <ChildContent>
        <RioChart TItem="double" Height="240">
            <LineSeries Name="Sensor" Data="_columns" StrokeWidth="1.25" />
        </RioChart>
    </ChildContent>
</Example>

<h2>How updates work</h2>
<ul>
    <li>Selectors run once per data change, never per render.</li>
    <li>A series reprocesses its data when <code>Items</code> or <code>Data</code> is a new reference, or <code>DataVersion</code> changes. Changing a list in place does not update the chart; assign a new list or bump <code>DataVersion</code>.</li>
    <li><code>YValue</code> returns <code>double?</code>; <code>null</code> leaves a gap. Cast <code>decimal</code> to <code>double</code>.</li>
    <li>The chart fills its container's width and is 300 px high by default (<code>Height</code>).</li>
</ul>

@code {
    private sealed record Package(string Id, string Text);

    private static readonly Package[] Packages =
    [
        new("RioCharts.Blazor", "The <RioChart> component for Blazor apps."),
        new("RioCharts.Core", "The chart engine alone, with no UI dependencies."),
        new("RioCharts.Skia", "PNG and SVG export on the server."),
        new("RioCharts.AI", "create_chart and render_chart tools for AI agents."),
        new("RioCharts.Mcp", "riocharts-mcp, a local MCP server for agents (a .NET tool)."),
    ];

    private const string InstallCode = """
        dotnet add package RioCharts.Blazor --prerelease
        dotnet add package RioCharts.Core --prerelease
        dotnet add package RioCharts.Skia --prerelease
        dotnet add package RioCharts.AI --prerelease
        dotnet tool install -g RioCharts.Mcp --prerelease
        """;

    private static readonly AxisSpec Celsius = new() { Title = "°C" };
    private static readonly SeriesData _columns = Columns();

    private static SeriesData Columns()
    {
        var (times, values) = Big(20_000);
        return SeriesData.From(times, values);
    }

    // "@" is '@': a line starting with @using inside @code would be read as a Razor directive.
    private const string ImportsCode = "@using RioCharts.Blazor\n@using RioCharts.Core";

    private const string FirstCode = """
        <RioChart Items="readings">
            <LineSeries XValue="r => r.Time" YValue="r => r.Value" />
        </RioChart>

        @code {
            record Reading(DateTime Time, double? Value);
            List<Reading> readings = ...;
        }
        """;

    private const string SeveralCode = """
        <RioChart TItem="Reading" YAxis="new AxisSpec { Title = "°C" }">
            <LineSeries Items="supply" Name="Supply" XValue="r => r.Time" YValue="r => r.Value" />
            <LineSeries Items="extract" Name="Extract" XValue="r => r.Time" YValue="r => r.Value" />
        </RioChart>
        """;

    private const string ArraysCode = """
        <RioChart TItem="double">
            <LineSeries Name="Sensor" Data="SeriesData.From(times, values)" StrokeWidth="1.25" />
        </RioChart>
        """;
}
