@page "/bars"

<PageTitle>Bars and stacking · RioCharts for Blazor and .NET</PageTitle>

<h1>Bars and stacking</h1>
<p class="lead">
    Bar and column charts for Blazor: bars start at zero, group side by side, stack by name or to 100 %, and can mix with lines. They also
    combine repeated x values or time buckets.
</p>

<Example Title="Grouped bars" Code="@GroupedCode">
    <Description><p>Several bar series share each category. Large numbers are compact (182k).</p></Description>
    <ChildContent>
        <RioChart TItem="Sales" Title="Revenue per quarter, €">
            <BarSeries Items="Quarters" Name="2025" XValue="s => s.Quarter" YValue="s => s.LastYear" />
            <BarSeries Items="Quarters" Name="2026" XValue="s => s.Quarter" YValue="s => s.ThisYear" />
        </RioChart>
    </ChildContent>
</Example>

<Example Title="Stacked bars with data labels" Code="@StackedCode">
    <Description><p>Same <code>Stack</code> name, same slot. Labels show inside segments that are big enough.</p></Description>
    <ChildContent>
        <RioChart TItem="Monthly" Title="Revenue per product group" YAxis="KiloEuros">
            <BarSeries Items="Mix" Name="Shoes" XValue="m => m.Month" YValue="m => m.Shoes" Stack="mix" DataLabels="true" Format="0 k€" />
            <BarSeries Items="Mix" Name="Clothing" XValue="m => m.Month" YValue="m => m.Clothing" Stack="mix" DataLabels="true" Format="0 k€" />
            <BarSeries Items="Mix" Name="Gear" XValue="m => m.Month" YValue="m => m.Gear" Stack="mix" DataLabels="true" Format="0 k€" />
        </RioChart>
    </ChildContent>
</Example>

<Example Title="100 % stacked bars" Code="@PercentCode">
    <Description>
        <p>
            <code>Stacking = StackMode.Percent</code> on the y axis stacks its bar, line and area series to 100 %, so each
            month shows the product groups' shares. Series without a <code>Stack</code> name are stacked together. The tooltip
            shows the value and its share; hide a series in the legend and the others fill its share. In JSON definitions:
            <code>"y": { "stacking": "percent" }</code> or the type <code>"stackedBar100"</code>.
        </p>
    </Description>
    <ChildContent>
        <RioChart TItem="Monthly" Title="Share of revenue per product group" YAxis="PercentAxis">
            <BarSeries Items="Mix" Name="Shoes" XValue="m => m.Month" YValue="m => m.Shoes" Format="0 k€" />
            <BarSeries Items="Mix" Name="Clothing" XValue="m => m.Month" YValue="m => m.Clothing" Format="0 k€" />
            <BarSeries Items="Mix" Name="Gear" XValue="m => m.Month" YValue="m => m.Gear" Format="0 k€" />
        </RioChart>
    </ChildContent>
</Example>

<Example Title="Combining repeated x values" Code="@AggregateCode">
    <Description>
        <p>
            Items with the same x are drawn on top of each other unless the series combines them.
            <code>Aggregate</code> gives the <code>Sum</code>, <code>Average</code>, <code>Min</code>, <code>Max</code> or <code>Last</code>
            of <code>YValue</code>, or the <code>Count</code> of items. <code>YAggregate</code> computes y from the group's items.
            A click gives the whole group in <code>Items</code>.
        </p>
    </Description>
    <ChildContent>
        <RioChart TItem="Ticket" Items="Tickets" Title="Support tickets per topic" OnPointClick="e => _tickets = e">
            <BarSeries Name="Tickets" XValue="t => t.Topic" Aggregate="Aggregate.Count" />
            <BarSeries Name="Handling time (h)" XValue="t => t.Topic" YAggregate="g => g.Sum(t => t.Minutes) / 60" Format="0.0 h" />
        </RioChart>
        <p class="note">
            Clicked: @(_tickets is null ? "nothing yet" : $"{_tickets.X}, {_tickets.SeriesName}: " + string.Join(", ", _tickets.Items.Select(t => $"{t.Subject} ({t.Minutes} min)")))
        </p>
    </ChildContent>
</Example>

<Example Title="Bars per time bucket" Code="@BucketCode">
    <Description>
        <p>
            <code>Bucket</code> groups items with a time x per minute, hour, day, week, month, quarter or year (on their wall-clock
            time, or in the chart's <code>TimeZone</code> when set) and draws one bar at the start of each bucket, combined with <code>Aggregate</code> (the average when not set).
            <code>TimeBucket.Auto</code> picks the bucket from the data's time span, aiming for about 50 bars: hours for these two
            days of revenue, weeks for a year. Lines and areas take <code>Bucket</code> too. In JSON definitions:
            <code>"timeBucket": "auto"</code>.
        </p>
    </Description>
    <ChildContent>
        <RioChart Items="Revenue" Title="Revenue, €" Height="260">
            <BarSeries Name="Revenue" XValue="r => r.Time" YValue="r => r.Value" Bucket="_bucket" Aggregate="Aggregate.Sum" Format="#,0 €" />
        </RioChart>
        <p class="note">
            @foreach (var bucket in Buckets)
            {
                <label><input type="radio" name="bar-bucket" checked="@(_bucket == bucket)" @onchange="() => _bucket = bucket" /> @bucket</label>
            }
        </p>
    </ChildContent>
</Example>

<Example Title="Bars and a line" Code="@MixedCode">
    <Description><p>Default draw order is areas, then bars, then lines (override with <code>ZIndex</code>). Bars work on time axes too.</p></Description>
    <ChildContent>
        <RioChart TItem="Reading" YAxis="OrdersAxis">
            <BarSeries Items="DailyOrders" Name="Orders" XValue="r => r.Time" YValue="r => r.Value" />
            <LineSeries Items="_average" Name="7-day average" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" />
        </RioChart>
    </ChildContent>
</Example>

<Example Title="Horizontal bars" Code="@HorizontalCode">
    <Description>
        <p>
            <code>Horizontal="true"</code> turns the bars sideways: categories down the side, first on top, so a sorted list reads as a
            ranking and long names have room (very long ones are shortened, the tooltip has them in full). <code>YAxis</code> formats the
            values; reference lines such as a target are drawn across the rows. In a JSON definition: <code>"type": "horizontalBar"</code> or
            <code>"horizontal": true</code>.
        </p>
    </Description>
    <ChildContent>
        <RioChart Items="_ranking" Horizontal="true" YAxis="KiloEuros" Height="300" Title="Revenue per category, this year">
            <BarSeries Name="Revenue" XValue="s => s.Name" YValue="s => s.Value" Format="0 k€" DataLabels="true" />
            <ReferenceLine Value="200" Label="Target" />
        </RioChart>
    </ChildContent>
</Example>

<Example Title="Colors from the data" Code="@ColorCode">
    <Description>
        <p>
            <code>ColorValue</code> gives an item its own color: here the days under the target in the falling color and the best day in
            the rising one. Return a theme token (<code>"--rio-negative"</code>, <code>"--rio-series-3"</code>: they follow light and dark
            themes) or any CSS color, and <code>null</code> to keep the series color. It works on every series: bars, scatter markers, pie
            slices, radial bars and treemap items take the color, lines and areas mark the point with a dot. Aggregated points take their
            first item's color. In JSON definitions, <code>"colorField"</code> names the field that holds the colors.
        </p>
        <p>Color should not be the only signal: here the target line and the tooltip say it too.</p>
    </Description>
    <ChildContent>
        <RioChart TItem="DayOrders" Items="WeekOrders" YAxis="OrdersAxis" Height="240">
            <BarSeries Name="Orders" XValue="d => d.Day" YValue="d => d.Orders"
                       ColorValue="@(d => d.Orders < 100 ? "--rio-negative" : d.Orders >= 150 ? "--rio-positive" : null)" />
            <ReferenceLine Value="100" Label="Target" />
        </RioChart>
    </ChildContent>
</Example>

<Example Title="Negative values" Code="@NegativeCode">
    <Description>
        <p>
            Bars grow from zero, so a negative value is a bar pointing down and the y axis takes in both sides. Here the result per
            month, with the loss months in the falling color through <code>ColorValue</code>; data labels sit at the end of each bar,
            below the negative ones.
        </p>
    </Description>
    <ChildContent>
        <RioChart Items="MonthlyResult" YAxis="KiloEuros" Height="240">
            <BarSeries Name="Result" XValue="m => m.Name" YValue="m => m.Value" Format="0 k€" DataLabels="true"
                       ColorValue="@(m => m.Value < 0 ? "--rio-negative" : null)" />
        </RioChart>
    </ChildContent>
</Example>

<Example Title="Per-bar tooltip" Code="@SingleCode">
    <Description><p>Tooltips are shared per x by default; <code>Shared = false</code> shows only the bar under the pointer.</p></Description>
    <ChildContent>
        <RioChart TItem="Sales" Tooltip="_single">
            <BarSeries Items="Quarters" Name="2025" XValue="s => s.Quarter" YValue="s => s.LastYear" DataLabels="true" />
            <BarSeries Items="Quarters" Name="2026" XValue="s => s.Quarter" YValue="s => s.ThisYear" DataLabels="true" />
        </RioChart>
    </ChildContent>
</Example>

@code {
    private static readonly AxisOptions OrdersAxis = new() { Title = "Orders per day" };
    private static readonly AxisOptions KiloEuros = new() { Title = "k€" };
    private static readonly AxisOptions PercentAxis = new() { Stacking = StackMode.Percent };
    private static readonly TooltipOptions _single = new() { Shared = false };
    private static readonly List<Share> _ranking = [.. CategoryRevenue.OrderByDescending(s => s.Value)];
    private PointClickEventArgs<Ticket>? _tickets;
    private static readonly TimeBucket[] Buckets = [TimeBucket.Hour, TimeBucket.Day, TimeBucket.Auto];
    private TimeBucket _bucket = TimeBucket.Auto;
    private static readonly List<Reading> _average = DailyOrders
        .Select((r, i) => new Reading(r.Time, DailyOrders.Skip(Math.Max(0, i - 6)).Take(Math.Min(7, i + 1)).Average(x => x.Value)))
        .ToList();

    private const string GroupedCode = """
        <RioChart TItem="Sales" Title="Revenue per quarter, €">
            <BarSeries Items="quarters" Name="2025" XValue="s => s.Quarter" YValue="s => s.LastYear" />
            <BarSeries Items="quarters" Name="2026" XValue="s => s.Quarter" YValue="s => s.ThisYear" />
        </RioChart>
        """;

    private const string StackedCode = """
        <BarSeries Items="mix" Name="Shoes" XValue="m => m.Month" YValue="m => m.Shoes" Stack="mix" DataLabels="true" Format="0 k€" />
        <BarSeries Items="mix" Name="Clothing" XValue="m => m.Month" YValue="m => m.Clothing" Stack="mix" DataLabels="true" Format="0 k€" />
        <BarSeries Items="mix" Name="Gear" XValue="m => m.Month" YValue="m => m.Gear" Stack="mix" DataLabels="true" Format="0 k€" />
        """;

    private const string PercentCode = """
        <RioChart TItem="Monthly" YAxis="@(new AxisOptions { Stacking = StackMode.Percent })">
            <BarSeries Items="mix" Name="Shoes" XValue="m => m.Month" YValue="m => m.Shoes" Format="0 k€" />
            <BarSeries Items="mix" Name="Clothing" XValue="m => m.Month" YValue="m => m.Clothing" Format="0 k€" />
            <BarSeries Items="mix" Name="Gear" XValue="m => m.Month" YValue="m => m.Gear" Format="0 k€" />
        </RioChart>
        """;

    private const string AggregateCode = """
        <RioChart TItem="Ticket" Items="tickets" OnPointClick="e => clicked = e">
            <BarSeries Name="Tickets" XValue="t => t.Topic" Aggregate="Aggregate.Count" />
            <BarSeries Name="Handling time (h)" XValue="t => t.Topic" YAggregate="g => g.Sum(t => t.Minutes) / 60" Format="0.0 h" />
        </RioChart>

        @* clicked.Items holds every ticket behind the bar *@
        """;

    private const string BucketCode = """
        @* Revenue every 15 minutes for two days *@
        <RioChart Items="revenue" Title="Revenue, €">
            <BarSeries Name="Revenue" XValue="r => r.Time" YValue="r => r.Value"
                       Bucket="TimeBucket.Auto" Aggregate="Aggregate.Sum" Format="#,0 €" />
        </RioChart>
        """;

    private const string MixedCode = """
        <BarSeries Items="orders" Name="Orders" XValue="r => r.Time" YValue="r => r.Value" />
        <LineSeries Items="average" Name="7-day average" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" />
        """;

    private const string HorizontalCode = """
        <RioChart Items="categories.OrderByDescending(c => c.Revenue)" Horizontal="true" YAxis="@(new AxisOptions { Title = "k€" })"
                  Title="Revenue per category, this year">
            <BarSeries Name="Revenue" XValue="c => c.Name" YValue="c => c.Revenue" Format="0 k€" DataLabels="true" />
            <ReferenceLine Value="200" Label="Target" />
        </RioChart>
        """;

    private const string ColorCode = """
        <RioChart TItem="DayOrders" Items="orders">
            <BarSeries Name="Orders" XValue="d => d.Day" YValue="d => d.Orders"
                       ColorValue="@(d => d.Orders < 100 ? "--rio-negative" : d.Orders >= 150 ? "--rio-positive" : null)" />
            <ReferenceLine Value="100" Label="Target" />
        </RioChart>
        """;

    private const string NegativeCode = """
        <RioChart Items="monthlyResult" YAxis="@(new AxisOptions { Title = "k€" })">
            <BarSeries Name="Result" XValue="m => m.Name" YValue="m => m.Value" Format="0 k€" DataLabels="true"
                       ColorValue="@(m => m.Value < 0 ? "--rio-negative" : null)" />
        </RioChart>
        """;

    private const string SingleCode = """
        <RioChart TItem="Sales" Tooltip="new TooltipOptions { Shared = false }">
            <BarSeries ... DataLabels="true" />
        </RioChart>
        """;
}
