@page "/"

<PageTitle>RioCharts: charts for .NET</PageTitle>

<section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-inner">
        <div class="hero-copy">
            <a class="pill" href="ai"><span class="pill-dot"></span> New: AI agents can write charts <span aria-hidden="true">→</span></a>
            <h1>Beautiful charts<br /><span class="gradient-text">for .NET</span></h1>
            <p class="hero-lead">
                One chart model, drawn everywhere: interactive in Blazor, PNG and SVG on the server, and created by AI agents
                from JSON. C# does the math and layout. Good defaults, zero configuration.
            </p>
            <div class="hero-actions">
                <a class="button primary" href="getting-started">Get started <span aria-hidden="true">→</span></a>
                <a class="button" href="gallery">Browse the gallery</a>
            </div>
        </div>

        <div class="hero-visual">
            <div class="window">
                <div class="window-bar"><i></i><i></i><i></i><span>StoreTraffic.razor</span></div>
                <div class="window-body">
                    <RioChart TItem="Reading" Title="Store traffic" YAxis="Sessions" Height="300">
                        <ReferenceBand Axis="AnnotationAxis.X" From="SaleStart" To="SaleEnd" Label="Flash sale" />
                        <LineSeries Items="WebSessions" Name="Web" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" Format="#,0" />
                        <LineSeries Items="AppSessions" Name="App" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" Format="#,0" />
                    </RioChart>
                </div>
            </div>
            <p class="hero-hint">Live. Hover it, click the legend.</p>
        </div>
    </div>
</section>

<section class="band">
    <div class="band-inner">
        <div class="section-head">
            <h2>One chart model, three ways out</h2>
            <p>The same engine lays out every chart, so it looks the same wherever it ends up.</p>
        </div>
        <div class="outputs">
            <div class="output">
                <h3>In Blazor apps</h3>
                <p>An interactive component: tooltips, zoom, selection and live data. Server, WebAssembly and static SSR.</p>
                <a class="output-package" href="https://www.nuget.org/packages/RioCharts.Blazor" target="_blank" rel="noopener"><code>RioCharts.Blazor</code></a>
                <CodeBlock Code="@BlazorCode" />
                <a href="getting-started">Get started <span aria-hidden="true">→</span></a>
            </div>
            <div class="output">
                <h3>On the server</h3>
                <p>PNG and SVG without a browser, from any .NET app: reports, emails, Teams messages, APIs and jobs.</p>
                <a class="output-package" href="https://www.nuget.org/packages/RioCharts.Skia" target="_blank" rel="noopener"><code>RioCharts.Skia</code></a>
                <CodeBlock Language="csharp" Code="@ServerCode" />
                <a href="server-export">Server-side export <span aria-hidden="true">→</span></a>
            </div>
            <div class="output">
                <h3>From AI agents</h3>
                <p>Agents chart data from a JSON definition: <code>create_chart</code> in your app, or <code>riocharts-mcp</code> for coding agents.</p>
                <a class="output-package" href="https://www.nuget.org/packages/RioCharts.Mcp" target="_blank" rel="noopener"><code>RioCharts.Mcp (riocharts-mcp)</code></a>
                <CodeBlock Language="json" Code="@AgentCode" />
                <a href="ai">AI agents and MCP <span aria-hidden="true">→</span></a>
            </div>
        </div>
    </div>
</section>

<section class="band">
    <div class="band-inner">
        <div class="section-head">
            <h2>Many kinds of charts</h2>
            <p>Line, area, bar, scatter, bubble, pie, donut, radial bar, radar, heatmap, box plot, histogram, candlestick, waterfall and treemap. Every card below is a live chart.</p>
        </div>
        <div class="gallery">
            <a class="tile" href="lines-and-areas">
                <RioChart TItem="Reading" Height="170" Legend="NoLegend" Tooltip="NoTooltip">
                    <AreaSeries Items="Revenue" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" />
                </RioChart>
                <span class="tile-label">Areas <span aria-hidden="true">→</span></span>
            </a>
            <a class="tile" href="bars">
                <RioChart TItem="Monthly" Height="170" Legend="NoLegend" Tooltip="NoTooltip">
                    <BarSeries Items="Mix" Name="Shoes" XValue="m => m.Month" YValue="m => m.Shoes" Stack="mix" />
                    <BarSeries Items="Mix" Name="Clothing" XValue="m => m.Month" YValue="m => m.Clothing" Stack="mix" />
                    <BarSeries Items="Mix" Name="Gear" XValue="m => m.Month" YValue="m => m.Gear" Stack="mix" />
                </RioChart>
                <span class="tile-label">Stacked bars <span aria-hidden="true">→</span></span>
            </a>
            <a class="tile" href="pies">
                <RioChart TItem="Share" Height="170" Legend="NoLegend" Tooltip="NoTooltip">
                    <DonutSeries Items="CategoryRevenue" XValue="s => s.Name" YValue="s => s.Value" />
                </RioChart>
                <span class="tile-label">Donuts <span aria-hidden="true">→</span></span>
            </a>
            <a class="tile" href="pies#radial-bars">
                <RioChart TItem="Share" Height="170" Legend="NoLegend" Tooltip="NoTooltip">
                    <RadialBarSeries Items="Goals" XValue="s => s.Name" YValue="s => s.Value" Max="100" Format="0'%'" />
                </RioChart>
                <span class="tile-label">Radial bars <span aria-hidden="true">→</span></span>
            </a>
        </div>
    </div>
</section>

<section class="band">
    <div class="band-inner">
        <div class="section-head">
            <h2>Everything a dashboard needs</h2>
            <p>Built for real data: time series, gaps, live streams and a lot of points.</p>
        </div>
        <div class="features">
            @foreach (var f in Features)
            {
                <a class="feature" href="@f.Href">
                    <span class="feature-icon" aria-hidden="true">@((MarkupString)f.Icon)</span>
                    <b>@f.Title</b>
                    <span>@f.Text</span>
                </a>
            }
        </div>
    </div>
</section>

<section class="band">
    <div class="band-inner split">
        <div class="split-copy">
            <h2>Three lines to a finished chart</h2>
            <p>
                Pass items and say which property is x and which is y. The axis type follows the data, ticks land on nice
                numbers and calendar boundaries, and labels follow the culture.
            </p>
            <ul class="checks">
                <li>No JavaScript to write, no chart library to load</li>
                <li>Works on Blazor Server, WebAssembly and static SSR</li>
                <li>Light and dark themes from CSS variables</li>
                <li>Accessible: keyboard focus and a text description</li>
            </ul>
            <a class="button" href="getting-started">Read the guide <span aria-hidden="true">→</span></a>
        </div>
        <div class="split-code">
            <CodeBlock Code="@QuickCode" />
        </div>
    </div>
</section>

<section class="band">
    <div class="band-inner">
        <div class="section-head">
            <h2>Packages</h2>
            <p>Take the parts you need. Core has no UI dependencies at all.</p>
        </div>
        <div class="packages">
            @foreach (var p in Packages)
            {
                <a class="package" href="@($"https://www.nuget.org/packages/{p.Name}")" target="_blank" rel="noopener">
                    <code>@p.Name</code>
                    <span>@p.Text</span>
                </a>
            }
        </div>
    </div>
</section>

<section class="band">
    <div class="band-inner">
        <div class="cta">
            <div>
                <h2>Early preview</h2>
                <p>
                    RioCharts is built for our own teams' needs, and APIs will change before 1.0. Named after Rio, and
                    <i>río</i> means river: fitting for flowing lines and time series.
                </p>
            </div>
            <div class="hero-actions">
                <a class="button primary" href="getting-started">Get started</a>
                <a class="button" href="https://github.com/joadan/RioCharts">Star on GitHub</a>
            </div>
        </div>
    </div>
</section>

@code {
    private const string BlazorCode = """
        <RioChart Items="orders">
            <LineSeries XValue="o => o.Day"
                        YValue="o => o.Total" />
        </RioChart>
        """;

    private const string ServerCode = """
        // The same chart, as an image
        byte[] png = ChartExport.ToPng(
            spec, data, new() { Width = 640 });
        """;

    private const string AgentCode = """
        { "dataset": "orders",
          "series": [{ "type": "bar",
            "x": "region", "y": "total",
            "aggregate": "sum" }] }
        """;

    private static readonly AxisOptions Sessions = new() { Title = "Sessions per 15 min" };
    private static readonly DateTime SaleStart = Start.AddHours(18);
    private static readonly DateTime SaleEnd = Start.AddHours(22);
    private static readonly LegendOptions NoLegend = new() { Mode = LegendMode.Hide };
    private static readonly TooltipOptions NoTooltip = new() { Enabled = false };

    private const string QuickCode = """
        <RioChart Items="orders">
            <LineSeries XValue="r => r.Time" YValue="r => r.Value" />
        </RioChart>
        """;

    private sealed record Feature(string Href, string Title, string Text, string Icon);

    private static readonly Feature[] Features =
    [
        new("axes", "Smart axes", "Nice ticks, calendar-aware time axes, display time zones and compact culture-aware labels.",
            """<svg viewBox="0 0 24 24"><path d="M4 4v16h16" /><path d="M8 16l4-5 3 3 5-7" /></svg>"""),
        new("tooltips", "Interaction", "Shared tooltips, crosshair, legend toggles, zoom and pan, linked charts and click events.",
            """<svg viewBox="0 0 24 24"><path d="M6 3l12 7-5 1.5L10.5 17z" /><path d="M13 12l5 6" /></svg>"""),
        new("annotations", "Annotations", "Reference lines and bands, points and callouts, and thresholds you can drag.",
            """<svg viewBox="0 0 24 24"><path d="M3 9h18" stroke-dasharray="3 3" /><path d="M4 18l5-6 4 3 7-9" /></svg>"""),
        new("live-data", "Live data", "Append to a buffer and the chart follows, refreshing at most every 100 ms.",
            """<svg viewBox="0 0 24 24"><path d="M3 12h4l3-7 4 14 3-7h4" /></svg>"""),
        new("large-data", "Large data", "Plain arrays, LTTB downsampling and a canvas layer for hundreds of thousands of points.",
            """<svg viewBox="0 0 24 24"><rect x="4" y="4" width="6" height="6" rx="1" /><rect x="14" y="4" width="6" height="6" rx="1" /><rect x="4" y="14" width="6" height="6" rx="1" /><rect x="14" y="14" width="6" height="6" rx="1" /></svg>"""),
        new("definitions", "Chart definitions and AI", "A serializable chart definition that agents can write, with a create_chart tool for MCP.",
            """<svg viewBox="0 0 24 24"><path d="M8 4H6a2 2 0 0 0-2 2v4l-2 2 2 2v4a2 2 0 0 0 2 2h2" /><path d="M16 4h2a2 2 0 0 1 2 2v4l2 2-2 2v4a2 2 0 0 1-2 2h-2" /></svg>"""),
    ];

    private sealed record Package(string Name, string Text);

    private static readonly Package[] Packages =
    [
        new("RioCharts.Core", "Scales, ticks, layout, the chart definition and JSON definitions."),
        new("RioCharts.Blazor", "The <RioChart> component, series, annotations and the SVG renderer."),
        new("RioCharts.Skia", "Server-side export to SVG and PNG, for reports and e-mail."),
        new("RioCharts.AI", "The create_chart tool for agents: Microsoft.Extensions.AI and MCP."),
        new("RioCharts.Mcp", "riocharts-mcp: a local MCP server (.NET tool) that renders charts to files."),
    ];
}
