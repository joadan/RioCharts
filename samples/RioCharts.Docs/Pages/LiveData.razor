@page "/live-data"
@implements IDisposable

<PageTitle>Live data · RioCharts for Blazor and .NET</PageTitle>

<h1>Live data</h1>
<p class="lead">
    Real-time charts in Blazor: append points to a <code>SeriesBuffer</code> from any thread. The chart coalesces the changes and redraws at
    most every <code>RefreshInterval</code> milliseconds; the tooltip stays open while it updates.
</p>

<Example Title="A two-minute window" Code="@LiveCode">
    <Description><p>Visitors on the store right now, web and app: two buffers with a time window, fed four times a second.</p></Description>
    <ChildContent>
        <RioChart TItem="double" Height="240" YAxis="Visitors" RefreshInterval="250">
            <ReferenceLine Value="200" Label="Autoscale" />
            <LineSeries Name="Web" Buffer="_web" Curve="CurveType.Monotone" Format="#,0" />
            <LineSeries Name="App" Buffer="_app" Curve="CurveType.Monotone" Format="#,0" />
        </RioChart>
        <p class="note"><button class="small" @onclick="Toggle">@(_timer is null ? "Start" : "Pause")</button></p>
    </ChildContent>
</Example>

<h2>From a stream</h2>
<CodeBlock Language="csharp" Code="await buffer.ConsumeAsync(analytics.VisitorsAsync(token), v => v.Time, v => v.Count, token);" />
<p>Buffers keep at most <code>Capacity</code> points (100 000 by default) and, with a <code>timeWindow</code>, only the latest span of time.</p>

@code {
    private static readonly AxisOptions Visitors = new() { Title = "Visitors" };
    private readonly SeriesBuffer _web = new(timeWindow: TimeSpan.FromMinutes(2));
    private readonly SeriesBuffer _app = new(timeWindow: TimeSpan.FromMinutes(2));
    private readonly Random _random = new(7);
    private Timer? _timer;
    private double _w = 170, _a = 105;

    protected override void OnInitialized()
    {
        var now = DateTime.Now;
        for (var i = 480; i > 0; i--)
        {
            Append(now.AddMilliseconds(-250 * i));
        }

        Toggle();
    }

    private void Toggle()
    {
        if (_timer is null)
        {
            _timer = new Timer(_ => Append(DateTime.Now), null, 250, 250);
        }
        else
        {
            _timer.Dispose();
            _timer = null;
        }
    }

    private void Append(DateTime t)
    {
        // Visitors drift around a level; whole people only.
        _w += (_random.NextDouble() - 0.5) * 8 + (170 - _w) * 0.02;
        _a += (_random.NextDouble() - 0.5) * 5 + (105 - _a) * 0.02;
        _web.Append(t, Math.Round(_w));
        _app.Append(t, Math.Round(_a));
    }

    public void Dispose() => _timer?.Dispose();

    private const string LiveCode = """
        <RioChart TItem="double" RefreshInterval="250">
            <LineSeries Name="Web" Buffer="web" Curve="CurveType.Monotone" />
            <LineSeries Name="App" Buffer="app" Curve="CurveType.Monotone" />
        </RioChart>

        @code {
            SeriesBuffer web = new(timeWindow: TimeSpan.FromMinutes(2));
            SeriesBuffer app = new(timeWindow: TimeSpan.FromMinutes(2));

            void OnVisitors(DateTime time, double count) => web.Append(time, count); // any thread
        }
        """;
}
