@page "/compact"

<PageTitle>Compact charts · RioCharts</PageTitle>

<h1>Compact charts and sparklines</h1>
<p class="lead">
    <code>Compact="true"</code> turns any chart into a sparkline: no axes, grid, legend or title, the series fill the box and the y range fits
    the data. Give it a small <code>Height</code> and put it in a table, a card or a sentence.
</p>

<Example Title="Sparkline" Code="@SparkCode">
    <Description>
        <p>
            The y range fits the data tightly, so small changes show (bars keep zero). <code>Highlight</code> marks the last, first, lowest or
            highest value with a dot; it works on normal charts too. The tooltip still works, and screen readers get a short summary such as
            "Web: 28 to 252 sessions, last 193, falling" instead of a tab stop.
        </p>
    </Description>
    <ChildContent>
        <div class="compact-demo">
            <span>Web sessions, last 48 h</span>
            <RioChart Items="WebSessions" Compact="true" Height="40">
                <LineSeries Name="Web" XValue="r => r.Time" YValue="r => r.Value" Format="#,0 'sessions'" Curve="CurveType.Monotone"
                            Highlight="PointHighlight.Last | PointHighlight.Min | PointHighlight.Max" />
            </RioChart>
            <b>@($"{WebSessions[^1].Value:#,0}")</b>
        </div>
    </ChildContent>
</Example>

<Example Title="In a table" Code="@TableCode">
    <Description>
        <p>
            Every interactive chart loads the JS module, measures its container and sends its points to the browser. With dozens of charts on a
            page, <code>Interactive="false"</code> draws plain SVG instead: no JS, no tooltip, no round trips. Give it a <code>Width</code> so it
            is drawn at its real size (without one it is laid out 160 px wide and scaled to fit). Here the water bottle keeps selling more, and
            the tent shows a gap while it was sold out.
        </p>
    </Description>
    <ChildContent>
        <div class="table-scroll">
        <table class="docs sparkline-table">
            <tr><th>Product</th><th>Sold per hour, 48 h</th><th>Last hour</th></tr>
            @foreach (var (product, readings) in ProductSales)
            {
                <tr>
                    <td>@product</td>
                    <td>
                        <RioChart Items="readings" Compact="true" Interactive="false" Width="140" Height="28" Title="@product">
                            <LineSeries Name="Sold" XValue="r => r.Time" YValue="r => r.Value" Format="0 'per hour'" Highlight="PointHighlight.Last" />
                        </RioChart>
                    </td>
                    <td class="num">@($"{readings.Last(r => r.Value is not null).Value:0}")</td>
                </tr>
            }
        </table>
        </div>
    </ChildContent>
</Example>

<Example Title="Areas and bars" Code="@KindsCode">
    <Description>
        <p>Area and bar series work the same way. Areas fill down to the bottom of the box; bars start at zero, so their lengths compare.</p>
    </Description>
    <ChildContent>
        <div class="compact-grid">
            <div>
                <span>Revenue, € per 15 min</span>
                <RioChart Items="Revenue" Compact="true" Height="48">
                    <AreaSeries Name="Revenue" XValue="r => r.Time" YValue="r => r.Value" Format="#,0 €" Curve="CurveType.Monotone" />
                </RioChart>
            </div>
            <div>
                <span>Orders per day, 35 days</span>
                <RioChart Items="DailyOrders" Compact="true" Height="48">
                    <BarSeries Name="Orders" XValue="r => r.Time" YValue="r => r.Value" Format="#,0 'orders'" />
                </RioChart>
            </div>
        </div>
    </ChildContent>
</Example>

<Example Title="Target range" Code="@BandCode">
    <Description>
        <p>
            Annotations still draw, without their text: a <code>ReferenceBand</code> shows the target range at a glance. Bands do not widen the
            y range, so the line keeps its detail, and a gap (here, while tracking was down) stays a gap.
        </p>
    </Description>
    <ChildContent>
        <div class="compact-demo">
            <span>Conversion vs 2–3 % target</span>
            <RioChart Items="Conversion" Compact="true" Height="40">
                <LineSeries Name="Conversion" XValue="r => r.Time" YValue="r => r.Value" Format="0.00 '%'" Curve="CurveType.Monotone" Highlight="PointHighlight.Last" />
                <ReferenceBand From="2" To="3" />
            </RioChart>
        </div>
    </ChildContent>
</Example>

<Example Title="Auto-compact" Code="@AutoCode">
    <Description>
        <p>
            Normal charts make room for the plot as they get small: first the axis titles go, then the legend (the tooltip still names the
            series), the title and the axis labels. A right legend moves to the top on narrow charts. Below 120 × 60 px the chart is drawn as a
            compact chart. It is on by default; <code>AutoCompact="false"</code> keeps everything at any size. Pick a size:
        </p>
    </Description>
    <ChildContent>
        <div class="size-picker">
            @foreach (var (label, w, h) in Sizes)
            {
                <button type="button" class="@(_size == label ? "active" : null)" aria-pressed="@(_size == label ? "true" : "false")" @onclick="@(() => _size = label)">@label</button>
            }
            <label><input type="checkbox" @bind="_autoCompact" /> AutoCompact</label>
        </div>
        <div class="size-stage">
            <div style="@($"width:{Size.W}px;max-width:100%")">
                <RioChart Items="WebSessions" Height="Size.H" Title="Store traffic" AutoCompact="_autoCompact"
                          XAxis="@(new AxisOptions { Title = "Time" })" YAxis="@(new AxisOptions { Title = "Sessions per 15 min" })">
                    <LineSeries Name="Web" XValue="r => r.Time" YValue="r => r.Value" Format="#,0" />
                    <LineSeries Items="AppSessions" Name="App" XValue="r => r.Time" YValue="r => r.Value" Format="#,0" />
                </RioChart>
            </div>
        </div>
    </ChildContent>
</Example>

<h2>Options</h2>
<div class="table-scroll">
<table class="docs">
    <tr><th>Option</th><th>Default</th><th>Meaning</th></tr>
    <tr><td><code>Compact</code></td><td>false</td><td>No axes, grid, legend or title; a tight y range. Also <code>"compact": true</code> in JSON definitions.</td></tr>
    <tr><td><code>Height</code></td><td>300</td><td>Set it small, e.g. 24–48 px.</td></tr>
    <tr><td><code>Highlight</code> (line, area)</td><td>none</td><td><code>PointHighlight.Last</code>, <code>First</code>, <code>Min</code>, <code>Max</code>, combined with <code>|</code>.</td></tr>
    <tr><td><code>Interactive</code></td><td>true</td><td>False: plain SVG without JS (no tooltip). For many charts on a page.</td></tr>
    <tr><td><code>Width</code></td><td>the container</td><td>Needed for exact geometry when <code>Interactive="false"</code>.</td></tr>
    <tr><td><code>AutoCompact</code></td><td>true</td><td>Leave out axis titles, legend, title and axis labels as a normal chart gets small. Also <code>"autoCompact"</code> in JSON definitions.</td></tr>
    <tr><td><code>KeyboardNavigation</code></td><td>off when compact</td><td>Set true to make a compact chart a tab stop with arrow-key navigation.</td></tr>
</table>
</div>

@code {
    private static readonly (string Label, double W, double H)[] Sizes =
        [("640 × 300", 640, 300), ("480 × 170", 480, 170), ("360 × 130", 360, 130), ("180 × 100", 180, 100), ("110 × 50", 110, 50)];

    private string _size = "480 × 170";
    private bool _autoCompact = true;

    private (string Label, double W, double H) Size => Sizes.First(s => s.Label == _size);

    private const string AutoCode = """
        <RioChart Items="web" Height="130" Title="Store traffic"
                  XAxis="@(new AxisOptions { Title = "Time" })" YAxis="@(new AxisOptions { Title = "Sessions per 15 min" })">
            <LineSeries Name="Web" XValue="r => r.Time" YValue="r => r.Value" Format="#,0" />
            <LineSeries Items="app" Name="App" XValue="r => r.Time" YValue="r => r.Value" Format="#,0" />
        </RioChart>
        """;

    private const string SparkCode = """
        <RioChart Items="web" Compact="true" Height="40">
            <LineSeries Name="Web" XValue="r => r.Time" YValue="r => r.Value" Format="#,0 'sessions'"
                        Highlight="PointHighlight.Last | PointHighlight.Min | PointHighlight.Max" />
        </RioChart>
        """;

    private const string TableCode = """
        @foreach (var product in products)
        {
            <tr>
                <td>@product.Name</td>
                <td>
                    <RioChart Items="product.Readings" Compact="true" Interactive="false" Width="140" Height="28" Title="@product.Name">
                        <LineSeries Name="Sold" XValue="r => r.Time" YValue="r => r.Value" Format="0 'per hour'" Highlight="PointHighlight.Last" />
                    </RioChart>
                </td>
                <td>@product.LastHour</td>
            </tr>
        }
        """;

    private const string KindsCode = """
        <RioChart Items="revenue" Compact="true" Height="48">
            <AreaSeries Name="Revenue" XValue="r => r.Time" YValue="r => r.Value" Format="#,0 €" Curve="CurveType.Monotone" />
        </RioChart>

        <RioChart Items="orders" Compact="true" Height="48">
            <BarSeries Name="Orders" XValue="r => r.Time" YValue="r => r.Value" Format="#,0 'orders'" />
        </RioChart>
        """;

    private const string BandCode = """
        <RioChart Items="conversion" Compact="true" Height="40">
            <LineSeries Name="Conversion" XValue="r => r.Time" YValue="r => r.Value" Format="0.00 '%'" Highlight="PointHighlight.Last" />
            <ReferenceBand From="2" To="3" />
        </RioChart>
        """;
}
