@page "/specs"
@using RioCharts.Core.Specs

<PageTitle>JSON specs · RioCharts</PageTitle>

<h1>JSON specs</h1>
<p class="lead">
    A chart can also be a small JSON spec that names a dataset and its fields: easy for AI agents to write, easy to save. The same spec renders
    with <code>&lt;RioChart Spec="spec" Datasets="datasets" /&gt;</code>, on the server, or through the <a href="ai">create_chart tool</a>.
    Edit the spec below; it is parsed, validated and drawn in your browser.
</p>

<section class="example">
<div class="example-card playground">
    <div class="examples-buttons">
        @foreach (var (name, json) in Examples)
        {
            <button class="small" @onclick="() => Load(json)">@name</button>
        }
    </div>

    @* A transparent textarea over a highlighted copy of its text. Both wrap the same way and the
       highlighted copy sets the height, so they stay aligned without scroll syncing. *@
    <div class="spec-editor">
        <pre aria-hidden="true"><code>@((MarkupString)_highlighted)</code></pre>
        <textarea spellcheck="false" aria-label="Chart spec (JSON)" @bind="_json" @bind:event="oninput" @bind:after="Render"></textarea>
    </div>
    <p class="note">Datasets: @string.Join("; ", SpecDatasets.ByName.Values.Select(d => $"{d.Name} ({string.Join(", ", d.Fields.Select(f => $"{f.Name}: {f.Type.ToString().ToLowerInvariant()}"))})"))</p>

    <div class="example-live">
        @if (_spec is not null)
        {
            <RioChart TItem="object" Spec="_spec" Datasets="SpecDatasets.ByName" Height="320" Zoomable="true" />
        }
    </div>

    @if (_errors.Count > 0)
    {
        <ul class="spec-messages errors">
            @foreach (var error in _errors)
            {
                <li>@error</li>
            }
        </ul>
    }

    @if (_warnings.Count > 0)
    {
        <ul class="spec-messages">
            @foreach (var warning in _warnings)
            {
                <li>@warning</li>
            }
        </ul>
    }
</div>
</section>

<h2>What a spec can say</h2>
<table class="docs">
    <tr><th>Series option</th><th>Meaning</th></tr>
    <tr><td><code>type</code></td><td>line, area, bar, pie, radialBar, or <code>auto</code> (time → line, categories → bar, shares of 100 % → donut). Synonyms such as column, doughnut and spline are accepted.</td></tr>
    <tr><td><code>x</code>, <code>y</code></td><td>Field names in the dataset; <code>dataset</code> on the chart or the series, or inline <code>data</code> rows.</td></tr>
    <tr><td><code>filter</code></td><td><code>[{ "field": "channel", "op": "eq", "value": "App" }]</code>, ops eq, ne, gt, gte, lt, lte, contains.</td></tr>
    <tr><td><code>timeBucket</code>, <code>aggregate</code></td><td>hour, day, week, month, quarter, year; sum, average, min, max, count, last.</td></tr>
    <tr><td><code>groupBy</code></td><td>One series per value of a field.</td></tr>
    <tr><td><code>sort</code>, <code>limit</code></td><td>Rank by y and keep the top N.</td></tr>
</table>
<p>
    Everything else (axes, annotations, legend, time zone...) is the same model as the components. Errors name the path and list what is valid,
    e.g. <code>series[0].y: field 'visits' not found in 'shop'; available: timestamp (time), channel (text), ...</code>, so an agent can fix the spec and try again.
    <code>ChartSpecJson.Schema()</code> returns the JSON schema with a description of every option.
</p>

<h3>The spec as read</h3>
@if (_normalized is not null)
{
    <CodeBlock Language="json" Code="@_normalized" />
}

@code {
    private static readonly (string Name, string Json)[] Examples =
    [
        ("Minimal", """
            {
              "dataset": "sales",
              "series": [{ "type": "line", "x": "month", "y": "revenue", "aggregate": "sum" }]
            }
            """),
        ("One line per channel", """
            {
              "dataset": "shop",
              "title": "Orders per channel",
              "y": { "title": "Orders per hour" },
              "series": [{ "type": "spline", "x": "timestamp", "y": "orders", "groupBy": "channel" }],
              "annotations": [{ "value": 20, "label": "Goal: 20 an hour" }]
            }
            """),
        ("Revenue per day", """
            {
              "dataset": "shop",
              "title": "Revenue per day",
              "y": { "title": "€" },
              "series": [{ "type": "column", "x": "timestamp", "y": "revenue", "timeBucket": "daily", "format": "#,0 €",
                           "aggregate": "sum", "groupBy": "channel", "stack": "channels" }]
            }
            """),
        ("Top categories (auto)", """
            {
              "dataset": "sales",
              "title": "Revenue per category, 2026 (k€)",
              "series": [{ "type": "auto", "x": "category", "y": "revenue", "aggregate": "sum", "sort": "desc" }]
            }
            """),
        ("Shares (auto donut)", """
            {
              "data": [ { "source": "Search", "share": 48 }, { "source": "Social", "share": 27 },
                        { "source": "Email", "share": 15 }, { "source": "Direct", "share": 10 } ],
              "series": [{ "type": "auto", "x": "source", "y": "share" }]
            }
            """),
        ("Two axes", """
            {
              "dataset": "shop",
              "y": { "title": "Sessions" },
              "yAxes": [{ "id": "eur", "title": "€" }],
              "series": [
                { "type": "bar", "x": "timestamp", "y": "revenue", "timeBucket": "day", "aggregate": "sum", "yAxisId": "eur", "name": "Revenue" },
                { "type": "line", "x": "timestamp", "y": "sessions", "timeBucket": "day", "aggregate": "sum", "name": "Sessions" }
              ]
            }
            """),
        ("With errors", """
            {
              "dataset": "shop",
              "series": [{ "type": "line", "x": "time", "y": "visits" }]
            }
            """),
    ];

    private string _json = "";
    private string _highlighted = "";
    private ChartSpec? _spec;
    private string? _normalized;
    private List<string> _errors = [];
    private List<string> _warnings = [];

    protected override void OnInitialized() => Load(Examples[1].Json);

    private void Load(string json)
    {
        _json = json;
        Render();
    }

    private void Render()
    {
        // The trailing space keeps a final empty line as tall as the textarea's.
        _highlighted = CodeHighlighter.ToHtml(_json, "json") + " ";
        var parsed = ChartSpecJson.Parse(_json);
        _errors = parsed.Errors.Select(e => e.ToString()).ToList();
        _warnings = [.. parsed.Warnings];
        _spec = parsed.Spec;
        _normalized = _spec is null ? null : ChartSpecJson.Serialize(_spec);
        if (_spec is not null)
        {
            var bound = ChartSpecBinder.Bind(_spec, SpecDatasets.ByName);
            _errors.AddRange(bound.Errors.Select(e => e.ToString()));
            _warnings.AddRange(bound.Warnings);
        }
    }
}
