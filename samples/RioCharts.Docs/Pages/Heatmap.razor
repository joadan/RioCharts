@page "/heatmap"

<PageTitle>Heatmap · RioCharts for Blazor and .NET</PageTitle>

<h1>Heatmap</h1>
<p class="lead">
    A grid of colored cells shows a value across two categories at once: traffic per weekday and hour, conversion per channel and day,
    orders per week and weekday. Darker means more.
</p>

<Example Title="Traffic by weekday and hour" Code="@WeekCode">
    <Description>
        <p>
            Each <code>HeatmapSeries</code> is a row, named by <code>Name</code>; its x values are the columns and its y values the colors.
            All rows share one scale: the lowest value is pale, the highest has the full color, and the legend shows the range. Hover a
            cell to see its value; with the chart focused, the arrow keys move between cells and rows.
        </p>
    </Description>
    <ChildContent>
        <RioChart TItem="HourCount" Title="Sessions per hour, last month" XAxis="_hourAxis" Height="300">
            @foreach (var (day, hours) in WeekTraffic)
            {
                <HeatmapSeries Items="hours" Name="@day" XValue="h => h.Hour" YValue="h => h.Sessions" Format="#,0" />
            }
        </RioChart>
    </ChildContent>
</Example>

<Example Title="Values in the cells" Code="@ConversionCode">
    <Description>
        <p>
            <code>DataLabels</code> writes each value in its cell when it fits, in light text on dark cells. <code>Max</code> sets the value
            that gets the full color; here the app's weekend rate stands out against the others.
        </p>
    </Description>
    <ChildContent>
        <RioChart TItem="Share" Title="Conversion rate per channel" Height="200">
            @foreach (var (channel, days) in ChannelConversion)
            {
                <HeatmapSeries Items="days" Name="@channel" XValue="d => d.Name" YValue="d => d.Value" Format="0.0'%'" DataLabels="true" Max="5" />
            }
        </RioChart>
    </ChildContent>
</Example>

<Example Title="Above and below a midpoint" Code="@ChangeCode">
    <Description>
        <p>
            For changes, or values around a normal level, set <code>Midpoint</code>: values above it take the series color and values below
            it <code>BelowColor</code> (default <code>--rio-negative</code>), each side faint near the midpoint and full at its furthest
            value. The legend shows both sides. Here, sessions against the same hour last week: fewer in the mornings, more in the evenings.
        </p>
    </Description>
    <ChildContent>
        <RioChart TItem="HourCount" Title="Sessions against last week" XAxis="_hourAxis" Height="240">
            @foreach (var (day, hours) in WeekChange)
            {
                <HeatmapSeries Items="hours" Name="@day" XValue="h => h.Hour" YValue="h => h.Sessions" Format="+0'%';-0'%';0'%'" Midpoint="0" />
            }
        </RioChart>
    </ChildContent>
</Example>

<Example Title="Stepped colors" Code="@BandsCode">
    <Description>
        <p>
            For fixed ranges, such as green, yellow and red levels, set <code>ColorBands</code> on the first row: each cell takes the solid
            color of the band its value is in, and the legend lists the bands. Later bands win where they overlap, so a first band without
            bounds and then <code>Above</code> limits leave no gaps (a value of exactly 50 is still green); values outside every band take
            the series color.
            <code>ColorValue</code> gives single cells a color of their own, which wins over the bands.
        </p>
    </Description>
    <ChildContent>
        <RioChart TItem="Share" Title="Server load per hour" Height="200">
            @foreach (var (server, hours) in ServerLoad)
            {
                <HeatmapSeries Items="hours" Name="@server" XValue="h => h.Name" YValue="h => h.Value" Format="0'%'" DataLabels="true" ColorBands="LoadLevels" />
            }
        </RioChart>
    </ChildContent>
</Example>

<h2>Options</h2>
<div class="table-scroll">
    <table class="docs">
        <tr><th>Option</th><th>Default</th><th>Meaning</th></tr>
        <tr><td><code>Name</code></td><td></td><td>The row's label. Rows are drawn top to bottom in the order of the series.</td></tr>
        <tr><td><code>XValue</code></td><td></td><td>The column: categories, numbers or times (cells as wide as the spacing of the data).</td></tr>
        <tr><td><code>YValue</code></td><td></td><td>The value that sets the cell's color. Missing values leave the cell empty.</td></tr>
        <tr><td><code>Color</code>, <code>Format</code>, <code>Max</code></td><td>first row's</td><td>The hue, value format and full-color value, shared by all rows.</td></tr>
        <tr><td><code>Midpoint</code>, <code>BelowColor</code></td><td>first row's</td><td>Colors diverge from the midpoint: above it the series color, below it <code>BelowColor</code> (default <code>--rio-negative</code>). JSON: <code>"midpoint"</code>, <code>"belowColor"</code>.</td></tr>
        <tr><td><code>ColorBands</code></td><td>first row's</td><td>Stepped colors: each cell takes the solid color of its value's band, and the legend lists the bands, by their <code>Label</code> (e.g. "High") or else their range. JSON: <code>"colorBands"</code>.</td></tr>
        <tr><td><code>ColorValue</code></td><td></td><td>A cell's own solid color (a CSS color or theme token); wins over the scale and the bands. JSON: <code>"colorField"</code>.</td></tr>
        <tr><td><code>DataLabels</code></td><td>false</td><td>Write the values in the cells (when they fit).</td></tr>
        <tr><td>JSON</td><td></td><td><code>"type": "heatmap"</code> with <code>"groupBy"</code> on the row field makes one row per value, e.g. <code>"x": "hour", "y": "sessions", "groupBy": "weekday"</code>.</td></tr>
    </table>
</div>

@code {
    private readonly AxisOptions _hourAxis = new() { Title = "Hour" };

    private static readonly ColorBand[] LoadLevels =
    [
        new() { Color = "--rio-series-5" },
        new() { Above = 50, Color = "--rio-series-2" },
        new() { Above = 80, Color = "--rio-negative" },
    ];

    // CPU load per server and hour, in %.
    private static readonly List<(string Server, List<Share> Hours)> ServerLoad =
        [.. new[] { "web-1", "web-2", "db-1" }.Select((server, k) => (server, Enumerable.Range(8, 12)
            .Select(h => new Share(h.ToString("00", System.Globalization.CultureInfo.InvariantCulture),
                Math.Clamp(Math.Round(55 + 30 * Math.Sin((h - 9) / 3.0) + 12 * Math.Sin(k * 2.3 + h)), 5, 99)))
            .ToList()))];

    private const string BandsCode = """
        <RioChart TItem="Share" Title="Server load per hour">
            @foreach (var (server, hours) in serverLoad)
            {
                <HeatmapSeries Items="hours" Name="@server" XValue="h => h.Name" YValue="h => h.Value"
                               Format="0'%'" DataLabels="true" ColorBands="levels" />
            }
        </RioChart>

        @code {
            ColorBand[] levels =
            [
                new() { Color = "--rio-series-5" },                // green: every value...
                new() { Above = 50, Color = "--rio-series-2" },    // ...yellow above 50...
                new() { Above = 80, Color = "--rio-negative" },    // ...red above 80 (later bands win)
            ];
        }
        """;

    // Change in sessions against the same hour last week, in %.
    private static readonly List<(string Day, List<HourCount> Hours)> WeekChange =
        [.. new[] { "Mon", "Tue", "Wed", "Thu", "Fri" }.Select((day, k) => (day, Enumerable.Range(8, 14)
            .Select(h => new HourCount(h.ToString("00", System.Globalization.CultureInfo.InvariantCulture), Math.Round(30 * Math.Sin((h - 13) / 5.0) + 6 * Math.Sin(k * 1.9 + h))))
            .ToList()))];

    private const string ChangeCode = """
        <RioChart TItem="HourCount" Title="Sessions against last week">
            @foreach (var (day, hours) in weekChange)
            {
                <HeatmapSeries Items="hours" Name="@day" XValue="h => h.Hour" YValue="h => h.Sessions"
                               Format="+0'%';-0'%';0'%'" Midpoint="0" />
            }
        </RioChart>
        """;

    private const string WeekCode = """
        <RioChart TItem="HourCount" Title="Sessions per hour, last month" XAxis="@(new AxisOptions { Title = "Hour" })">
            @foreach (var (day, hours) in weekTraffic)
            {
                <HeatmapSeries Items="hours" Name="@day" XValue="h => h.Hour" YValue="h => h.Sessions" Format="#,0" />
            }
        </RioChart>
        """;

    private const string ConversionCode = """
        <RioChart TItem="Share" Title="Conversion rate per channel">
            @foreach (var (channel, days) in channelConversion)
            {
                <HeatmapSeries Items="days" Name="@channel" XValue="d => d.Name" YValue="d => d.Value"
                               Format="0.0'%'" DataLabels="true" Max="5" />
            }
        </RioChart>
        """;
}
