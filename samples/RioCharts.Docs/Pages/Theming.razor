@page "/theming"

<PageTitle>Theming · RioCharts</PageTitle>

<h1>Theming</h1>
<p class="lead">
    Every color is a CSS variable. Light and dark defaults follow <code>prefers-color-scheme</code>, or an ancestor with
    <code>data-theme="dark"</code> or class <code>dark</code>. Use the toggle at the top to switch this site.
</p>

<Example Title="Your own palette" Code="@PaletteCode">
    <Description><p>Set any token anywhere above the chart, e.g. on <code>:root</code> or a wrapper element.</p></Description>
    <ChildContent>
        <div style="--rio-series-1: #0b6e4f; --rio-series-2: #c4721a; --rio-grid: #dfe7e2;">
            <RioChart TItem="Sales" Title="Revenue per quarter">
                <LineSeries Items="Quarters" Name="2025" XValue="s => s.Quarter" YValue="s => s.LastYear" Format="#,0 €" />
                <LineSeries Items="Quarters" Name="2026" XValue="s => s.Quarter" YValue="s => s.ThisYear" Format="#,0 €" />
            </RioChart>
        </div>
    </ChildContent>
</Example>

<h2>Tokens</h2>
<table class="docs">
    <tr><th>Variable</th><th>Used for</th></tr>
    <tr><td><code>--rio-text</code>, <code>--rio-text-muted</code></td><td>Titles and legend; axis labels.</td></tr>
    <tr><td><code>--rio-grid</code>, <code>--rio-axis</code></td><td>Grid lines; the baseline and crosshair.</td></tr>
    <tr><td><code>--rio-surface</code></td><td>Tooltip and slice gaps.</td></tr>
    <tr><td><code>--rio-annotation</code></td><td>Reference lines, bands and their labels.</td></tr>
    <tr><td><code>--rio-data-label-inverse</code></td><td>Labels drawn on top of bars and slices.</td></tr>
    <tr><td><code>--rio-positive</code>, <code>--rio-negative</code></td><td>Rising and falling candlesticks.</td></tr>
    <tr><td><code>--rio-series-1</code> … <code>--rio-series-10</code></td><td>The palette, in series order (colorblind-aware by default).</td></tr>
</table>

<p>Charts inherit the page font and use tabular numbers.</p>

<h2>Motion</h2>
<p>
    RioCharts doesn't animate charts. The only motion is a fade when the series first appear (0.35 seconds),
    plus brief fades when the tooltip, the buttons and the series that dim on legend hover appear.
</p>
<p>
    There are no animation options: bars don't grow, lines don't draw on and pies don't sweep in. Changed data is drawn in
    its new place right away, and zoom, pan and live data follow the pointer and the data without delay. A
    transition there would show values that aren't in the data, and the chart would lag behind what you do.
</p>
<p>
    When the user asks for reduced motion (<code>prefers-reduced-motion</code>), nothing moves. To turn motion off
    yourself, set <code>Animate="false"</code>. To change only the fade's length, set
    <code>--rio-enter-duration</code> (<code>0s</code> turns it off) anywhere above the chart.
</p>
<CodeBlock Code="@MotionCode" />

@code {
    private const string MotionCode = """
        @* No motion at all *@
        <RioChart TItem="Sales" Animate="false">…</RioChart>

        @* A quicker fade for every chart on the page *@
        <div style="--rio-enter-duration: 0.15s">…</div>
        """;

    private const string PaletteCode = """
        <div style="--rio-series-1: #0b6e4f; --rio-series-2: #c4721a; --rio-grid: #dfe7e2;">
            <RioChart TItem="Sales" Title="Revenue per quarter">
                <LineSeries Items="quarters" Name="2025" XValue="s => s.Quarter" YValue="s => s.LastYear" Format="#,0 €" />
                <LineSeries Items="quarters" Name="2026" XValue="s => s.Quarter" YValue="s => s.ThisYear" Format="#,0 €" />
            </RioChart>
        </div>
        """;
}
