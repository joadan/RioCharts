@page "/lines-and-areas"

<PageTitle>Lines and areas · RioCharts</PageTitle>

<h1>Lines and areas</h1>
<p class="lead">Time series are the common case: lines with three curve shapes, gaps for missing values, and areas that start at zero.</p>

<Example Title="Curves" Code="@CurvesCode">
    <Description>
        <p><code>Linear</code> (default), <code>Monotone</code> (smooth, never overshoots the data) and <code>Step</code> (each value holds until the next point, for setpoints and states).</p>
    </Description>
    <ChildContent>
        <div class="row">
            <RioChart TItem="Reading" Height="200" Title="Monotone">
                <LineSeries Items="Supply" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" />
            </RioChart>
            <RioChart TItem="Reading" Height="200" Title="Step">
                <LineSeries Items="Setpoints" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Step" />
            </RioChart>
        </div>
    </ChildContent>
</Example>

<Example Title="Gaps" Code="@GapsCode">
    <Description>
        <p>A <code>null</code> y value breaks the line instead of dropping to zero. A point with no neighbour gets a small dot so it stays visible.</p>
    </Description>
    <ChildContent>
        <RioChart Items="Outdoor" Height="220" YAxis="Celsius">
            <LineSeries Name="Outdoor" XValue="r => r.Time" YValue="r => r.Value" />
        </RioChart>
    </ChildContent>
</Example>

<Example Title="Irregular time series" Code="@IrregularCode">
    <Description>
        <p>
            Points are placed at their real times, so series do not need a fixed interval or the same timestamps. Here a room sensor logs
            only when the temperature changes by 0.2 °C (@RoomOnChange.Count readings: many while the room heats up, few at night), and the
            setpoint is a step line that changes at irregular times.
        </p>
        <p>
            A long silence is not a gap by itself: the sensor was offline 13:10–15:05 and the line simply joins the readings on either
            side. To break the line, add a reading with a <code>null</code> value where the data stops (see Gaps above).
        </p>
    </Description>
    <ChildContent>
        <RioChart TItem="Reading" Height="260" YAxis="Celsius">
            <LineSeries Items="RoomOnChange" Name="Room" XValue="r => r.Time" YValue="r => r.Value" Format="0.0 °C" />
            <LineSeries Items="RoomSetpoint" Name="Setpoint" XValue="r => r.Time" YValue="r => r.Value" Format="0.0 °C" Curve="CurveType.Step" />
        </RioChart>
    </ChildContent>
</Example>

<Example Title="Areas" Code="@AreaCode">
    <Description><p>Areas always include zero, with a light fill under the line.</p></Description>
    <ChildContent>
        <RioChart Items="Heating" Height="220" YAxis="Kwh">
            <AreaSeries Name="Heating" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" />
        </RioChart>
    </ChildContent>
</Example>

<Example Title="Stacked areas" Code="@StackedCode">
    <Description><p>Series with the same <code>Stack</code> name are stacked. Hide one in the legend and the stack closes up.</p></Description>
    <ChildContent>
        <RioChart TItem="Reading" Height="240" YAxis="Kwh">
            <AreaSeries Items="Heating" Name="Heating" XValue="r => r.Time" YValue="r => r.Value" Stack="use" Curve="CurveType.Monotone" />
            <AreaSeries Items="Ventilation" Name="Ventilation" XValue="r => r.Time" YValue="r => r.Value" Stack="use" Curve="CurveType.Monotone" />
        </RioChart>
    </ChildContent>
</Example>

<Example Title="Edge cases" Code="@EdgeCode">
    <Description><p>Empty data, a single point and all-equal values each render a clean state, never an error or a collapsed axis.</p></Description>
    <ChildContent>
        <div class="row">
            <RioChart TItem="Reading" Height="150" Title="Empty">
                <LineSeries Items="_empty" XValue="r => r.Time" YValue="r => r.Value" />
            </RioChart>
            <RioChart TItem="Reading" Height="150" Title="One point">
                <LineSeries Items="_one" XValue="r => r.Time" YValue="r => r.Value" />
            </RioChart>
            <RioChart TItem="Reading" Height="150" Title="All equal">
                <LineSeries Items="_flat" XValue="r => r.Time" YValue="r => r.Value" />
            </RioChart>
        </div>
    </ChildContent>
</Example>

@code {
    private static readonly AxisSpec Celsius = new() { Title = "°C" };
    private static readonly AxisSpec Kwh = new() { Title = "kWh" };
    private static readonly List<Reading> _empty = [];
    private static readonly List<Reading> _one = [new(Start, 21.5)];
    private static readonly List<Reading> _flat = Enumerable.Range(0, 24).Select(h => new Reading(Start.AddHours(h), 21)).ToList();

    private const string CurvesCode = """
        <LineSeries Items="supply" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" />
        <LineSeries Items="setpoints" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Step" />
        """;

    private const string GapsCode = """
        <RioChart Items="outdoor" YAxis="new AxisSpec { Title = "°C" }">
            <LineSeries Name="Outdoor" XValue="r => r.Time" YValue="r => r.Value" />  @* Value is double? *@
        </RioChart>
        """;

    private const string IrregularCode = """
        @* Readings logged on change: no fixed interval, different timestamps per series. *@
        <RioChart TItem="Reading" YAxis="new AxisSpec { Title = "°C" }">
            <LineSeries Items="roomReadings" Name="Room" XValue="r => r.Time" YValue="r => r.Value" Format="0.0 °C" />
            <LineSeries Items="setpoints" Name="Setpoint" XValue="r => r.Time" YValue="r => r.Value" Format="0.0 °C" Curve="CurveType.Step" />
        </RioChart>
        """;

    private const string AreaCode = """
        <RioChart Items="heating" YAxis="new AxisSpec { Title = "kWh" }">
            <AreaSeries Name="Heating" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" />
        </RioChart>
        """;

    private const string StackedCode = """
        <RioChart TItem="Reading" YAxis="new AxisSpec { Title = "kWh" }">
            <AreaSeries Items="heating" Name="Heating" XValue="r => r.Time" YValue="r => r.Value" Stack="use" />
            <AreaSeries Items="ventilation" Name="Ventilation" XValue="r => r.Time" YValue="r => r.Value" Stack="use" />
        </RioChart>
        """;

    private const string EdgeCode = """
        <RioChart TItem="Reading" Title="Empty"><LineSeries Items="empty" ... /></RioChart>
        <RioChart TItem="Reading" Title="One point"><LineSeries Items="one" ... /></RioChart>
        <RioChart TItem="Reading" Title="All equal"><LineSeries Items="flat" ... /></RioChart>
        """;
}
