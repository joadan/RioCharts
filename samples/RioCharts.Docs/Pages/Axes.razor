@page "/axes"

<PageTitle>Axes and time · RioCharts for Blazor and .NET</PageTitle>

<h1>Axes and time</h1>
<p class="lead">
    Axes are picked from the data: ticks fall on nice numbers or calendar boundaries, and labels follow the culture. A chart can have several
    y axes.
</p>

<Example Title="Time ticks that follow the range" Code="@TimeCode">
    <Description>
        <p>Ticks land on calendar boundaries: midnights, Mondays, the 1st of the month, 1 January. The densest set whose labels fit is used, so a narrow chart gets fewer ticks.</p>
    </Description>
    <ChildContent>
        <div class="row">
            <RioChart Items="WebSessions" Height="180" Title="Two days">
                <LineSeries Name="Sessions" XValue="r => r.Time" YValue="r => r.Value" />
            </RioChart>
            <RioChart Items="DailyOrders" Height="180" Title="Five weeks">
                <LineSeries Name="Orders" XValue="r => r.Time" YValue="r => r.Value" />
            </RioChart>
        </div>
    </ChildContent>
</Example>

<Example Title="Two Y axes" Code="@TwoAxesCode">
    <Description><p>Extra axes go on the right (or left, with <code>Position = AxisPosition.Left</code>); series pick one with <code>YAxisId</code>. Their ticks line up with the main grid. Several axes on one side sit side by side, each under its own title. <code>SeriesColor = true</code> colors the labels and title of an axis like its series, so it is clear which axis belongs to which line (or set <code>Color</code>). Here sessions per hour on the left and the orders they turn into on the right.</p></Description>
    <ChildContent>
        <RioChart TItem="Reading" YAxis="SessionsAxis" YAxes="_ordersAxis">
            <BarSeries Items="_hourlyOrders" Name="Orders" XValue="r => r.Time" YValue="r => r.Value" YAxisId="orders" Format="#,0 'orders'" />
            <LineSeries Items="_hourlySessions" Name="Sessions" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" Format="#,0 'sessions'" />
        </RioChart>
    </ChildContent>
</Example>

<Example Title="Formats and fixed ranges" Code="@FormatCode">
    <Description><p>Set <code>Format</code> (any .NET format string) and <code>Min</code>/<code>Max</code> on an axis; <code>Culture</code> on the chart.</p></Description>
    <ChildContent>
        <RioChart TItem="Sales" YAxis="_currency" Culture="_german" Height="240">
            <BarSeries Items="Quarters" Name="2026" XValue="s => s.Quarter" YValue="s => s.ThisYear" />
        </RioChart>
    </ChildContent>
</Example>

<Example Title="Labels from a function" Code="@BytesCode">
    <Description>
        <p>
            When a format string is not enough, e.g. bytes that pick KB, MB or GB themselves, give the axis a <code>LabelFormatter</code>.
            It writes the tick labels, and the tooltips and data labels of series without a <code>Format</code> of their own, so the values
            can stay in bytes. Ticks stay on round steps. A series' <code>Format</code> falls back to its axis' format or function; the axis
            never takes the series' format. For units of 1024, set <code>TickBase = 1024</code> too: the steps are then round in KB, MB
            or GB (20 MB, 40 MB) instead of round in bytes (47.7 MB, 95.4 MB).
        </p>
    </Description>
    <ChildContent>
        <RioChart TItem="Reading" YAxis="_bytesAxis" Height="240">
            <AreaSeries Items="_transfer" Name="Transferred" XValue="r => r.Time" YValue="r => r.Value" />
        </RioChart>
    </ChildContent>
</Example>

<Example Title="Category labels" Code="@CategoryLabelsCode">
    <Description>
        <p>
            Category labels that do not fit side by side slope at 45 degrees, so every bar keeps its name; long names are shortened
            with "…" (the tooltip has the full name). Set <code>LabelRotation</code> on the x axis for another angle (0 to 90), or
            <code>LabelRotation = 0</code> to keep them horizontal and show every n-th. In JSON definitions: <code>"x": { "labelRotation": 45 }</code>.
        </p>
    </Description>
    <ChildContent>
        <RioChart Items="SignupsByCountry" XAxis="@(_horizontalLabels ? HorizontalLabels : null)" Height="280">
            <BarSeries Name="Sign-ups" XValue="c => c.Name" YValue="c => c.Value" Format="#,0" />
        </RioChart>
        <p class="note">
            <label><input type="checkbox" @bind="_horizontalLabels" /> <code>LabelRotation = 0</code></label>
        </p>
    </ChildContent>
</Example>

<Example Title="Logarithmic axis" Code="@LogCode">
    <Description>
        <p>
            For values that span several powers of ten, <code>Scale = ScaleType.Log</code> on a y axis gives equal ratios equal
            distances: 10 to 100 is as tall as 100k to 1M. Here the visits per page in a month: on a linear axis the start page
            flattens everything else, on a log axis every page can be read. Ticks are powers of ten (with 2 and 5 between them when
            the range is short); bars start at the bottom of the axis. Zero and negative values have no place on a log axis: they
            are left out, with a warning. In JSON definitions: <code>"y": { "scale": "log" }</code>.
        </p>
    </Description>
    <ChildContent>
        <RioChart Items="PageVisits" YAxis="@(_log ? VisitsLog : Visits)" Height="260">
            <BarSeries Name="Visits" XValue="p => p.Name" YValue="p => p.Value" Format="#,0" DataLabels="true" />
        </RioChart>
        <p class="note">
            <label><input type="checkbox" @bind="_log" /> Logarithmic</label>
        </p>
    </ChildContent>
</Example>

<Example Title="Logarithmic on both axes" Code="@LogLogCode">
    <Description>
        <p>
            The x axis takes <code>Scale = ScaleType.Log</code> too, for numbers under lines, areas and scatter points (bars need even
            spacing, so their x axis stays linear, with a warning). Log on both axes, a power law such as load time against page size
            becomes a straight line. Points at x zero or below are left out, x lines and bands are placed by ratio, and zoom and pan keep
            ratios: drag to zoom, Shift-drag to pan. In JSON definitions: <code>"x": { "scale": "log" }</code>.
        </p>
    </Description>
    <ChildContent>
        <RioChart Items="PageLoads" XAxis="PageSize" YAxis="LoadTime" Height="280" Zoomable="true" Annotations="OneMegabyte">
            <ScatterSeries Name="Pages" XValue="p => p.SizeKb" YValue="p => p.Ms" Format="#,0 'ms'" />
        </RioChart>
    </ChildContent>
</Example>

<Example Title="Display time zone" Code="@ZoneCode">
    <Description>
        <p>
            By default times are shown exactly as given. With <code>TimeZone</code> (<code>"UTC"</code>, <code>"local"</code> for the visitor's zone, or an IANA id),
            times are plotted on instants and labelled in that zone, so a line runs straight through the repeated hour when summer time ends.
            Tooltips show the offset when it differs from yours. <code>TooltipFormat</code> on the x axis sets the tooltip's time format
            instead (e.g. <code>"d MMM HH:mm"</code>, without seconds), with no offset added; the axis labels keep theirs.
        </p>
    </Description>
    <ChildContent>
        <RioChart TItem="(DateTimeOffset Time, double Value)" Items="DstOrders" TimeZone="@_zone" Height="220" YAxis="OrdersPerHour">
            <LineSeries Name="Orders" XValue="m => m.Time" YValue="m => m.Value" Curve="CurveType.Monotone" Format="#,0 'orders'" />
        </RioChart>
        <p class="note">
            Zone:
            <select @bind="_zone">
                <option value="">none (as given: UTC here)</option>
                <option value="local">local (your browser)</option>
                <option value="Europe/Stockholm">Europe/Stockholm</option>
                <option value="America/New_York">America/New_York</option>
            </select>
        </p>
    </ChildContent>
</Example>

<Example Title="Time buckets in the display zone" Code="@ZoneBucketCode">
    <Description>
        <p>
            With a <code>TimeZone</code>, <code>Bucket</code> groups on the calendar of that zone: a day runs from midnight to midnight there,
            weeks start on Monday there, and a day with a daylight saving change is 23 or 25 hours long. The same orders, stored in UTC,
            give other daily totals in New York or Tokyo. Without a zone, buckets use the times as given. JSON definitions do the same with
            <code>"timeZone"</code> and <code>"timeBucket"</code>.
        </p>
    </Description>
    <ChildContent>
        <RioChart TItem="(DateTimeOffset Time, double Value)" Items="UtcOrders" TimeZone="@_bucketZone" Height="220" YAxis="OrdersPerDay">
            <BarSeries Name="Orders" XValue="m => m.Time" YValue="m => m.Value" Bucket="TimeBucket.Day" Aggregate="Aggregate.Sum" Format="#,0 'orders'" DataLabels="true" />
        </RioChart>
        <p class="note">
            Zone:
            <select @bind="_bucketZone">
                <option value="UTC">UTC</option>
                <option value="local">local (your browser)</option>
                <option value="America/New_York">America/New_York</option>
                <option value="Asia/Tokyo">Asia/Tokyo</option>
            </select>
        </p>
    </ChildContent>
</Example>

@code {
    private static readonly AxisOptions OrdersPerDay = new() { Title = "Orders per day" };
    private string? _bucketZone = "America/New_York";

    // Orders per hour for four days, stored in UTC, busiest around 15:00 UTC.
    private static readonly (DateTimeOffset Time, double Value)[] UtcOrders = [.. Enumerable.Range(0, 4 * 24).Select(h =>
        (new DateTimeOffset(2026, 11, 16, 0, 0, 0, TimeSpan.Zero).AddHours(h), Math.Round(12 + 10 * Math.Cos((h % 24 - 15) * Math.PI / 12) + (h / 24) * 2)))];

    private const string ZoneBucketCode = """
        <RioChart Items="orders" TimeZone="America/New_York">   @* Time is a DateTimeOffset in UTC *@
            <BarSeries XValue="m => m.Time" YValue="m => m.Value" Bucket="TimeBucket.Day" Aggregate="Aggregate.Sum" />
        </RioChart>
        """;

    private static readonly AxisOptions SessionsAxis = new() { Title = "Sessions per hour", SeriesColor = true };
    private static readonly AxisOptions OrdersPerHour = new() { Title = "Orders per hour" };
    private static readonly IReadOnlyList<AxisOptions> _ordersAxis = [new() { Id = "orders", Title = "Orders", SeriesColor = true }];
    private static readonly AxisOptions _currency = new() { Title = "EUR", Format = "C0", Min = 0 };
    private static readonly AxisOptions _bytesAxis = new() { Title = "Per hour", LabelFormatter = Bytes, TickBase = 1024 };
    private static readonly List<Reading> _transfer = [.. Enumerable.Range(0, 48).Select(h =>
        new Reading(new DateTime(2026, 11, 16).AddHours(h), Math.Round(2.4e9 + 1.9e9 * Math.Sin((h - 9) / 3.8) + 4e8 * Math.Sin(h * 1.7))))];

    private static string Bytes(double v)
    {
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        var unit = 0;
        while (Math.Abs(v) >= 1024 && unit < units.Length - 1)
        {
            v /= 1024;
            unit++;
        }

        return $"{v:0.#} {units[unit]}";
    }
    private static readonly System.Globalization.CultureInfo _german = System.Globalization.CultureInfo.GetCultureInfo("de-DE");
    private string? _zone = "Europe/Stockholm";
    private bool _log = true;
    private static readonly AxisOptions Visits = new() { Title = "Visits per month" };
    private static readonly AxisOptions VisitsLog = Visits with { Scale = ScaleType.Log };

    private sealed record Named(string Name, double Value);

    private bool _horizontalLabels;
    private static readonly AxisOptions HorizontalLabels = new() { LabelRotation = 0 };

    private static readonly Named[] SignupsByCountry = [.. new[]
    {
        "Germany", "France", "United Kingdom", "Spain", "Italy", "Netherlands", "Poland", "Sweden", "Belgium", "Austria",
        "Switzerland", "Denmark", "Norway", "Finland", "Portugal", "Ireland", "Czech Republic", "Greece",
    }.Select((name, i) => new Named(name, Math.Round(4200 * Math.Pow(0.82, i))))];

    private const string CategoryLabelsCode = """
        @* Labels that do not fit slope at 45 degrees. XAxis="@(new AxisOptions { LabelRotation = 0 })" keeps them horizontal. *@
        <RioChart Items="signupsByCountry">
            <BarSeries Name="Sign-ups" XValue="c => c.Name" YValue="c => c.Value" Format="#,0" />
        </RioChart>
        """;

    private sealed record PageLoad(double SizeKb, double Ms);

    // Page load time in ms against page size in kB: about a power law, with some scatter.
    private static readonly PageLoad[] PageLoads = [.. Enumerable.Range(0, 40).Select(i => new PageLoad(Math.Round(Math.Pow(10, 1 + i * 0.075), 1),
        Math.Round(60 * Math.Pow(10, (1 + i * 0.075) * 0.55) * (1 + 0.35 * Math.Sin(i * 2.3)))))];

    private static readonly AxisOptions PageSize = new() { Title = "Page size, kB", Scale = ScaleType.Log };
    private static readonly AxisOptions LoadTime = new() { Title = "Load time, ms", Scale = ScaleType.Log };
    private static readonly IReadOnlyList<Annotation> OneMegabyte = [new() { Axis = AnnotationAxis.X, Value = 1000.0, Label = "1 MB" }];

    private const string LogLogCode = """
        <RioChart Items="pageLoads" Zoomable="true"
                  XAxis="@(new AxisOptions { Title = "Page size, kB", Scale = ScaleType.Log })"
                  YAxis="@(new AxisOptions { Title = "Load time, ms", Scale = ScaleType.Log })">
            <ScatterSeries Name="Pages" XValue="p => p.SizeKb" YValue="p => p.Ms" Format="#,0 'ms'" />
        </RioChart>
        """;

    private const string LogCode = """
        <RioChart Items="pageVisits" YAxis="@(new AxisOptions { Title = "Visits per month", Scale = ScaleType.Log })">
            <BarSeries Name="Visits" XValue="p => p.Name" YValue="p => p.Value" Format="#,0" DataLabels="true" />
        </RioChart>
        """;

    // Web sessions per hour (four 15-minute readings each), and the orders they bring.
    private static readonly List<Reading> _hourlySessions = WebSessions.Chunk(4)
        .Select(c => new Reading(c[0].Time, c.Sum(r => r.Value ?? 0)))
        .ToList();

    private static readonly List<Reading> _hourlyOrders = _hourlySessions
        .Select((r, h) => new Reading(r.Time, Math.Round(r.Value!.Value * 0.026 + Noise(h, 12) * 4, 0)))
        .ToList();

    private const string TimeCode = """
        <RioChart Items="sessions" Title="Two days">
            <LineSeries XValue="r => r.Time" YValue="r => r.Value" />
        </RioChart>
        """;

    private const string TwoAxesCode = """
        <RioChart TItem="Reading" YAxis="@(new AxisOptions { Title = "Sessions per hour", SeriesColor = true })"
                  YAxes="@([new AxisOptions { Id = "orders", Title = "Orders", SeriesColor = true }])">
            <BarSeries Items="orders" Name="Orders" XValue="r => r.Time" YValue="r => r.Value" YAxisId="orders" />
            <LineSeries Items="sessions" Name="Sessions" XValue="r => r.Time" YValue="r => r.Value" />
        </RioChart>
        """;

    private const string BytesCode = """
        <RioChart Items="transfer" YAxis="@(new AxisOptions { Title = "Per hour", LabelFormatter = Bytes, TickBase = 1024 })">
            <AreaSeries Name="Transferred" XValue="r => r.Time" YValue="r => r.Value" />   @* Value in bytes *@
        </RioChart>

        @code {
            static string Bytes(double v)
            {
                string[] units = ["B", "KB", "MB", "GB", "TB"];
                var unit = 0;
                while (Math.Abs(v) >= 1024 && unit < units.Length - 1)
                {
                    v /= 1024;
                    unit++;
                }

                return $"{v:0.#} {units[unit]}";
            }
        }
        """;

    private const string FormatCode = """
        <RioChart TItem="Sales" Culture="CultureInfo.GetCultureInfo("de-DE")"
               YAxis="@(new AxisOptions { Title = "EUR", Format = "C0", Min = 0 })">
            <BarSeries Items="quarters" Name="2026" XValue="s => s.Quarter" YValue="s => s.ThisYear" />
        </RioChart>
        """;

    private const string ZoneCode = """
        <RioChart Items="orders" TimeZone="Europe/Stockholm">   @* Time is a DateTimeOffset *@
            <LineSeries XValue="m => m.Time" YValue="m => m.Value" />
        </RioChart>
        """;
}
