@page "/interaction"

<PageTitle>Tooltips, clicks and zoom · RioCharts</PageTitle>

<h1>Tooltips, clicks and zoom</h1>
<p class="lead">
    The chart sends its points to the browser once per layout; hover, crosshair and zoom previews run there. Only clicks and finished zooms
    (and hovers with a tooltip template) call back into .NET, so charts stay responsive on Blazor Server too.
</p>

<Example Title="Tooltip, legend and point clicks" Code="@ClickCode">
    <Description>
        <p>One tooltip per x lists every series. Hover or focus a legend item for a summary of its series (range, last value, trend; for slices the value and share). Click it to hide the series (<code>@@bind-HiddenSeries</code> keeps it in your page); click a point to get its item.</p>
    </Description>
    <ChildContent>
        <RioChart TItem="Reading" YAxis="Sessions" @bind-HiddenSeries="_hidden" OnPointClick="e => _point = e">
            <LineSeries Items="WebSessions" Name="Web" XValue="r => r.Time" YValue="r => r.Value" Format="#,0 'sessions'" />
            <LineSeries Items="AppSessions" Name="App" XValue="r => r.Time" YValue="r => r.Value" Format="#,0 'sessions'" />
        </RioChart>
        <p class="note">
            Hidden: @(_hidden.Count == 0 ? "none" : string.Join(", ", _hidden)).
            Clicked: @(_point is null ? "nothing yet" : $"{_point.SeriesName} {_point.Item?.Value:#,0} sessions at {_point.Item?.Time:g}")
        </p>
    </ChildContent>
</Example>

<Example Title="Keyboard and screen readers" Code="@KeyboardCode">
    <Description>
        <p>
            Every chart with data is a tab stop. With it focused, <kbd>←</kbd> and <kbd>→</kbd> move between points, <kbd>↑</kbd> and
            <kbd>↓</kbd> between series (on pies, every arrow moves between slices), <kbd>Home</kbd>, <kbd>End</kbd>, <kbd>Page Up</kbd> and
            <kbd>Page Down</kbd> jump. The crosshair and tooltip follow, linked charts follow too, and screen readers hear each point
            (for example "Mon 01:00: Web 177 sessions, App 114 sessions. 5 of 192"). <kbd>Enter</kbd> raises <code>OnPointClick</code> and
            <kbd>Esc</kbd> leaves. On <code>Zoomable</code> charts, <kbd>+</kbd> and <kbd>−</kbd> zoom around the focused point,
            <kbd>Shift</kbd>+<kbd>←</kbd>/<kbd>→</kbd> pans and <kbd>0</kbd> shows all data (try it on the zoom example below).
            It all runs in the browser; only finished zooms and Enter call .NET.
        </p>
        <p>Click the chart below or Tab to it, then use the arrow keys. <code>KeyboardNavigation="false"</code> turns it off.</p>
    </Description>
    <ChildContent>
        <RioChart TItem="Reading" Height="240" YAxis="Sessions" OnPointClick="e => _keyPoint = e">
            <LineSeries Items="WebSessions" Name="Web" XValue="r => r.Time" YValue="r => r.Value" Format="#,0 'sessions'" />
            <LineSeries Items="AppSessions" Name="App" XValue="r => r.Time" YValue="r => r.Value" Format="#,0 'sessions'" />
        </RioChart>
        <p class="note">Selected with Enter: @(_keyPoint is null ? "nothing yet" : $"{_keyPoint.SeriesName} {_keyPoint.Item?.Value:#,0} sessions at {_keyPoint.Item?.Time:g}")</p>
    </ChildContent>
</Example>

<Example Title="Custom tooltip text" Code="@FormatCode">
    <Description>
        <p>
            <code>TooltipValue</code> on a series and <code>TooltipHeader</code> on the chart replace the text of the value and the header.
            They get the hovered point (<code>X</code>, <code>Y</code>, <code>Item</code>, <code>Items</code>, the default text) and run once per
            layout, not on pointer moves, so the tooltip stays fully in the browser. Return null to keep the default.
        </p>
    </Description>
    <ChildContent>
        <RioChart TItem="Reading" YAxis="Sessions" TooltipHeader="@(p => p.X is DateTime t ? t.ToString("dddd HH:mm") : null)">
            <LineSeries Items="WebSessions" Name="Web" XValue="r => r.Time" YValue="r => r.Value"
                        TooltipValue="@(p => $"{p.Y:#,0} sessions ({p.Y - AppSessions[p.Index].Value:#,0} more than the app)")" />
            <LineSeries Items="AppSessions" Name="App" XValue="r => r.Time" YValue="r => r.Value" Format="#,0 'sessions'" />
        </RioChart>
    </ChildContent>
</Example>

<Example Title="Tooltip template" Code="@TemplateCode">
    <Description>
        <p>
            <code>TooltipTemplate</code> renders any Razor inside the tooltip card. Its <code>context</code> has the <code>Header</code>, the
            <code>X</code> value and the hovered <code>Points</code>, each with its items. The built-in classes (<code>rio-tooltip-head</code>,
            <code>-row</code>, <code>-dot</code>, <code>-name</code>, <code>-value</code>) keep the default look.
        </p>
        <p>
            The crosshair still follows the pointer in the browser, but the content is rendered by .NET when the hovered x changes: on Blazor
            Server it lags one round trip behind. Prefer <code>TooltipValue</code> and <code>TooltipHeader</code> when text is enough.
        </p>
    </Description>
    <ChildContent>
        <RioChart TItem="Ticket" Items="Tickets" Height="240" YAxis="Minutes">
            <ChildContent>
                <BarSeries Name="Handling time" XValue="t => t.Topic" YValue="t => t.Minutes" Aggregate="Aggregate.Sum" />
            </ChildContent>
            <TooltipTemplate>
                <div class="rio-tooltip-head">@context.Header: @context.Points[0].Items.Count tickets</div>
                @foreach (var ticket in context.Points[0].Items)
                {
                    <div class="rio-tooltip-row">
                        <span class="rio-tooltip-name">@ticket.Subject</span>
                        <span class="rio-tooltip-value">@ticket.Minutes min</span>
                    </div>
                }
            </TooltipTemplate>
        </RioChart>
    </ChildContent>
</Example>

<Example Title="Zoom, pan and linked charts" Code="@ZoomCode">
    <Description>
        <p>
            Drag to zoom, Shift+drag to pan, Ctrl/⌘+wheel to zoom at the pointer, double-click to reset. On touch screens, pinch to zoom
            and move two fingers to pan. The y axis fits the visible data.
            Charts in the same <code>Group</code> share the crosshair and the zoom, and line up their plots.
        </p>
    </Description>
    <ChildContent>
        <RioChart TItem="Reading" Height="200" YAxis="Sessions" Zoomable="true" Group="store" @bind-VisibleRange="_range">
            <LineSeries Items="WebSessions" Name="Web" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" />
            <LineSeries Items="AppSessions" Name="App" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" />
        </RioChart>
        <RioChart TItem="Reading" Height="150" YAxis="Euros" Zoomable="true" Group="store">
            <AreaSeries Items="Revenue" Name="Revenue" XValue="r => r.Time" YValue="r => r.Value" Format="#,0 €" Curve="CurveType.Monotone" />
        </RioChart>
        <p class="note">
            Visible: @(_range is null ? "all" : $"{_range.Min:g} – {_range.Max:g}")
            <button class="small" @onclick="() => _range = ChartRange.Of(Start.AddHours(30), Start.AddHours(42))">Zoom to 17 Nov 06–18</button>
        </p>
    </ChildContent>
</Example>

<Example Title="Selecting points and ranges" Code="@SelectionCode">
    <Description>
        <p>
            <code>Selection="SelectionMode.Range"</code>: drag across the plot to select a range, click to clear it.
            <code>SelectionMode.Points</code>: click a point or bar to select it, Ctrl/⌘ or Shift+click to add or remove one, click beside
            the points to clear. Bind <code>@@bind-SelectedItems</code> and <code>@@bind-SelectedRange</code>, or handle <code>OnSelectionChanged</code>.
            A range selects the items of the visible series inside it.
        </p>
    </Description>
    <ChildContent>
        <RioChart TItem="Reading" Height="200" YAxis="Sessions" Selection="SelectionMode.Range"
                  @bind-SelectedRange="_selectedRange" @bind-SelectedItems="_selectedReadings">
            <LineSeries Items="WebSessions" Name="Web" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" />
        </RioChart>
        <p class="note">
            @if (_selectedRange is null)
            {
                <span>Drag across the chart to select a range.</span>
            }
            else
            {
                <span>@($"{_selectedRange.Min:g} – {_selectedRange.Max:g}"): @_selectedReadings.Count readings, @($"{_selectedReadings.Sum(r => r.Value ?? 0):#,0}") sessions.</span>
                <button class="small" @onclick="() => _selectedRange = null">Clear</button>
            }
        </p>
        <RioChart TItem="Ticket" Items="Tickets" Height="200" YAxis="Minutes" Selection="SelectionMode.Points" @bind-SelectedItems="_selectedTickets">
            <BarSeries Name="Handling time" XValue="t => t.Topic" YValue="t => t.Minutes" Aggregate="Aggregate.Sum" />
        </RioChart>
        <p class="note">
            @if (_selectedTickets.Count == 0)
            {
                <span>Click a bar to see its tickets.</span>
            }
            else
            {
                <span>@string.Join(", ", _selectedTickets.Select(t => $"{t.Subject} ({t.Minutes} min)"))</span>
            }
        </p>
    </ChildContent>
</Example>

<Example Title="Tooltip from code" Code="@ShowTooltipCode">
    <Description>
        <p>
            <code>ShowTooltipAsync(x)</code> shows the crosshair and tooltip at an x value as if the pointer were there, and linked charts follow;
            <code>HideTooltipAsync()</code> hides it. Here, hovering a row of the table points it out in the chart.
        </p>
    </Description>
    <ChildContent>
        <RioChart @ref="_ordersChart" TItem="Reading" Items="LastWeek" Height="200">
            <LineSeries Name="Orders" XValue="r => r.Time" YValue="r => r.Value" Format="#,0" />
        </RioChart>
        <table class="docs hover-table">
            <thead><tr><th>Day</th><th>Orders</th></tr></thead>
            <tbody>
                @foreach (var day in LastWeek)
                {
                    <tr @onmouseenter="() => _ordersChart!.ShowTooltipAsync(day.Time)" @onmouseleave="() => _ordersChart!.HideTooltipAsync()">
                        <td>@day.Time.ToString("ddd d MMM")</td><td class="num">@($"{day.Value:#,0}")</td>
                    </tr>
                }
            </tbody>
        </table>
    </ChildContent>
</Example>

<Example Title="Highlight and show series from code" Code="@SeriesCode">
    <Description>
        <p>
            Hover or focus a legend item, or one of the buttons below the chart, to fade the other series: <code>HighlightSeriesAsync(id)</code>.
            Here <code>OnLegendClicking</code> cancels the usual toggle and shows only the clicked series instead, with
            <code>ShowSeriesAsync</code>/<code>HideSeriesAsync</code> inside <code>ApplyAsync</code> so the chart draws once.
        </p>
    </Description>
    <ChildContent>
        <RioChart @ref="_sourcesChart" TItem="Reading" Height="220" YAxis="Sessions" OnLegendClicking="ShowOnly">
            <LineSeries Id="search" Items="Search" Name="Search" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" />
            <LineSeries Id="social" Items="Social" Name="Social" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" />
            <LineSeries Id="email" Items="Email" Name="Email" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" />
        </RioChart>
        <p class="note">
            @foreach (var (id, name) in Sources)
            {
                <button class="small" @onmouseenter="() => _sourcesChart!.HighlightSeriesAsync(id)" @onmouseleave="() => _sourcesChart!.HighlightSeriesAsync(null)"
                        @onfocus="() => _sourcesChart!.HighlightSeriesAsync(id)" @onblur="() => _sourcesChart!.HighlightSeriesAsync(null)"
                        @onclick="() => _sourcesChart!.ToggleSeriesAsync(id)">@name</button>
            }
            <button class="small" @onclick="ShowAll">Show all</button>
        </p>
    </ChildContent>
</Example>

<h2>From code</h2>
<p>Everything the user can do has an API: take a reference with <code>@@ref</code> and call
    <code>ZoomToAsync</code>, <code>PanAsync</code>, <code>ResetZoomAsync</code>, <code>GetVisibleRange</code>, <code>SelectItemsAsync</code>,
    <code>SelectRangeAsync</code>, <code>ClearSelectionAsync</code>, <code>GetItemsInRange</code>, <code>ShowTooltipAsync</code>,
    <code>ShowSeriesAsync</code>, <code>HideSeriesAsync</code>, <code>ToggleSeriesAsync</code>, <code>HighlightSeriesAsync</code> or <code>Refresh</code>.
    <code>ApplyAsync(async () => …)</code> groups several of them into one redraw. <code>OnZoomChanging</code> and <code>OnLegendClicking</code>
    can change or cancel what the user did.</p>
<p>To place your own elements over a chart, <code>ValueToPixel(x, y)</code> gives the position of a data value in CSS pixels from the chart's
    top left corner, and <code>PixelToValue(x, y)</code> the value at a position. <code>Layout</code> exposes the scales and the hit-test index.</p>

@code {
    private static readonly AxisSpec Sessions = new() { Title = "Sessions per 15 min" };
    private static readonly AxisSpec Euros = new() { Title = "€ per 15 min" };
    private static readonly AxisSpec Minutes = new() { Title = "min" };
    private IReadOnlyCollection<string> _hidden = [];
    private PointClickEventArgs<Reading>? _point;
    private ChartRange? _range;
    private ChartRange? _selectedRange;
    private IReadOnlyCollection<Reading> _selectedReadings = [];
    private IReadOnlyCollection<Ticket> _selectedTickets = [];
    private RioChart<Reading>? _ordersChart;
    private static readonly List<Reading> LastWeek = DailyOrders.TakeLast(7).ToList();
    private RioChart<Reading>? _sourcesChart;
    private static readonly (string Id, string Name)[] Sources = [("search", "Search"), ("social", "Social"), ("email", "Email")];

    // A legend click shows only that series (or all again when it already is the only one).
    private async Task ShowOnly(LegendClickingEventArgs e)
    {
        e.Cancel = true;
        var chart = _sourcesChart!;
        var alone = Sources.All(s => chart.IsSeriesVisible(s.Id) == (s.Id == e.SeriesId));
        await chart.ApplyAsync(async () =>
        {
            foreach (var (id, _) in Sources)
            {
                await (alone || id == e.SeriesId ? chart.ShowSeriesAsync(id) : chart.HideSeriesAsync(id));
            }
        });
    }

    private Task ShowAll() => _sourcesChart!.ApplyAsync(async () =>
    {
        foreach (var (id, _) in Sources)
        {
            await _sourcesChart.ShowSeriesAsync(id);
        }
    });

    private const string SeriesCode = """
        <RioChart @ref="chart" TItem="Reading" OnLegendClicking="ShowOnly">
            <LineSeries Id="search" Items="search" Name="Search" ... />
            <LineSeries Id="social" Items="social" Name="Social" ... />
            <LineSeries Id="email" Items="email" Name="Email" ... />
        </RioChart>

        <button @onmouseenter="() => chart.HighlightSeriesAsync("social")"
                @onmouseleave="() => chart.HighlightSeriesAsync(null)">Social</button>

        @code {
            async Task ShowOnly(LegendClickingEventArgs e)
            {
                e.Cancel = true; // instead of toggling: show only the clicked series
                await chart.ApplyAsync(async () =>
                {
                    foreach (var id in ids)
                        await (id == e.SeriesId ? chart.ShowSeriesAsync(id) : chart.HideSeriesAsync(id));
                });
            }
        }
        """;

    private const string ClickCode = """
        <RioChart TItem="Reading" @bind-HiddenSeries="hidden" OnPointClick="e => clicked = e">
            <LineSeries Items="web" Name="Web" XValue="r => r.Time" YValue="r => r.Value" Format="#,0 'sessions'" />
            <LineSeries Items="app" Name="App" XValue="r => r.Time" YValue="r => r.Value" Format="#,0 'sessions'" />
        </RioChart>
        """;

    private PointClickEventArgs<Reading>? _keyPoint;

    private const string KeyboardCode = """
        <RioChart TItem="Reading" OnPointClick="e => selected = e">
            <LineSeries Items="web" Name="Web" XValue="r => r.Time" YValue="r => r.Value" Format="#,0 'sessions'" />
            <LineSeries Items="app" Name="App" XValue="r => r.Time" YValue="r => r.Value" Format="#,0 'sessions'" />
        </RioChart>
        """;

    private const string FormatCode = """
        <RioChart TItem="Reading" TooltipHeader="@(p => p.X is DateTime t ? t.ToString("dddd HH:mm") : null)">
            <LineSeries Items="web" Name="Web" XValue="r => r.Time" YValue="r => r.Value"
                        TooltipValue="@(p => $"{p.Y:#,0} sessions ({p.Y - app[p.Index].Value:#,0} more than the app)")" />
            <LineSeries Items="app" Name="App" XValue="r => r.Time" YValue="r => r.Value" Format="#,0 'sessions'" />
        </RioChart>
        """;

    private const string TemplateCode = """
        <RioChart TItem="Ticket" Items="tickets">
            <ChildContent>
                <BarSeries Name="Handling time" XValue="t => t.Topic" YValue="t => t.Minutes" Aggregate="Aggregate.Sum" />
            </ChildContent>
            <TooltipTemplate>
                <div class="rio-tooltip-head">@context.Header: @context.Points[0].Items.Count tickets</div>
                @foreach (var ticket in context.Points[0].Items)
                {
                    <div class="rio-tooltip-row">
                        <span class="rio-tooltip-name">@ticket.Subject</span>
                        <span class="rio-tooltip-value">@ticket.Minutes min</span>
                    </div>
                }
            </TooltipTemplate>
        </RioChart>
        """;

    private const string SelectionCode = """
        <RioChart TItem="Reading" Selection="SelectionMode.Range" @bind-SelectedRange="range" @bind-SelectedItems="readings">
            <LineSeries Items="web" Name="Web" XValue="r => r.Time" YValue="r => r.Value" />
        </RioChart>
        <p>@readings.Count readings, @readings.Sum(r => r.Value) sessions</p>

        <RioChart TItem="Ticket" Items="tickets" Selection="SelectionMode.Points" @bind-SelectedItems="selected">
            <BarSeries Name="Handling time" XValue="t => t.Topic" YValue="t => t.Minutes" Aggregate="Aggregate.Sum" />
        </RioChart>
        """;

    private const string ShowTooltipCode = """
        <RioChart @ref="chart" TItem="Reading" Items="orders">
            <LineSeries Name="Orders" XValue="r => r.Time" YValue="r => r.Value" />
        </RioChart>

        @foreach (var day in orders)
        {
            <tr @onmouseenter="() => chart.ShowTooltipAsync(day.Time)" @onmouseleave="() => chart.HideTooltipAsync()">…</tr>
        }
        """;

    private const string ZoomCode = """
        <RioChart TItem="Reading" Zoomable="true" Group="store" @bind-VisibleRange="range">
            <LineSeries Items="web" ... />
        </RioChart>
        <RioChart TItem="Reading" Zoomable="true" Group="store">
            <AreaSeries Items="revenue" ... />
        </RioChart>

        <button @onclick="() => range = ChartRange.Of(from, to)">Zoom</button>
        """;
}
