@page "/interaction"

<PageTitle>Tooltips, clicks and zoom · RioCharts</PageTitle>

<h1>Tooltips, clicks and zoom</h1>
<p class="lead">
    The chart sends its points to the browser once per layout; hover, crosshair and zoom previews run there. Only clicks and finished zooms
    (and hovers with a tooltip template) call back into .NET, so charts stay responsive on Blazor Server too.
</p>

<Example Title="Tooltip, legend and point clicks" Code="@ClickCode">
    <Description>
        <p>One tooltip per x lists every series. Hover or focus a legend item for a summary of its series (range, last value, trend; for slices the value and share). Click it to hide the series (<code>@@bind-HiddenSeries</code> keeps it in your page); click a point to get its item.</p>
    </Description>
    <ChildContent>
        <RioChart TItem="Reading" YAxis="Celsius" @bind-HiddenSeries="_hidden" OnPointClick="e => _point = e">
            <LineSeries Items="Supply" Name="Supply" XValue="r => r.Time" YValue="r => r.Value" Format="0.0 °C" />
            <LineSeries Items="Extract" Name="Extract" XValue="r => r.Time" YValue="r => r.Value" Format="0.0 °C" />
        </RioChart>
        <p class="note">
            Hidden: @(_hidden.Count == 0 ? "none" : string.Join(", ", _hidden)).
            Clicked: @(_point is null ? "nothing yet" : $"{_point.SeriesName} {_point.Item?.Value:0.0} °C at {_point.Item?.Time:g}")
        </p>
    </ChildContent>
</Example>

<Example Title="Keyboard and screen readers" Code="@KeyboardCode">
    <Description>
        <p>
            Every chart with data is a tab stop. With it focused, <kbd>←</kbd> and <kbd>→</kbd> move between points, <kbd>↑</kbd> and
            <kbd>↓</kbd> between series (on pies, every arrow moves between slices), <kbd>Home</kbd>, <kbd>End</kbd>, <kbd>Page Up</kbd> and
            <kbd>Page Down</kbd> jump. The crosshair and tooltip follow, linked charts follow too, and screen readers hear each point
            (for example "Tue 01:00: Supply 20.1 °C, Extract 22.3 °C. 5 of 96"). <kbd>Enter</kbd> raises <code>OnPointClick</code> and
            <kbd>Esc</kbd> leaves. On <code>Zoomable</code> charts, <kbd>+</kbd> and <kbd>−</kbd> zoom around the focused point,
            <kbd>Shift</kbd>+<kbd>←</kbd>/<kbd>→</kbd> pans and <kbd>0</kbd> shows all data (try it on the zoom example below).
            It all runs in the browser; only finished zooms and Enter call .NET.
        </p>
        <p>Click the chart below or Tab to it, then use the arrow keys. <code>KeyboardNavigation="false"</code> turns it off.</p>
    </Description>
    <ChildContent>
        <RioChart TItem="Reading" Height="240" YAxis="Celsius" OnPointClick="e => _keyPoint = e">
            <LineSeries Items="Supply" Name="Supply" XValue="r => r.Time" YValue="r => r.Value" Format="0.0 °C" />
            <LineSeries Items="Extract" Name="Extract" XValue="r => r.Time" YValue="r => r.Value" Format="0.0 °C" />
        </RioChart>
        <p class="note">Selected with Enter: @(_keyPoint is null ? "nothing yet" : $"{_keyPoint.SeriesName} {_keyPoint.Item?.Value:0.0} °C at {_keyPoint.Item?.Time:g}")</p>
    </ChildContent>
</Example>

<Example Title="Custom tooltip text" Code="@FormatCode">
    <Description>
        <p>
            <code>TooltipValue</code> on a series and <code>TooltipHeader</code> on the chart replace the text of the value and the header.
            They get the hovered point (<code>X</code>, <code>Y</code>, <code>Item</code>, <code>Items</code>, the default text) and run once per
            layout, not on pointer moves, so the tooltip stays fully in the browser. Return null to keep the default.
        </p>
    </Description>
    <ChildContent>
        <RioChart TItem="Reading" YAxis="Celsius" TooltipHeader="@(p => p.X is DateTime t ? t.ToString("dddd HH:mm") : null)">
            <LineSeries Items="Supply" Name="Supply" XValue="r => r.Time" YValue="r => r.Value"
                        TooltipValue="@(p => $"{p.Y:0.0} °C ({Extract[p.Index].Value - p.Y:0.0} °C below extract)")" />
            <LineSeries Items="Extract" Name="Extract" XValue="r => r.Time" YValue="r => r.Value" Format="0.0 °C" />
        </RioChart>
    </ChildContent>
</Example>

<Example Title="Tooltip template" Code="@TemplateCode">
    <Description>
        <p>
            <code>TooltipTemplate</code> renders any Razor inside the tooltip card. Its <code>context</code> has the <code>Header</code>, the
            <code>X</code> value and the hovered <code>Points</code>, each with its items. The built-in classes (<code>rio-tooltip-head</code>,
            <code>-row</code>, <code>-dot</code>, <code>-name</code>, <code>-value</code>) keep the default look.
        </p>
        <p>
            The crosshair still follows the pointer in the browser, but the content is rendered by .NET when the hovered x changes: on Blazor
            Server it lags one round trip behind. Prefer <code>TooltipValue</code> and <code>TooltipHeader</code> when text is enough.
        </p>
    </Description>
    <ChildContent>
        <RioChart TItem="Alarm" Items="Alarms" Height="240" YAxis="Minutes">
            <ChildContent>
                <BarSeries Name="Alarm time" XValue="a => a.Unit" YValue="a => a.Minutes" Aggregate="Aggregate.Sum" />
            </ChildContent>
            <TooltipTemplate>
                <div class="rio-tooltip-head">@context.Header: @context.Points[0].Items.Count alarms</div>
                @foreach (var alarm in context.Points[0].Items)
                {
                    <div class="rio-tooltip-row">
                        <span class="rio-tooltip-name">@alarm.Text</span>
                        <span class="rio-tooltip-value">@alarm.Minutes min</span>
                    </div>
                }
            </TooltipTemplate>
        </RioChart>
    </ChildContent>
</Example>

<Example Title="Zoom, pan and linked charts" Code="@ZoomCode">
    <Description>
        <p>
            Drag to zoom, Shift+drag to pan, Ctrl/⌘+wheel to zoom at the pointer, double-click to reset. The y axis fits the visible data.
            Charts in the same <code>Group</code> share the crosshair and the zoom.
        </p>
    </Description>
    <ChildContent>
        <RioChart TItem="Reading" Height="200" YAxis="Celsius" Zoomable="true" Group="ahu" @bind-VisibleRange="_range">
            <LineSeries Items="Supply" Name="Supply" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" />
            <LineSeries Items="Extract" Name="Extract" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" />
        </RioChart>
        <RioChart TItem="Reading" Height="150" YAxis="Kwh" Zoomable="true" Group="ahu">
            <AreaSeries Items="Heating" Name="Heating" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" />
        </RioChart>
        <p class="note">
            Visible: @(_range is null ? "all" : $"{_range.Min:g} – {_range.Max:g}")
            <button class="small" @onclick="() => _range = ChartRange.Of(Start.AddHours(30), Start.AddHours(42))">Zoom to 17 Nov 06–18</button>
        </p>
    </ChildContent>
</Example>

<h2>From code</h2>
<p>Everything the user can do has an API: take a reference with <code>@@ref</code> and call
    <code>ZoomToAsync</code>, <code>PanAsync</code>, <code>ResetZoomAsync</code>, <code>GetVisibleRange</code> or <code>Refresh</code>.
    <code>OnZoomChanging</code> can clamp or cancel a zoom. <code>Layout</code> exposes the scales and the hit-test index.</p>

@code {
    private static readonly AxisSpec Celsius = new() { Title = "°C" };
    private static readonly AxisSpec Kwh = new() { Title = "kWh" };
    private static readonly AxisSpec Minutes = new() { Title = "min" };
    private IReadOnlyCollection<string> _hidden = [];
    private PointClickEventArgs<Reading>? _point;
    private ChartRange? _range;

    private const string ClickCode = """
        <RioChart TItem="Reading" @bind-HiddenSeries="hidden" OnPointClick="e => clicked = e">
            <LineSeries Items="supply" Name="Supply" XValue="r => r.Time" YValue="r => r.Value" Format="0.0 °C" />
            <LineSeries Items="extract" Name="Extract" XValue="r => r.Time" YValue="r => r.Value" Format="0.0 °C" />
        </RioChart>
        """;

    private PointClickEventArgs<Reading>? _keyPoint;

    private const string KeyboardCode = """
        <RioChart TItem="Reading" OnPointClick="e => selected = e">
            <LineSeries Items="supply" Name="Supply" XValue="r => r.Time" YValue="r => r.Value" Format="0.0 °C" />
            <LineSeries Items="extract" Name="Extract" XValue="r => r.Time" YValue="r => r.Value" Format="0.0 °C" />
        </RioChart>
        """;

    private const string FormatCode = """
        <RioChart TItem="Reading" TooltipHeader="@(p => p.X is DateTime t ? t.ToString("dddd HH:mm") : null)">
            <LineSeries Items="supply" Name="Supply" XValue="r => r.Time" YValue="r => r.Value"
                        TooltipValue="@(p => $"{p.Y:0.0} °C ({extract[p.Index].Value - p.Y:0.0} °C below extract)")" />
            <LineSeries Items="extract" Name="Extract" XValue="r => r.Time" YValue="r => r.Value" Format="0.0 °C" />
        </RioChart>
        """;

    private const string TemplateCode = """
        <RioChart TItem="Alarm" Items="alarms">
            <ChildContent>
                <BarSeries Name="Alarm time" XValue="a => a.Unit" YValue="a => a.Minutes" Aggregate="Aggregate.Sum" />
            </ChildContent>
            <TooltipTemplate>
                <div class="rio-tooltip-head">@context.Header: @context.Points[0].Items.Count alarms</div>
                @foreach (var alarm in context.Points[0].Items)
                {
                    <div class="rio-tooltip-row">
                        <span class="rio-tooltip-name">@alarm.Text</span>
                        <span class="rio-tooltip-value">@alarm.Minutes min</span>
                    </div>
                }
            </TooltipTemplate>
        </RioChart>
        """;

    private const string ZoomCode = """
        <RioChart TItem="Reading" Zoomable="true" Group="ahu" @bind-VisibleRange="range">
            <LineSeries Items="supply" ... />
        </RioChart>
        <RioChart TItem="Reading" Zoomable="true" Group="ahu">
            <AreaSeries Items="heating" ... />
        </RioChart>

        <button @onclick="() => range = ChartRange.Of(from, to)">Zoom</button>
        """;
}
