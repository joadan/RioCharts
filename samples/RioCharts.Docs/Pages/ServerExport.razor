@page "/server-export"

<PageTitle>Server-side export · RioCharts for Blazor and .NET</PageTitle>

<h1>Server-side export</h1>
<p class="lead">
    Render charts to PNG or SVG on the server in .NET. <code>RioCharts.Skia</code> draws the same chart model and layout as the Blazor
    components, with real font metrics. Use it for emails, reports, Teams or Slack messages, and AI agents.
</p>

<CodeBlock Language="shell" Code="dotnet add package RioCharts.Skia --prerelease" />
<p>On Linux it uses SkiaSharp's native assets without system dependencies; install a font package in slim containers (see <code>FontFamily</code> below).</p>

<CodeBlock Language="csharp" Code="@Code" />

<h2>Options</h2>
<div class="table-scroll">
<table class="docs">
    <tr><th>Option</th><th>Default</th><th>Meaning</th></tr>
    <tr><td><code>Width</code>, <code>Height</code></td><td>800 × 400</td><td>Chart size in pixels.</td></tr>
    <tr><td><code>Scale</code></td><td>2</td><td>Pixel density of the PNG (2 = sharp on high-density screens).</td></tr>
    <tr><td><code>Theme</code></td><td><code>ExportTheme.Light</code></td><td>Or <code>Dark</code>; <code>.With("--rio-series-1", "#0b6e4f")</code> overrides a token.</td></tr>
    <tr><td><code>Background</code></td><td>the surface color</td><td>Null for a transparent PNG.</td></tr>
    <tr><td><code>FontFamily</code></td><td>Segoe UI, Inter, Roboto, ...</td><td>The first installed font is used. In Linux containers install fonts (e.g. <code>fonts-dejavu</code>).</td></tr>
    <tr><td><code>CssVariables</code></td><td>false</td><td>SVG only: write colors as <code>var(--rio-…, color)</code> so a page can restyle it.</td></tr>
</table>
</div>

<div class="callout">
    Charts made with components export in the browser with <code>chart.ExportPngAsync()</code> and <code>chart.ExportSvgAsync()</code>; or serialize <code>chart.GetDefinition()</code> and render it here later.
</div>

@code {
    private const string Code = """
        var spec = new ChartDefinition
        {
            Title = "Orders per day",
            Y = new AxisOptions { Title = "Orders" },
            Series = [new SeriesOptions { Id = "orders", Name = "Orders", Curve = CurveType.Monotone }],
            Annotations = [new Annotation { Value = 250, Label = "Target" }],
        };
        var data = new Dictionary<string, SeriesData> { ["orders"] = SeriesData.From(days, orders) };

        byte[] png = ChartExport.ToPng(spec, data, new ExportOptions { Width = 640, Height = 320, Theme = ExportTheme.Dark });
        string svg = ChartExport.ToSvg(spec, data);

        // In a minimal API:
        app.MapGet("/charts/orders.png", () => Results.File(ChartExport.ToPng(spec, data), "image/png"));
        """;
}
