@page "/export"

<PageTitle>Export and download · RioCharts</PageTitle>

<h1>Export and download</h1>
<p class="lead">
    Save a chart as PNG or SVG, or its data as CSV, straight from the browser. Images show the chart as it is drawn: the current size, zoom,
    hidden series and the page's theme colors. No server-side rendering or extra package is needed.
</p>

<Example Title="Download menu" Code="@MenuCode">
    <Description>
        <p>
            <code>Exportable</code> adds a download button in the top-right corner. It shows while the pointer is over the chart (always on touch screens)
            and opens a menu with <b>PNG</b>, <b>SVG</b> and <b>CSV</b>. Files are named after the title unless you set <code>ExportFileName</code>.
        </p>
    </Description>
    <ChildContent>
        <RioChart TItem="Reading" Title="Sessions, web and app" YAxis="Sessions" Exportable="true">
            <LineSeries Items="WebSessions" Name="Web" XValue="r => r.Time" YValue="r => r.Value" Format="#,0" Curve="CurveType.Monotone" />
            <LineSeries Items="AppSessions" Name="App" XValue="r => r.Time" YValue="r => r.Value" Format="#,0" Curve="CurveType.Monotone" />
        </RioChart>
    </ChildContent>
</Example>

<Example Title="Export from code" Code="@CodeCode">
    <Description>
        <p>
            The same exports are methods on the chart reference. <code>Download…Async</code> saves a file in the browser.
            <code>ExportPngAsync</code> and <code>ExportSvgAsync</code> return the image to .NET (for uploads, emails or reports), and
            <code>ExportCsv</code> returns the data of every series as text: an x column and one column per series, numbers in invariant culture,
            times in ISO 8601.
        </p>
    </Description>
    <ChildContent>
        <RioChart @ref="_chart" TItem="Reading" Height="240" YAxis="Orders">
            <BarSeries Items="DailyOrders" Name="Orders" XValue="r => r.Time" YValue="r => r.Value" Format="#,0" />
        </RioChart>
        <p class="note">
            <button class="small" @onclick="() => _chart!.DownloadPngAsync(options: new ChartImageOptions { Scale = 3 })">Download PNG (3×)</button>
            <button class="small" @onclick="() => _chart!.DownloadSvgAsync()">Download SVG</button>
            <button class="small" @onclick="() => _chart!.DownloadCsvAsync(options: new CsvOptions { Delimiter = ';' })">Download CSV (;)</button>
            <button class="small" @onclick="SizeOfPng">Measure PNG</button>
        </p>
        @if (_pngInfo is not null)
        {
            <p class="note">@_pngInfo</p>
        }
    </ChildContent>
</Example>

<Example Title="Choose formats and handle the export" Code="@HandlerCode">
    <Description>
        <p>
            <code>ExportFormats</code> picks the menu items; with a single format the button saves it directly. <code>OnExporting</code> runs when
            the user picks one, before the file is saved: change <code>FileName</code>, <code>ImageOptions</code> or <code>CsvOptions</code>, or set
            <code>Cancel</code> and do something else with the content, such as uploading it. <code>GetPngAsync</code>, <code>GetSvgAsync</code> and
            <code>GetCsv</code> make the content only when called, so a handler that just renames the file sends nothing to .NET.
        </p>
        <p>Here PNG is saved with the date in its name at 3×, and CSV is shown below instead of downloaded.</p>
    </Description>
    <ChildContent>
        <RioChart TItem="Reading" Height="240" YAxis="Percent" Exportable="true" ExportFormats="ExportFormats.Png | ExportFormats.Csv" OnExporting="HandleExport">
            <LineSeries Items="Conversion" Name="Conversion" XValue="r => r.Time" YValue="r => r.Value" Format="0.00 '%'" />
        </RioChart>
        @if (_handled is not null)
        {
            <pre class="note">@_handled</pre>
        }
    </ChildContent>
</Example>

<h2>Options</h2>
<div class="table-scroll">
<table class="docs">
    <tr><th>Option</th><th>Default</th><th>Meaning</th></tr>
    <tr><td><code>ChartImageOptions.Scale</code></td><td>2</td><td>PNG pixels per CSS pixel.</td></tr>
    <tr><td><code>ChartImageOptions.Background</code></td><td>the surface color</td><td>Any CSS color; <code>"transparent"</code> for none.</td></tr>
    <tr><td><code>ExportFormats</code></td><td><code>All</code></td><td>Formats in the menu (<code>Png</code>, <code>Svg</code>, <code>Csv</code>); one format saves directly.</td></tr>
    <tr><td><code>OnExporting</code></td><td></td><td>Raised on a menu pick before the file is saved; not raised for calls from code.</td></tr>
    <tr><td><code>CsvOptions.Delimiter</code></td><td><code>,</code></td><td>Column separator, e.g. <code>;</code> for spreadsheets with a decimal comma.</td></tr>
    <tr><td><code>CsvOptions.Culture</code></td><td>invariant</td><td>Culture for numbers.</td></tr>
    <tr><td><code>CsvOptions.XHeader</code></td><td>the x axis title, else <code>x</code></td><td>Header of the x column.</td></tr>
</table>
</div>

<div class="callout">
    Images use the fonts installed on the viewer's machine: a web font the page loads is not available inside the image, so text falls back to
    the next font in the list. For images made without a browser (emails, scheduled reports), use <a href="server-export">server-side export</a>.
</div>

@code {
    private static readonly AxisOptions Sessions = new() { Title = "Sessions" };
    private static readonly AxisOptions Orders = new() { Title = "Orders" };
    private static readonly AxisOptions Percent = new() { Title = "%" };
    private RioChart<Reading>? _chart;
    private string? _pngInfo;

    private string? _handled;

    private void HandleExport(ChartExportingEventArgs e)
    {
        e.FileName = $"conversion-{DateTime.Today:yyyy-MM-dd}.{e.Format.ToString().ToLowerInvariant()}";
        if (e.Format == ExportFormat.Png)
        {
            e.ImageOptions = new ChartImageOptions { Scale = 3 };
        }
        else if (e.Format == ExportFormat.Csv)
        {
            e.Cancel = true; // no download: use the data here instead
            var lines = e.GetCsv().Split("\r\n");
            _handled = $"{e.FileName}, {lines.Length - 2} rows:\n{string.Join("\n", lines.Take(4))}\n...";
        }
    }

    private async Task SizeOfPng()
    {
        var png = await _chart!.ExportPngAsync();
        _pngInfo = $"ExportPngAsync returned {png.Length / 1024.0:0.0} KB.";
    }

    private const string MenuCode = """
        <RioChart TItem="Reading" Title="Sessions, web and app" Exportable="true">
            <LineSeries Items="web" Name="Web" XValue="r => r.Time" YValue="r => r.Value" Format="#,0" />
            <LineSeries Items="app" Name="App" XValue="r => r.Time" YValue="r => r.Value" Format="#,0" />
        </RioChart>
        """;

    private const string HandlerCode = """
        <RioChart TItem="Reading" Exportable="true" ExportFormats="ExportFormats.Png | ExportFormats.Csv" OnExporting="HandleExport">
            <LineSeries Items="conversion" Name="Conversion" XValue="r => r.Time" YValue="r => r.Value" Format="0.00 '%'" />
        </RioChart>

        @code {
            async Task HandleExport(ChartExportingEventArgs e)
            {
                e.FileName = $"conversion-{DateTime.Today:yyyy-MM-dd}.{e.Format.ToString().ToLowerInvariant()}";
                if (e.Format == ExportFormat.Png)
                {
                    e.ImageOptions = new ChartImageOptions { Scale = 3 };
                }
                else if (e.Format == ExportFormat.Csv)
                {
                    e.Cancel = true; // no download
                    await storage.UploadAsync(e.FileName, e.GetCsv());
                }
            }
        }
        """;

    private const string CodeCode = """
        <RioChart @ref="chart" TItem="Reading">
            <BarSeries Items="dailyOrders" Name="Orders" XValue="r => r.Time" YValue="r => r.Value" Format="#,0" />
        </RioChart>

        <button @onclick="() => chart.DownloadPngAsync(options: new ChartImageOptions { Scale = 3 })">Download PNG (3×)</button>
        <button @onclick="() => chart.DownloadSvgAsync()">Download SVG</button>
        <button @onclick="() => chart.DownloadCsvAsync(options: new CsvOptions { Delimiter = ';' })">Download CSV (;)</button>

        @code {
            RioChart<Reading> chart = null!;

            async Task Upload()
            {
                byte[] png = await chart.ExportPngAsync();
                string svg = await chart.ExportSvgAsync(new ChartImageOptions { Background = "transparent" });
                string csv = chart.ExportCsv();
            }
        }
        """;
}
