@page "/maps"

<PageTitle>World maps · RioCharts</PageTitle>

<h1>World maps</h1>
<p class="lead">
    A world map shows where something happens: countries colored by a value, bubbles at places within them, and a click on a country
    zooms into it. The map uses the Equal Earth projection, so countries keep their true relative size.
</p>

<Example Title="Countries and cities" Code="@SessionsCode">
    <Description>
        <p>
            <code>MapSeries</code> colors each country by <code>YValue</code>; <code>XValue</code> is the country as an ISO 3166 code
            (<code>"SE"</code> or <code>"SWE"</code>) or its English name. The color gets stronger with the value's rank among the
            countries, so a few large values do not wash out the rest; set <code>Max</code> for a linear scale instead. <code>MapBubbleSeries</code> puts a bubble at each item's <code>Latitude</code> and
            <code>Longitude</code>, its area proportional to <code>YValue</code>. On the world map the places in a country add up to one
            bubble, so cities close together do not pile up; zoomed into a country, each place has its own (<code>GroupByCountry="false"</code>
            keeps them apart everywhere).
        </p>
        <p>
            A click zooms in one level: from the world to the country's continent, from the continent to the country. The path bar
            above (World › Europe › Sweden) leads back up. Bind <code>TreemapPath</code> to
            know, or set, the area shown, a continent such as <code>"Europe"</code> or a country code: here it is <strong>@(_region ?? "none, the whole world")</strong>.
        </p>
    </Description>
    <ChildContent>
        <RioChart TItem="Place" Title="Active sessions" Height="420" @bind-TreemapPath="_region">
            <MapSeries Items="Countries" Name="Sessions" XValue="c => c.Name" YValue="c => c.Sessions" />
            <MapBubbleSeries Items="Cities" Name="Cities" XValue="c => c.Name" YValue="c => c.Sessions"
                             Latitude="c => c.Latitude" Longitude="c => c.Longitude" />
        </RioChart>
    </ChildContent>
</Example>

<Example Title="Bubbles only" Code="@BubblesCode">
    <Description>
        <p>
            Without a <code>MapSeries</code>, the countries are a gray backdrop for the bubbles. <code>MarkerSize</code> sets the diameter
            of the largest bubble.
        </p>
    </Description>
    <ChildContent>
        <RioChart TItem="Place" Height="300" Legend="NoLegend">
            <MapBubbleSeries Items="Cities" Name="Sessions" XValue="c => c.Name" YValue="c => c.Sessions"
                             Latitude="c => c.Latitude" Longitude="c => c.Longitude" MarkerSize="36" />
        </RioChart>
    </ChildContent>
</Example>

<h2>Data</h2>
<p>
    The country outlines are Natural Earth's 1:110 million Admin 0 countries (public domain), built into <code>RioCharts.Core</code>.
    Very small countries, such as Singapore and Malta, are not in it at this scale. <code>WorldMap.Find</code> looks a country up by code
    or name.
</p>

@code {
    private string? _region;

    private static readonly LegendOptions NoLegend = new() { Mode = LegendMode.Hide };

    private sealed record Place(string Name, double Sessions, double? Latitude = null, double? Longitude = null);

    private static readonly Place[] Countries =
    [
        new("SE", 1240), new("NO", 310), new("DK", 280), new("FI", 260), new("DE", 420), new("GB", 190), new("FR", 140), new("PL", 120),
        new("NL", 95), new("ES", 60), new("IT", 55), new("EE", 22), new("LT", 19), new("LV", 17), new("US", 210), new("CA", 40),
        new("CN", 75), new("IN", 30), new("JP", 18), new("AU", 25), new("BR", 12), new("ZA", 8),
    ];

    private static readonly Place[] Cities =
    [
        new("Stockholm", 420, 59.33, 18.07), new("Gothenburg", 380, 57.71, 11.97), new("Malmö", 120, 55.60, 13.00), new("Umeå", 40, 63.83, 20.26),
        new("Luleå", 28, 65.58, 22.15), new("Oslo", 210, 59.91, 10.75), new("Copenhagen", 190, 55.68, 12.57), new("Helsinki", 170, 60.17, 24.94),
        new("Berlin", 150, 52.52, 13.40), new("Hamburg", 90, 53.55, 9.99), new("London", 160, 51.51, -0.13), new("Paris", 110, 48.86, 2.35),
        new("Warsaw", 90, 52.23, 21.01), new("New York", 120, 40.71, -74.01), new("Chicago", 50, 41.88, -87.63), new("Shanghai", 60, 31.23, 121.47),
        new("Sydney", 25, -33.87, 151.21),
    ];

    private const string SessionsCode = """
        <RioChart TItem="Place" Title="Active sessions" @bind-TreemapPath="region">
            <MapSeries Items="countries" Name="Sessions" XValue="c => c.Name" YValue="c => c.Sessions" />
            <MapBubbleSeries Items="cities" Name="Cities" XValue="c => c.Name" YValue="c => c.Sessions"
                             Latitude="c => c.Latitude" Longitude="c => c.Longitude" />
        </RioChart>

        @code {
            string? region;
            record Place(string Name, double Sessions, double? Latitude = null, double? Longitude = null);
        }
        """;

    private const string BubblesCode = """
        <RioChart TItem="Place">
            <MapBubbleSeries Items="cities" Name="Sessions" XValue="c => c.Name" YValue="c => c.Sessions"
                             Latitude="c => c.Latitude" Longitude="c => c.Longitude" MarkerSize="36" />
        </RioChart>
        """;
}
