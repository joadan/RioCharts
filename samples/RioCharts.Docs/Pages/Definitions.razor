@page "/definitions"
@page "/specs"
@using RioCharts.Core.Definitions
@using RioCharts.Docs.Editor
@using System.Text.Json
@using System.Text.Json.Nodes
@inject IJSRuntime JS

<PageTitle>Chart definitions · RioCharts for Blazor and .NET</PageTitle>

<h1>Chart definitions</h1>
<p class="lead">
    Describe a chart as JSON: a small object that names a dataset and its fields, easy for AI agents to write and easy to save. The same
    definition renders with <code>&lt;RioChart Definition="definition" Datasets="datasets" /&gt;</code>, on the server, or through the
    <a href="ai">create_chart tool</a>. Below, set the options in the panel or edit the JSON, with our data or your own; it is parsed,
    validated and drawn in your browser.
</p>
<p>
    The definition holds no data itself: it refers to a <strong>dataset</strong> by name and to its <strong>fields</strong> (columns) by name.
    Your app passes the datasets in (see <a href="definitions#datasets">where the data comes from</a>), or a small definition carries its own rows in
    <code>"data"</code>. The panel above the editor shows the datasets this page has, and <strong>Your data</strong> adds a CSV or JSON file
    of your own: it is read in your browser and never leaves it.
</p>
<p>
    Building a product where users set up their own charts? See <a href="dashboards">dashboards your users configure</a>.
</p>

<section class="example">
<div class="example-card playground">
    <div class="examples-buttons">
        @foreach (var (name, json) in Examples)
        {
            <button class="small" @onclick="() => Load(json)">@name</button>
        }
    </div>

    @{ var shown = ShownDataset(); }
    <div class="spec-data">
        <div class="spec-data-tabs" role="tablist" aria-label="Datasets">
            <span class="spec-data-label">Data</span>
            @foreach (var ds in Datasets())
            {
                var active = ds.Name == shown.Name;
                <button role="tab" aria-selected="@(active ? "true" : "false")" class="@(active ? "active" : null)" @onclick="() => _picked = ds.Name">
                    <code>@ds.Name</code>@if (ds.Name == UsedDataset()) {<span class="spec-data-used">used by the definition</span>}
                </button>
            }
            <button role="tab" aria-selected="@(_uploading ? "true" : "false")" class="@(_uploading ? "active" : null)" @onclick="ToggleUpload">
                Your data
            </button>
        </div>
        @if (_uploading)
        {
            <div class="spec-upload">
                <p class="spec-data-about">
                    A CSV file with a header row, or a JSON array of objects. It is read here, in your browser, and never sent anywhere
                    (usage statistics stop while you are here, see <a href="privacy">Privacy</a>); the playground then starts a chart from
                    its first fields.
                </p>
                <InputFile accept=".csv,.json,.txt,text/csv,application/json" OnChange="Upload" />
                <details>
                    <summary>Or paste CSV or JSON</summary>
                    <textarea class="spec-paste" spellcheck="false" aria-label="Data to paste (CSV or JSON)" @bind="_pasted"></textarea>
                    <button class="small" @onclick="Paste">Use this data</button>
                </details>
                @if (_uploadError is not null)
                {
                    <p class="spec-messages errors">@_uploadError</p>
                }
            </div>
        }
        <p class="spec-data-about">
            @if (shown.Name == "inline")
            {
                <text>Rows written in the definition itself (<code>"data": [ ... ]</code>), for a few values an agent already has.</text>
            }
            else if (_uploaded.ContainsKey(shown.Name))
            {
                <text>Your data, read in your browser. It stays on this page and is gone when you leave it.</text>
            }
            else
            {
                <text>@shown.Description. Passed in from C# with <code>Datasets="datasets"</code>.</text>
            }
            <span class="spec-data-count">@shown.RowCount rows, @shown.Fields.Count fields</span>
        </p>
        <div class="spec-data-table">
            <table>
                <thead>
                    <tr>
                        @foreach (var field in shown.Fields)
                        {
                            <th><code>@field.Name</code> <span class="spec-data-type">@field.Type.ToString().ToLowerInvariant()</span></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in SampleRows(shown))
                    {
                        <tr>
                            @foreach (var field in shown.Fields)
                            {
                                <td>@Cell(field.Values[row])</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (shown.RowCount > SampleRows(shown).Count)
        {
            <p class="spec-data-more">@SampleRows(shown).Count of @shown.RowCount rows, spread over the dataset.</p>
        }
    </div>

    <div class="playground-grid">
        <div class="playground-options">
            <DefinitionEditor @ref="_editor" Definition="_definition" Datasets="AllDatasets" Changed="FromEditor" />
        </div>
        <div class="playground-output">
            <div class="example-live">
                @if (_spec is not null)
                {
                    <RioChart TItem="object" Definition="_spec" Datasets="AllDatasets" Height="320" Zoomable="true" />
                }
            </div>

            @if (_errors.Count > 0)
            {
                <ul class="spec-messages errors">
                    @foreach (var error in _errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            }

            @if (_warnings.Count > 0)
            {
                <ul class="spec-messages">
                    @foreach (var warning in _warnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            }

            @* A transparent textarea over a highlighted copy of its text. Both wrap the same way and the
               highlighted copy sets the height, so they stay aligned without scroll syncing. *@
            <div class="spec-editor">
                <pre aria-hidden="true"><code>@((MarkupString)_highlighted)</code></pre>
                <textarea spellcheck="false" aria-label="Chart definition (JSON)" @bind="_json" @bind:event="oninput" @bind:after="FromText"></textarea>
            </div>
        </div>
    </div>
</div>
</section>

<h2>What a definition can say</h2>
<table class="docs">
    <tr><th>Series option</th><th>Meaning</th></tr>
    <tr><td><code>type</code></td><td>line, area, bar, scatter, bubble (scatter with a <code>size</code> field), heatmap, rangeArea, boxPlot, candlestick, waterfall, histogram, dumbbell (two values per category: <code>from</code> and <code>y</code>), rangeBar (a timeline: <code>row</code>, <code>start</code> and <code>end</code> fields), pie, radialBar, gauge (one value: <code>y</code> with <code>min</code>, <code>max</code> and <code>target</code>), bullet (a value against a target per row: <code>x</code>, <code>y</code> and <code>targetField</code>), funnel (stages in row order: <code>x</code> and <code>y</code>), radar, treemap, or <code>auto</code> (time → line, categories → bar, shares of 100 % → donut). Synonyms such as column, doughnut, spline and spider are accepted.</td></tr>
    <tr><td><code>error</code>, <code>errorField</code>, <code>errorLow</code>, <code>errorHigh</code></td><td>Error bars on bar, line and scatter series: one plus-or-minus amount for every point, a field with each row's amount, or fields with each error bar's low and high ends.</td></tr>
    <tr><td><code>dataset</code></td><td>Which dataset to read, on the chart or per series; leave it out when the definition has inline <code>data</code> rows.</td></tr>
    <tr><td><code>x</code>, <code>y</code></td><td>Field names in that dataset: x is the time, category or number along the axis, y the value.</td></tr>
    <tr><td><code>low</code>, <code>high</code>, <code>q1</code>, <code>q3</code>, <code>open</code>, <code>total</code>, <code>binWidth</code>, <code>binCount</code>, <code>path</code></td><td>Extra fields some types read: a histogram's bin width or about how many bins; a range area's low values; a box plot's precomputed quartiles and whiskers; a candlestick's open, high and low; a waterfall's total rows; a treemap's group fields (<code>"path": ["region", "country"]</code>).</td></tr>
    <tr><td><code>colorBands</code></td><td>Colors by value: <code>[{ "above": 120, "color": "--rio-negative" }]</code>; a line changes color where it crosses into a band, bars and points take their band's color.</td></tr>
    <tr><td><code>colorField</code></td><td>A field with each row's own color (CSS color or theme token such as <code>"--rio-negative"</code>); empty keeps the series color.</td></tr>
    <tr><td><code>filter</code></td><td><code>[{ "field": "channel", "op": "eq", "value": "App" }]</code>, ops eq, ne, gt, gte, lt, lte, contains.</td></tr>
    <tr><td><code>timeBucket</code>, <code>aggregate</code></td><td>hour, day, week, month, quarter, year; sum, average, min, max, count, last.</td></tr>
    <tr><td><code>groupBy</code></td><td>One series per value of a field.</td></tr>
    <tr><td><code>sort</code>, <code>limit</code></td><td>Rank by y and keep the top N.</td></tr>
</table>
<p>
    Everything else (axes, annotations, legend, time zone...) is the same model as the components. Errors name the path and list what is valid,
    e.g. <code>series[0].y: field 'visits' not found in 'shop'; available: timestamp (time), channel (text), ...</code>, so an agent can fix the definition and try again.
    <code>ChartDefinitionJson.Schema()</code> returns the JSON schema with a description of every option.
</p>

<h2 id="versions">Saved definitions keep working</h2>
<p>
    A definition can say which format it is in: <code>"version": 1</code>. It is optional (missing means 1), and
    <code>ChartDefinitionJson.Serialize</code> writes it. Every RioCharts 1.x reads version 1 definitions: fields, chart type names,
    their synonyms and option words may be added, but none is removed or changes meaning, so a definition you save today renders in
    every later 1.x. A definition from a newer version is still read, with a warning, and fields this version does not know are left out.
</p>

<h2 id="datasets">Where the data comes from</h2>
<p>
    A dataset is a named table: one value per row for each field. Field types (time, number, text) are read from the values, and an
    optional description tells an agent what the data means. Build them from your own rows, from CSV, or let an
    <code>IChartDataSource</code> load them when a definition asks (e.g. <code>FolderDataSource</code> for a folder of CSV and JSON files).
</p>
<CodeBlock Language="csharp" Code="@DatasetsCode" />
<CodeBlock Language="razor" Code="@ChartCode" />

<h3>The definition as read</h3>
@if (_normalized is not null)
{
    <CodeBlock Language="json" Code="@_normalized" />
}

@code {
    private static readonly (string Name, string Json)[] Examples =
    [
        ("Minimal", """
            {
              "dataset": "sales",
              "series": [{ "type": "line", "x": "month", "y": "revenue", "aggregate": "sum" }]
            }
            """),
        ("One line per channel", """
            {
              "dataset": "shop",
              "title": "Orders per channel",
              "y": { "title": "Orders per hour" },
              "series": [{ "type": "spline", "x": "timestamp", "y": "orders", "groupBy": "channel" }],
              "annotations": [{ "value": 20, "label": "Goal: 20 an hour" }]
            }
            """),
        ("Revenue per day", """
            {
              "dataset": "shop",
              "title": "Revenue per day",
              "y": { "title": "€" },
              "series": [{ "type": "column", "x": "timestamp", "y": "revenue", "timeBucket": "daily", "format": "#,0 €",
                           "aggregate": "sum", "groupBy": "channel", "stack": "channels" }]
            }
            """),
        ("Top categories (auto)", """
            {
              "dataset": "sales",
              "title": "Revenue per category, 2026 (k€)",
              "series": [{ "type": "auto", "x": "category", "y": "revenue", "aggregate": "sum", "sort": "desc" }]
            }
            """),
        ("Shares (auto donut)", """
            {
              "data": [ { "source": "Search", "share": 48 }, { "source": "Social", "share": 27 },
                        { "source": "Email", "share": 15 }, { "source": "Direct", "share": 10 } ],
              "series": [{ "type": "auto", "x": "source", "y": "share" }]
            }
            """),
        ("Two axes", """
            {
              "dataset": "shop",
              "y": { "title": "Sessions" },
              "yAxes": [{ "id": "eur", "title": "€" }],
              "series": [
                { "type": "bar", "x": "timestamp", "y": "revenue", "timeBucket": "day", "aggregate": "sum", "yAxisId": "eur", "name": "Revenue" },
                { "type": "line", "x": "timestamp", "y": "sessions", "timeBucket": "day", "aggregate": "sum", "name": "Sessions" }
              ]
            }
            """),
        ("With errors", """
            {
              "dataset": "shop",
              "series": [{ "type": "line", "x": "time", "y": "visits" }]
            }
            """),
    ];

    private const string DatasetsCode = """
        // One dictionary per row: field name -> value.
        var rows = traffic.Select(t => new Dictionary<string, object?>
        {
            ["timestamp"] = t.Hour,
            ["channel"] = t.Channel,
            ["orders"] = t.Orders,
        });

        var datasets = new Dictionary<string, ChartDataset>
        {
            ["shop"] = ChartDataset.FromRows("shop", rows,
                "Online store traffic per sales channel, hourly"),
            ["sales"] = ChartDataset.FromCsv("sales", File.ReadAllText("sales.csv"),
                "Revenue per category and month, k€"),
        };
        """;

    private const string ChartCode = """
        <RioChart Definition="definition" Datasets="datasets" />
        """;

    private string? _picked;

    /// <summary>The playground's datasets, plus the definition's inline rows when it has some.</summary>
    private IEnumerable<ChartDataset> Datasets()
    {
        foreach (var ds in AllDatasets.Values)
        {
            yield return ds;
        }

        if (_spec?.Data is { Count: > 0 } rows)
        {
            yield return ChartDataset.FromRows("inline", rows);
        }
    }

    /// <summary>The dataset the definition reads (its own, its first series', or its inline rows).</summary>
    private string? UsedDataset() =>
        _spec?.Data is { Count: > 0 } ? "inline" : _spec?.Dataset ?? _spec?.Series.Select(s => s.Dataset).FirstOrDefault(d => d is not null);

    private ChartDataset ShownDataset()
    {
        var all = Datasets().ToList();
        return all.FirstOrDefault(d => string.Equals(d.Name, _picked, StringComparison.OrdinalIgnoreCase))
            ?? all.FirstOrDefault(d => string.Equals(d.Name, UsedDataset(), StringComparison.OrdinalIgnoreCase))
            ?? all[0];
    }

    /// <summary>Up to five rows spread over the dataset (the playground's are sorted by channel or month).</summary>
    private static List<int> SampleRows(ChartDataset ds) =>
        ds.RowCount <= 5 ? [.. Enumerable.Range(0, ds.RowCount)] : [.. Enumerable.Range(0, 5).Select(i => i * ds.RowCount / 5)];

    private static string Cell(object? value) => value switch
    {
        null => "",
        DateTime t => t.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture),
        DateTimeOffset t => t.ToString("yyyy-MM-dd HH:mm zzz", System.Globalization.CultureInfo.InvariantCulture),
        double d => d.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture),
        _ => Convert.ToString(value, System.Globalization.CultureInfo.InvariantCulture) ?? "",
    };

    private string _json = "";
    private string _highlighted = "";
    private ChartDefinition? _spec;
    private string? _normalized;
    private List<string> _errors = [];
    private List<string> _warnings = [];

    protected override void OnInitialized() => Load(Examples[1].Json);

    private void Load(string json)
    {
        _picked = null; // show the dataset the new example uses
        _json = json;
        _editor?.Reset();
        FromText();
    }

    private DefinitionEditor? _editor;

    /// <summary>The definition as JSON for the property panel; null while the text is not valid JSON.</summary>
    private JsonObject? _definition;

    /// <summary>The JSON text was edited: the panel shows what it now says.</summary>
    private void FromText()
    {
        _definition = DefinitionProperties.Read(_json);
        Render();
    }

    /// <summary>An option was set in the panel: the JSON text is written from it.</summary>
    private void FromEditor()
    {
        DefinitionProperties.Prune(_definition!);
        _json = DefinitionProperties.Write(_definition!);
        Render();
    }

    // ----- Your own data: read in the browser, kept only on this page -----

    private const long MaxUploadBytes = 10 * 1024 * 1024;
    private readonly Dictionary<string, ChartDataset> _uploaded = new(StringComparer.OrdinalIgnoreCase);
    private bool _uploading;
    private string? _pasted;
    private string? _uploadError;

    private IReadOnlyDictionary<string, ChartDataset> AllDatasets =>
        _uploaded.Count == 0
            ? DefinitionDatasets.ByName
            : DefinitionDatasets.ByName.Values.Concat(_uploaded.Values).ToDictionary(d => d.Name, StringComparer.OrdinalIgnoreCase);

    private async Task ToggleUpload()
    {
        _uploading = !_uploading;
        if (_uploading)
        {
            await JS.InvokeVoidAsync("rioDocs.stopClarity");
        }
    }

    private async Task Upload(InputFileChangeEventArgs e)
    {
        _uploadError = null;
        if (e.File.Size > MaxUploadBytes)
        {
            _uploadError = $"{e.File.Name} is {e.File.Size / 1024 / 1024} MB; the playground takes files up to 10 MB.";
            return;
        }

        using var reader = new StreamReader(e.File.OpenReadStream(MaxUploadBytes));
        var title = Path.GetFileNameWithoutExtension(e.File.Name);
        UseData(title, await reader.ReadToEndAsync(), e.File.Name, title);
    }

    private void Paste()
    {
        _uploadError = null;
        if (string.IsNullOrWhiteSpace(_pasted))
        {
            _uploadError = "Paste CSV with a header row, or a JSON array of objects, first.";
            return;
        }

        UseData("pasted", _pasted, "Pasted data", title: null);
    }

    /// <summary>Reads CSV or JSON into a dataset and starts a chart from it.</summary>
    private void UseData(string fileName, string text, string description, string? title)
    {
        var name = DatasetName(fileName);
        ChartDataset dataset;
        try
        {
            var trimmed = text.TrimStart();
            if (trimmed.StartsWith('[') || trimmed.StartsWith('{'))
            {
                using var doc = JsonDocument.Parse(text, new JsonDocumentOptions { AllowTrailingCommas = true, CommentHandling = JsonCommentHandling.Skip });
                // A JSON object with an array in it (e.g. { "rows": [...] }) reads the first array.
                var rows = doc.RootElement.ValueKind == JsonValueKind.Object
                    ? doc.RootElement.EnumerateObject().Select(p => p.Value).FirstOrDefault(v => v.ValueKind == JsonValueKind.Array)
                    : doc.RootElement;
                if (rows.ValueKind != JsonValueKind.Array)
                {
                    _uploadError = "The JSON has no array of rows; use [ { \"field\": value, ... }, ... ].";
                    return;
                }

                dataset = ChartDataset.FromJson(name, rows, description);
            }
            else
            {
                dataset = ChartDataset.FromCsv(name, text, description);
            }
        }
        catch (Exception ex) when (ex is JsonException or FormatException or ArgumentException or InvalidOperationException)
        {
            _uploadError = $"Could not read the data: {ex.Message}";
            return;
        }

        if (dataset.RowCount == 0 || dataset.Fields.Count == 0)
        {
            _uploadError = "No rows found. A CSV file needs a header row and at least one row of values.";
            return;
        }

        _uploaded[name] = dataset;
        _uploading = false;
        _pasted = null;
        _picked = name;
        _definition = DefinitionProperties.Starter(dataset);
        if (title is not null)
        {
            _definition["title"] = title;
        }
        _editor?.Reset();
        FromEditor();
    }

    /// <summary>A dataset name from a file name: lower case letters, digits and dashes, never one of the page's own.</summary>
    private static string DatasetName(string fileName)
    {
        var name = new string([.. fileName.ToLowerInvariant().Select(c => char.IsAsciiLetterOrDigit(c) ? c : '-')]).Trim('-');
        if (name.Length == 0)
        {
            name = "data";
        }

        return DefinitionDatasets.ByName.ContainsKey(name) ? "my-" + name : name;
    }

    private void Render()
    {
        // The trailing space keeps a final empty line as tall as the textarea's.
        _highlighted = CodeHighlighter.ToHtml(_json, "json") + " ";
        var parsed = ChartDefinitionJson.Parse(_json);
        _errors = parsed.Errors.Select(e => e.ToString()).ToList();
        _warnings = [.. parsed.Warnings];
        _spec = parsed.Definition;
        _normalized = _spec is null ? null : ChartDefinitionJson.Serialize(_spec);
        if (_spec is not null)
        {
            var bound = ChartDefinitionBinder.Bind(_spec, AllDatasets);
            _errors.AddRange(bound.Errors.Select(e => e.ToString()));
            _warnings.AddRange(bound.Warnings);
        }
    }
}
