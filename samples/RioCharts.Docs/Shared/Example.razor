@* A live example: a title, a short explanation, the chart itself, and the code that makes it. *@
@inject NavigationManager Nav
<section class="example" id="@Anchor">
    @if (Title is not null)
    {
        <h2><a href="@Href" class="anchor">@Title<span class="anchor-mark" aria-hidden="true">#</span></a></h2>
    }

    @if (Description is not null)
    {
        <div class="example-text">@Description</div>
    }

    <div class="example-card">
        <div class="example-live">@ChildContent</div>

        @if (Code is not null)
        {
            <details class="example-code" open="@CodeOpen">
                <summary>
                    <svg class="chevron" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    Code
                </summary>
                <CodeBlock Code="@Code" Language="@Language" />
            </details>
        }
    </div>
</section>

@code {
    [Parameter] public string? Title { get; set; }

    [Parameter] public RenderFragment? Description { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public string? Code { get; set; }

    [Parameter] public string Language { get; set; } = "razor";

    [Parameter] public bool CodeOpen { get; set; } = true;

    // The page's own path plus the fragment: a bare "#curves" resolves against <base href>,
    // i.e. the start page.
    private string Href => Nav.ToBaseRelativePath(Nav.Uri).Split('#')[0].Split('?')[0] + "#" + Anchor;

    private string Anchor => Title is null ? "" : new string(Title.ToLowerInvariant().Select(c => char.IsLetterOrDigit(c) ? c : '-').ToArray()).Trim('-');
}
