@* A highlighted code block with a language label and a copy button. *@
@inject IJSRuntime JS

<div class="code-block @Class">
    <div class="code-bar">
        <span class="code-lang">@Label</span>
        <button class="code-copy" @onclick="Copy" aria-label="Copy code">
            @if (_copied)
            {
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span>Copied</span>
            }
            else
            {
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><rect x="5" y="5" width="8.5" height="8.5" rx="1.8" fill="none" stroke="currentColor" stroke-width="1.4" /><path d="M10.5 3.2V3a1.5 1.5 0 0 0-1.5-1.5H3.5A1.5 1.5 0 0 0 2 3v5.5A1.5 1.5 0 0 0 3.5 10h.3" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
                <span>Copy</span>
            }
        </button>
    </div>
    <pre><code>@((MarkupString)_html)</code></pre>
</div>

@code {
    [Parameter, EditorRequired] public string Code { get; set; } = "";

    /// <summary>razor, csharp, json, shell or markdown (no highlighting).</summary>
    [Parameter] public string Language { get; set; } = "razor";

    [Parameter] public string? Class { get; set; }

    private string _html = "";
    private string? _source;
    private bool _copied;

    private string Label => Language switch
    {
        "csharp" => "C#",
        "json" => "JSON",
        "shell" => "Terminal",
        "markdown" => "Markdown",
        _ => "Razor",
    };

    protected override void OnParametersSet()
    {
        var code = Code.Trim();
        if (code == _source) return;
        _source = code;
        _html = CodeHighlighter.ToHtml(code, Language);
    }

    private async Task Copy()
    {
        try
        {
            await JS.InvokeVoidAsync("rioDocs.copy", _source);
            _copied = true;
            StateHasChanged();
            await Task.Delay(1600);
            _copied = false;
        }
        catch (JSException)
        {
        }
    }
}
