<footer class="site-footer">
    <div class="footer-brand">
        <RioLogo Size="22" />
        <span>RioCharts</span>
    </div>
    <p>
        Open source (MIT) and a 1.0 release candidate: the API is frozen until 1.0 (<a href="versions">versions and support</a>). Every chart here is rendered live in your browser
        with Blazor WebAssembly. Named after Rio, and <i>río</i> means river: fitting for flowing lines and time series.
        @if (LibraryVersion.Unreleased)
        {
            <span class="footer-version">
                Latest package on NuGet: @LibraryVersion.LatestRelease. This site runs a newer build from master
                (@LibraryVersion.Version, @CommitText): features under "Unreleased" in the
                <a href="https://github.com/joadan/RioCharts/blob/master/CHANGELOG.md">changelog</a> are not in the package yet.
            </span>
        }
        else if (LibraryVersion.Version.Length > 0)
        {
            <span class="footer-version">Version @LibraryVersion.Version (@CommitText).</span>
        }
    </p>
    <div class="footer-links">
        <a href="getting-started">Getting started</a>
        <a href="definitions">Playground</a>
        <a href="https://github.com/joadan/RioCharts">GitHub</a>
        <a href="https://github.com/joadan/RioCharts/issues">Issues</a>
        <a href="privacy">Privacy</a>
    </div>
</footer>

@code {
    private static RenderFragment CommitText => LibraryVersion.Commit is { } commit
        ? @<text>commit <a href="https://github.com/joadan/RioCharts/commit/@commit">@commit</a></text>
        : @<text>unknown commit</text>;
}
