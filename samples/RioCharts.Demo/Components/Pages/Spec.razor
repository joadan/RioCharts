@page "/spec"
@using RioCharts.AI
@using RioCharts.Core.Definitions

<PageTitle>RioCharts definition playground</PageTitle>

<header class="top">
    <div>
        <h1>Definition playground</h1>
        <p class="lead">
            JSON chart definitions, as an AI agent would write them: <code>&lt;RioChart Definition="definition" Datasets="datasets" /&gt;</code>.
            <a href="/">Back to the demo</a> · <a href="/ai/schema.json" target="_blank">JSON schema</a> ·
            <a href="/ai/tool.txt" target="_blank">create_chart tool description</a> · MCP server: <code>http://localhost:5030/mcp</code>
        </p>
    </div>
</header>

<main class="rio-theme-light">
    <div class="spec-layout">
        <section>
            <h2>Definition</h2>
            <div class="examples">
                @foreach (var (name, json) in Examples)
                {
                    <button class="small" @onclick="() => Load(json)">@name</button>
                }
            </div>
            <textarea class="spec-editor" spellcheck="false" @bind="_json" @bind:event="oninput" @bind:after="Render"></textarea>
            <p class="note">
                Datasets: @string.Join("; ", DemoDatasets.All.Select(d => $"{d.Name} ({string.Join(", ", d.Fields.Select(f => f.Name))})"))
            </p>
        </section>

        <section>
            <h2>Chart</h2>
            @if (_spec is not null)
            {
                <RioChart TItem="object" Definition="_spec" Datasets="DemoDatasets.ByName" Height="340" Zoomable="true" @ref="_chart" />
            }

            @if (_errors.Count > 0)
            {
                <ul class="spec-messages errors">
                    @foreach (var error in _errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            }

            @if (_warnings.Count > 0)
            {
                <ul class="spec-messages">
                    @foreach (var warning in _warnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            }

            @if (_razor is not null)
            {
                <h3>As Razor components</h3>
                <pre class="razor">@_razor</pre>
            }
        </section>
    </div>
</main>

@code {
    private static readonly (string Name, string Json)[] Examples =
    [
        ("Minimal", """
            {
              "dataset": "shop",
              "series": [{ "type": "line", "x": "timestamp", "y": "sessions" }]
            }
            """),
        ("One line per channel", """
            {
              "dataset": "shop",
              "title": "Sessions per channel",
              "y": { "title": "Sessions" },
              "series": [{ "type": "spline", "x": "timestamp", "y": "sessions", "groupBy": "channel" }],
              "annotations": [{ "value": 600, "label": "Campaign goal 600" }]
            }
            """),
        ("Revenue per day", """
            {
              "dataset": "shop",
              "title": "Revenue per day",
              "y": { "title": "€" },
              "series": [{ "type": "column", "x": "timestamp", "y": "revenue", "timeBucket": "daily",
                           "aggregate": "sum", "groupBy": "channel", "stack": "channels" }]
            }
            """),
        ("Categories (auto)", """
            {
              "dataset": "sales",
              "title": "Revenue per category, 2026 (k€)",
              "series": [{ "type": "auto", "x": "category", "y": "revenue", "aggregate": "sum", "sort": "desc" }]
            }
            """),
        ("Shares (auto donut)", """
            {
              "data": [ { "topic": "Delivery", "share": 48 }, { "topic": "Returns", "share": 27 },
                        { "topic": "Payment", "share": 15 }, { "topic": "Product question", "share": 10 } ],
              "series": [{ "type": "auto", "x": "topic", "y": "share" }]
            }
            """),
        ("Two axes", """
            {
              "dataset": "shop",
              "y": { "title": "Sessions" },
              "yAxes": [{ "id": "eur", "title": "€" }],
              "series": [
                { "type": "bar", "x": "timestamp", "y": "revenue", "timeBucket": "day", "aggregate": "sum", "yAxisId": "eur", "name": "Revenue" },
                { "type": "line", "x": "timestamp", "y": "sessions", "timeBucket": "day", "aggregate": "sum", "name": "Sessions" }
              ],
              "filter": "ignored: filters go on series"
            }
            """),
        ("With errors", """
            {
              "dataset": "shop",
              "series": [{ "type": "scatter", "x": "time", "y": "sesions" }]
            }
            """),
    ];

    private string _json = "";
    private ChartDefinition? _spec;
    private List<string> _errors = [];
    private List<string> _warnings = [];
    private string? _razor;
    private RioChart<object>? _chart;

    protected override void OnInitialized() => Load(Examples[1].Json);

    private void Load(string json)
    {
        _json = json;
        Render();
    }

    private void Render()
    {
        var parsed = ChartDefinitionJson.Parse(_json);
        _errors = parsed.Errors.Select(e => e.ToString()).ToList();
        _warnings = [.. parsed.Warnings];
        _spec = parsed.Definition;
        _razor = null;
        if (_spec is null)
        {
            return;
        }

        var bound = ChartDefinitionBinder.Bind(_spec, DemoDatasets.ByName);
        _errors.AddRange(bound.Errors.Select(e => e.ToString()));
        _warnings.AddRange(bound.Warnings);
        _razor = ChartRazor.FromDefinition(_spec, "Row", "rows");
    }
}
