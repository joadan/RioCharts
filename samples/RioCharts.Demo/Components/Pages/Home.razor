@page "/"
@implements IDisposable

<PageTitle>RioCharts demo</PageTitle>

<header class="top">
    <div>
        <h1>RioCharts</h1>
        <p class="lead">An online-store dashboard: line, area, bar, pie and radial charts with tooltips, stacking, multiple Y axes, annotations, zoom, live data and time zones. <a href="/spec">Spec playground (AI chart definitions)</a> · <a href="/map">World map</a></p>
    </div>
    <button class="theme" @onclick="() => _dark = !_dark">@(_dark ? "Light" : "Dark") theme</button>
</header>

<main class="@(_dark ? "rio-theme-dark dark-page" : "rio-theme-light")">
    <div class="grid">
        <section>
            <h2>Zero configuration</h2>
            <RioChart Items="_web">
                <LineSeries XValue="r => r.Time" YValue="r => r.Value" />
            </RioChart>
            <p class="note">A single series: no legend, time axis picked from the data.</p>
        </section>

        <section>
            <h2>Several series, gaps and toggling</h2>
            <RioChart @ref="_traffic" TItem="Reading" Title="Sessions per channel" YAxis="_sessionsAxis" @bind-HiddenSeries="_hidden" Exportable="true">
                <LineSeries Items="_web" Name="Web" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" />
                <LineSeries Items="_app" Name="App" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" />
                <LineSeries Items="_marketplace" Name="Marketplace" XValue="r => r.Time" YValue="r => r.Value" />
            </RioChart>
            <p class="note">Marketplace has a gap (feed outage). Click legend items to hide series. Hidden: @(_hidden.Count == 0 ? "none" : string.Join(", ", _hidden))</p>
            <p class="note">
                <button class="small" @onclick="ExportToServer">Export to .NET</button> @_exported
            </p>
        </section>

        <section>
            <h2>Area</h2>
            <RioChart Items="_revenue" YAxis="_eur">
                <AreaSeries Name="Revenue" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" />
            </RioChart>
        </section>

        <section>
            <h2>Grouped bars, categories</h2>
            <RioChart TItem="QuarterSales" Title="Revenue per quarter (€)">
                <BarSeries Items="_sales" Name="2025" XValue="s => s.Quarter" YValue="s => s.Last" />
                <BarSeries Items="_sales" Name="2026" XValue="s => s.Quarter" YValue="s => s.This" />
            </RioChart>
            <p class="note">Large numbers are compact (k, M).</p>
        </section>

        <section>
            <h2>Bars and a line over time</h2>
            <RioChart TItem="Reading" YAxis="_ordersAxis">
                <BarSeries Items="_daily" Name="Orders per day" XValue="r => r.Time" YValue="r => r.Value" />
                <LineSeries Items="_dailyAverage" Name="7-day average" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" />
            </RioChart>
            <p class="note">Default z-order: areas, then bars, then lines.</p>
        </section>

        <section>
            <h2>Step line</h2>
            <RioChart Items="_prices" YAxis="_eur">
                <LineSeries Name="Tent price" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Step" Format="0 €" />
            </RioChart>
            <p class="note">A price that changes for flash sales.</p>
        </section>

        <section>
            <h2>Annotations, tooltip and clicks</h2>
            <RioChart TItem="Reading" YAxis="_ms" OnPointClick="PointClicked" OnAnnotationClick="AnnotationClicked">
                <ReferenceBand From="0" To="200" Label="Fast" />
                <ReferenceBand Axis="AnnotationAxis.X" From="_incidentStart" To="_incidentEnd" Label="Payment incident" Color="#d9480f" />
                <ReferenceLine @bind-Value="_limit" Label="@($"Limit {_limit:0} ms")" Draggable="true" />
                <PointAnnotation X="_alert" Y="365" Label="Slow checkout alert" Color="#d9480f" />
                <Callout X="_deploy" Y="165" Label="Deploy v2.4" OffsetX="-30" OffsetY="-36" />
                <ReferenceLine Axis="AnnotationAxis.X" Value="_now" Label="Now" />
                <LineSeries Items="_checkout" Name="Checkout" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" Format="0 ms" />
                <LineSeries Items="_search" Name="Search" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" Format="0 ms" />
            </RioChart>
            <p class="note">Server response times. Hover for the shared tooltip; click a point or an annotation; drag the limit line (bound with <code>@@bind-Value</code>: @_limit.ToString("0") ms). @_clicked</p>
        </section>

        <section>
            <h2>Two Y axes</h2>
            <RioChart TItem="Reading" YAxis="_sessionsAxis" YAxes="_ordersAxes">
                <BarSeries Items="_hourlyOrders" Name="Orders" XValue="r => r.Time" YValue="r => r.Value" YAxisId="orders" Format="0" />
                <LineSeries Items="_hourlySessions" Name="Sessions" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" Format="0" />
            </RioChart>
            <p class="note">Orders use the right axis (<code>YAxisId="orders"</code>); the grid follows the left axis.</p>
        </section>

        <section>
            <h2>Four Y axes</h2>
            <RioChart TItem="Reading" Height="280" YAxis="_conversionAxis" YAxes="_manyAxes">
                <LineSeries Items="_hourlySessions" Name="Sessions" XValue="r => r.Time" YValue="r => r.Value" YAxisId="sessions" />
                <BarSeries Items="_hourlyOrders" Name="Orders" XValue="r => r.Time" YValue="r => r.Value" YAxisId="orders" Format="0" />
                <LineSeries Items="_hourlyRevenue" Name="Revenue" XValue="r => r.Time" YValue="r => r.Value" YAxisId="revenue" Format="#,0" />
                <LineSeries Items="_hourlyConversion" Name="Conversion" XValue="r => r.Time" YValue="r => r.Value" Format="P1" />
            </RioChart>
            <p class="note">Two axes on each side (<code>Position = AxisPosition.Left</code>): each sits under its own title.</p>
        </section>

        <section>
            <h2>Many categories</h2>
            <RioChart TItem="(string Country, double Count)" Items="@_signups.Take(_countries).ToList()" Height="260">
                <BarSeries Name="Sign-ups" XValue="c => c.Country" YValue="c => c.Count" Format="#,0" />
            </RioChart>
            <p class="note">
                Labels that do not fit side by side slope at 45 degrees (<code>AxisOptions.LabelRotation</code>). With one to three
                countries the bars take at most a fifth of the plot.
                <select @bind="_countries">
                    <option value="1">1 country</option>
                    <option value="3">3 countries</option>
                    <option value="18">18 countries</option>
                </select>
            </p>
        </section>

        <section>
            <h2>Dots on sparse data</h2>
            <RioChart TItem="Reading" Items="_weekly" Height="220">
                <LineSeries Name="Orders" XValue="r => r.Time" YValue="r => r.Value" Highlight="PointHighlight.All" Format="0" />
            </RioChart>
            <p class="note">Seven daily values: <code>Highlight="PointHighlight.All"</code> puts a dot on each.</p>
        </section>

        <section>
            <h2>Stacked bars with data labels</h2>
            <RioChart TItem="CategoryMix" Title="Revenue per month" YAxis="_keur">
                <BarSeries Items="_mix" Name="Shoes" XValue="m => m.Month" YValue="m => m.Shoes" Stack="revenue" DataLabels="true" />
                <BarSeries Items="_mix" Name="Clothing" XValue="m => m.Month" YValue="m => m.Clothing" Stack="revenue" DataLabels="true" />
                <BarSeries Items="_mix" Name="Camping" XValue="m => m.Month" YValue="m => m.Camping" Stack="revenue" DataLabels="true" />
            </RioChart>
            <p class="note">Labels show inside segments that are big enough. Toggle a series and the stack closes up.</p>
        </section>

        <section>
            <h2>Stacked areas</h2>
            <RioChart TItem="Reading" YAxis="_sessionsAxis">
                <AreaSeries Items="_organic" Name="Organic search" XValue="r => r.Time" YValue="r => r.Value" Stack="traffic" Curve="CurveType.Monotone" />
                <AreaSeries Items="_ads" Name="Ads" XValue="r => r.Time" YValue="r => r.Value" Stack="traffic" Curve="CurveType.Monotone" />
                <AreaSeries Items="_email" Name="Email" XValue="r => r.Time" YValue="r => r.Value" Stack="traffic" Curve="CurveType.Monotone" />
            </RioChart>
            <p class="note">Sessions per hour by traffic source.</p>
        </section>

        <section>
            <h2>Data labels on bars</h2>
            <RioChart TItem="QuarterSales" Tooltip="_singleTooltip">
                <BarSeries Items="_sales" Name="2025" XValue="s => s.Quarter" YValue="s => s.Last" DataLabels="true" />
                <BarSeries Items="_sales" Name="2026" XValue="s => s.Quarter" YValue="s => s.This" DataLabels="true" />
            </RioChart>
            <p class="note">This chart uses a per-bar tooltip (<code>Shared = false</code>).</p>
        </section>

        <section>
            <h2>Pie</h2>
            <RioChart TItem="Share" Title="Revenue by category, 2026" OnPointClick="SliceClicked">
                <PieSeries Items="_categories" Name="Revenue" XValue="s => s.Name" YValue="s => s.Value" GroupSmallSlices="0.03" Format="0 k€" />
            </RioChart>
            <p class="note">Slices under 3% are grouped into "Other"; small slices get outside labels. Click a slice or a legend item. @_sliceClicked</p>
        </section>

        <section>
            <h2>Donut</h2>
            <RioChart TItem="Share" Legend="_rightLegend">
                <DonutSeries Items="_channelShare" Name="Orders" XValue="s => s.Name" YValue="s => s.Value" />
            </RioChart>
            <p class="note">Orders per channel. The total sits in the middle; the legend is on the right.</p>
        </section>

        <section>
            <h2>Half donut and nested rings</h2>
            <div class="edge two">
                <RioChart TItem="Share" Height="220">
                    <DonutSeries Items="_channelShare" XValue="s => s.Name" YValue="s => s.Value" StartAngle="-90" EndAngle="90" />
                </RioChart>
                <RioChart TItem="Share" Height="220">
                    <PieSeries Items="_channelShare" Name="2026" XValue="s => s.Name" YValue="s => s.Value" InnerRadius="0.35" />
                    <PieSeries Items="_channelShareLastYear" Name="2025" XValue="s => s.Name" YValue="s => s.Value" />
                </RioChart>
            </div>
            <p class="note">Rings: the first series is the outer ring (2026), the inner ring is 2025.</p>
        </section>

        <section>
            <h2>Radial bars</h2>
            <RioChart TItem="Share" Title="Monthly sales target reached">
                <RadialBarSeries Items="_targets" Name="Target" XValue="s => s.Name" YValue="s => s.Value" Max="100" Format="0'%'" />
            </RioChart>
        </section>

        <section class="wide">
            <h2>Live data</h2>
            <RioChart TItem="double" Height="220" YAxis="_ms" RefreshInterval="250">
                <ReferenceLine Value="250" Label="Target" />
                <LineSeries Name="Checkout" Buffer="_liveCheckout" Curve="CurveType.Monotone" Format="0 ms" />
                <LineSeries Name="Search" Buffer="_liveSearch" Curve="CurveType.Monotone" Format="0 ms" />
            </RioChart>
            <p class="note">
                Response times in two <code>SeriesBuffer</code>s with a 2-minute window, fed four times a second from a timer; the chart
                redraws at most every 250 ms.
                <button class="small" @onclick="ToggleLive">@(_liveTimer is null ? "Start" : "Stop")</button>
            </p>
        </section>

        <section class="wide">
            <h2>Display time zone</h2>
            <RioChart TItem="Measurement" Items="_dst" TimeZone="@_zone" Height="220" YAxis="_sessionsAxis">
                <LineSeries Name="Sessions" XValue="m => m.Time" YValue="m => m.Value" Curve="CurveType.Monotone" Format="0" />
            </RioChart>
            <p class="note">
                Hourly UTC values (<code>DateTimeOffset</code>) across the end of summer time on 25 Oct 2026. Zone:
                <select @bind="_zone">
                    <option value="">none (as given)</option>
                    <option value="local">local (browser)</option>
                    <option value="UTC">UTC</option>
                    <option value="Europe/Stockholm">Europe/Stockholm</option>
                    <option value="America/New_York">America/New_York</option>
                </select>
                In Stockholm the line runs straight through the repeated hour; hover around 02:00.
            </p>
        </section>

        <section class="wide">
            <h2>Zoom, pan and linked charts</h2>
            <RioChart TItem="Reading" Height="220" YAxis="_sessionsAxis" Zoomable="true" Group="shop" @bind-VisibleRange="_range">
                <LineSeries Items="_web" Name="Web" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" Format="0" />
                <LineSeries Items="_app" Name="App" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" Format="0" />
            </RioChart>
            <RioChart TItem="Reading" Height="160" YAxis="_eur" Zoomable="true" Group="shop">
                <AreaSeries Items="_revenue" Name="Revenue" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" Format="0 €" />
            </RioChart>
            <p class="note">
                Drag to zoom, Shift+drag to pan, Ctrl+wheel to zoom at the pointer, double-click to reset. The two charts share the
                crosshair and the zoom (<code>Group="shop"</code>). Visible: @(_range is null ? "all" : $"{_range.Min:g} – {_range.Max:g}")
                <button class="small" @onclick="() => _range = ChartRange.Of(new DateTime(2026, 11, 17, 6, 0, 0), new DateTime(2026, 11, 17, 18, 0, 0))">Show 17 Nov 06–18</button>
            </p>
        </section>

        <section class="wide">
            <h2>Server-side export (RioCharts.Skia)</h2>
            <img class="export" src="@($"/export/traffic.png?theme={(_dark ? "dark" : "light")}")" alt="Sessions per channel chart rendered on the server" />
            <p class="note">
                A PNG from <code>ChartExport.ToPng(spec, data)</code>: the same chart model and layout, rendered with SkiaSharp on the
                server, with real font metrics. Also as
                <a href="/export/traffic.svg" target="_blank">SVG</a> and <a href="/export/traffic.png?theme=dark" target="_blank">dark PNG</a>.
            </p>
        </section>

        <section class="wide">
            <h2>Columnar fast path: 200 000 points</h2>
            <RioChart TItem="double" Height="260" Zoomable="true" SeriesLayer="_bigLayer" YAxis="_ms">
                <LineSeries Name="Response time" Data="_big" StrokeWidth="1.25" Format="0 ms" />
            </RioChart>
            <p class="note">
                Passed as arrays with <code>SeriesData.From(times, values)</code>; downsampled with LTTB to the plot width. Zoom in: only the
                visible points are downsampled, so detail appears. Series layer: @_bigLayer
                <button class="small" @onclick="() => _bigLayer = _bigLayer == SeriesLayer.Svg ? SeriesLayer.Canvas : SeriesLayer.Svg">Switch to @(_bigLayer == SeriesLayer.Svg ? "canvas" : "SVG")</button>
            </p>
        </section>

        <section class="wide resizable">
            <h2>Responsive: drag the corner to resize</h2>
            <RioChart Items="_web" Height="220">
                <AreaSeries Name="Sessions" XValue="r => r.Time" YValue="r => r.Value" />
            </RioChart>
        </section>

        <section>
            <h2>Edge cases</h2>
            <div class="edge">
                <RioChart TItem="Reading" Height="140" Title="Empty">
                    <LineSeries Items="_empty" XValue="r => r.Time" YValue="r => r.Value" />
                </RioChart>
                <RioChart TItem="Reading" Height="140" Title="One point">
                    <LineSeries Items="_onePoint" XValue="r => r.Time" YValue="r => r.Value" />
                </RioChart>
                <RioChart TItem="Reading" Height="140" Title="All equal">
                    <LineSeries Items="_flat" XValue="r => r.Time" YValue="r => r.Value" />
                </RioChart>
            </div>
        </section>

        <section class="custom-palette">
            <h2>Theme tokens</h2>
            <RioChart TItem="QuarterSales">
                <LineSeries Items="_sales" Name="2025" XValue="s => s.Quarter" YValue="s => s.Last" />
                <LineSeries Items="_sales" Name="2026" XValue="s => s.Quarter" YValue="s => s.This" />
            </RioChart>
            <p class="note">Colors overridden with <code>--rio-series-1</code> and <code>--rio-series-2</code> in CSS.</p>
        </section>
    </div>
</main>

@code {
    private sealed record Reading(DateTime Time, double? Value);
    private sealed record QuarterSales(string Quarter, double Last, double This);
    private sealed record CategoryMix(string Month, double Shoes, double Clothing, double Camping);
    private sealed record Share(string Name, double Value);
    private sealed record Measurement(DateTimeOffset Time, double Value);

    private RioChart<Reading>? _traffic;
    private string? _exported;

    // Images reach .NET as a stream, so they may exceed Blazor Server's 32 KB message limit.
    private async Task ExportToServer()
    {
        var png = await _traffic!.ExportPngAsync(new ChartImageOptions { Scale = 4 });
        var svg = await _traffic.ExportSvgAsync();
        _exported = $"PNG {png.Length / 1024.0:0} KB, SVG {svg.Length / 1024.0:0} KB, CSV {_traffic.ExportCsv().Length / 1024.0:0} KB";
    }

    private string? _zone = "Europe/Stockholm";
    private readonly List<Measurement> _dst = Enumerable.Range(0, 36)
        .Select(h => new Measurement(new DateTimeOffset(2026, 10, 24, 12, 0, 0, TimeSpan.Zero).AddHours(h),
            Math.Round(420 + 300 * Math.Sin((h - 3) / 24.0 * 2 * Math.PI))))
        .ToList();

    private readonly LegendOptions _rightLegend = new() { Position = LegendPosition.Right };
    private string _sliceClicked = "";

    private readonly List<Share> _categories =
    [
        new("Shoes", 447), new("Clothing", 313), new("Camping", 224), new("Accessories", 125), new("Bikes", 41),
        new("Gift cards", 12), new("Repairs", 7),
    ];

    private readonly List<Share> _channelShare = [new("Web", 2140), new("App", 1390), new("Marketplace", 760)];
    private readonly List<Share> _channelShareLastYear = [new("Web", 2310), new("App", 940), new("Marketplace", 520)];
    private readonly List<Share> _targets = [new("Shoes", 87), new("Clothing", 74), new("Camping", 41), new("Accessories", 92)];

    private void SliceClicked(PointClickEventArgs<Share> e) => _sliceClicked = $"Clicked {e.Item?.Name}: {e.Item?.Value} k€.";

    private bool _dark;
    private IReadOnlyCollection<string> _hidden = [];
    private string _clicked = "";
    private ChartRange? _range;
    private SeriesLayer _bigLayer = SeriesLayer.Canvas;

    // ---------- Live data ----------

    private readonly SeriesBuffer _liveCheckout = new(timeWindow: TimeSpan.FromMinutes(2));
    private readonly SeriesBuffer _liveSearch = new(timeWindow: TimeSpan.FromMinutes(2));
    private readonly Random _liveRandom = new(7);
    private Timer? _liveTimer;
    private double _checkoutValue = 210, _searchValue = 130;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            // Two minutes of history, then live values.
            var now = DateTime.Now;
            for (var i = 480; i > 0; i--)
            {
                AppendLive(now.AddMilliseconds(-250 * i));
            }

            ToggleLive();
            StateHasChanged();
        }
    }

    private void ToggleLive()
    {
        if (_liveTimer is null)
        {
            _liveTimer = new Timer(_ => AppendLive(DateTime.Now), null, 0, 250);
        }
        else
        {
            _liveTimer.Dispose();
            _liveTimer = null;
        }
    }

    private void AppendLive(DateTime t)
    {
        lock (_liveRandom)
        {
            _checkoutValue += (_liveRandom.NextDouble() - 0.5) * 12 + (210 - _checkoutValue) * 0.02;
            _searchValue += (_liveRandom.NextDouble() - 0.5) * 5 + (130 - _searchValue) * 0.02;
            _liveCheckout.Append(t, _checkoutValue);
            _liveSearch.Append(t, _searchValue);
        }
    }

    public void Dispose() => _liveTimer?.Dispose();

    private readonly AxisOptions _sessionsAxis = new() { Title = "Sessions" };
    private readonly AxisOptions _ordersAxis = new() { Title = "Orders" };
    private readonly AxisOptions _eur = new() { Title = "€" };
    private readonly AxisOptions _keur = new() { Title = "k€" };
    private readonly AxisOptions _ms = new() { Title = "ms" };
    private readonly IReadOnlyList<AxisOptions> _ordersAxes = [new() { Id = "orders", Title = "Orders" }];
    private readonly AxisOptions _conversionAxis = new() { Title = "Conversion" };
    private readonly IReadOnlyList<AxisOptions> _manyAxes =
    [
        new() { Id = "sessions", Title = "Sessions per hour", Position = AxisPosition.Left },
        new() { Id = "orders", Title = "Orders" },
        new() { Id = "revenue", Title = "Revenue, EUR" },
    ];

    private static readonly (string Country, double Count)[] _signups = [.. new[]
    {
        "Germany", "France", "United Kingdom", "Spain", "Italy", "Netherlands", "Poland", "Sweden", "Belgium", "Austria",
        "Switzerland", "Denmark", "Norway", "Finland", "Portugal", "Ireland", "Czech Republic", "Greece",
    }.Select((name, i) => (name, Math.Round(4200 * Math.Pow(0.82, i))))];
    private readonly TooltipOptions _singleTooltip = new() { Shared = false };

    private DateTime _incidentStart, _incidentEnd, _now, _alert, _deploy;
    private double _limit = 300;
    private List<Reading> _hourlyOrders = [];
    private List<Reading> _hourlySessions = [];
    private List<Reading> _hourlyRevenue = [];
    private int _countries = 18;
    private List<Reading> _weekly = [];
    private List<Reading> _hourlyConversion = [];
    private List<Reading> _organic = [];
    private List<Reading> _ads = [];
    private List<Reading> _email = [];

    // Revenue per category and month, k€ (the same numbers as the "sales" definition dataset).
    private readonly List<CategoryMix> _mix =
    [
        new("Jan", 42, 18, 6), new("Feb", 38, 17, 7), new("Mar", 29, 21, 11), new("Apr", 33, 24, 19),
        new("May", 36, 26, 28), new("Jun", 31, 22, 35),
    ];

    private void PointClicked(PointClickEventArgs<Reading> e) =>
        _clicked = $"Clicked {e.SeriesName}: {e.Item?.Value:0} ms at {e.Item?.Time:g}.";

    private void AnnotationClicked(AnnotationClickEventArgs e) =>
        _clicked = $"Clicked annotation '{e.Label}'.";

    private List<Reading> _web = [];
    private List<Reading> _app = [];
    private List<Reading> _marketplace = [];
    private List<Reading> _revenue = [];
    private List<Reading> _checkout = [];
    private List<Reading> _search = [];
    private List<Reading> _daily = [];
    private List<Reading> _dailyAverage = [];
    private List<Reading> _prices = [];
    private readonly List<Reading> _empty = [];
    private List<Reading> _onePoint = [];
    private List<Reading> _flat = [];
    private SeriesData _big = SeriesData.Empty;

    private readonly List<QuarterSales> _sales =
    [
        new("Q1", 182_000, 214_000),
        new("Q2", 236_000, 251_000),
        new("Q3", 198_000, 243_000),
        new("Q4", 271_000, 305_000),
    ];

    protected override void OnInitialized()
    {
        var random = new Random(3);
        var start = new DateTime(2026, 11, 16);

        // Two days of 15-minute values; traffic peaks in the evening.
        for (var i = 0; i < 2 * 96; i++)
        {
            var t = start.AddMinutes(15 * i);
            var dayCycle = Math.Sin((t.Hour + t.Minute / 60.0 - 14) / 24 * 2 * Math.PI);
            var web = Math.Round(Math.Max(5, 140 + 110 * dayCycle + random.NextDouble() * 25));
            var app = Math.Round(Math.Max(3, 90 + 75 * dayCycle + random.NextDouble() * 18));
            var marketplace = Math.Round(Math.Max(2, 50 + 35 * dayCycle + random.NextDouble() * 10));
            _web.Add(new Reading(t, web));
            _app.Add(new Reading(t, app));
            _marketplace.Add(new Reading(t, i is >= 60 and < 75 ? null : marketplace));
            _revenue.Add(new Reading(t, Math.Round((web + app + marketplace) * 2.1 + random.NextDouble() * 80)));
            _checkout.Add(new Reading(t, Math.Round(220 + 60 * dayCycle + random.NextDouble() * 20)));
            _search.Add(new Reading(t, Math.Round(140 + 40 * dayCycle + random.NextDouble() * 15)));
        }

        // Five weeks of daily orders.
        var days = Enumerable.Range(0, 35).Select(d => start.AddDays(d - 34)).ToList();
        _daily = days.Select(d => new Reading(d, Math.Round(220 + 60 * Math.Sin(d.DayOfYear / 5.0) + random.Next(-25, 25), 0))).ToList();
        _dailyAverage = _daily.Select((r, i) => new Reading(r.Time, _daily.Skip(Math.Max(0, i - 6)).Take(Math.Min(7, i + 1)).Average(x => x.Value))).ToList();

        _prices =
        [
            new(start, 249), new(start.AddHours(6), 249), new(start.AddHours(7), 199), new(start.AddHours(17), 199),
            new(start.AddHours(18), 229), new(start.AddHours(30), 229), new(start.AddHours(31), 189), new(start.AddHours(41), 189),
            new(start.AddHours(42), 249), new(start.AddHours(48), 249),
        ];

        _incidentStart = start.AddHours(26);
        _incidentEnd = start.AddHours(31);
        _now = start.AddHours(45);
        _alert = start.AddHours(43);
        _deploy = start.AddHours(9);

        // Hourly values over two days.
        for (var h = 0; h < 48; h++)
        {
            var t = start.AddHours(h);
            var dayCycle = Math.Sin((t.Hour - 14) / 24.0 * 2 * Math.PI);
            var sessions = Math.Round(1100 + 850 * dayCycle + random.NextDouble() * 150);
            _hourlySessions.Add(new Reading(t, sessions));
            _hourlyOrders.Add(new Reading(t, Math.Round(sessions * (0.022 + random.NextDouble() * 0.008))));
            var morning = t.Hour is >= 8 and < 12;
            _organic.Add(new Reading(t, Math.Round(Math.Max(20, 520 + 400 * dayCycle + random.NextDouble() * 60))));
            _ads.Add(new Reading(t, Math.Round(Math.Max(10, 260 + 200 * dayCycle + random.NextDouble() * 40))));
            _email.Add(new Reading(t, Math.Round((morning ? 180 : 40) + random.NextDouble() * 20)));
        }

        // Revenue and conversion per hour, from the orders and sessions above (no new random numbers, so the other charts stay the same).
        _hourlyRevenue = _hourlyOrders.Select((o, h) => new Reading(o.Time, Math.Round(o.Value!.Value * (64 + 6 * Math.Sin(h / 3.0))))).ToList();
        _hourlyConversion = _hourlyOrders.Zip(_hourlySessions, (o, s) => new Reading(o.Time, o.Value / s.Value)).ToList();

        _weekly = [.. _daily.TakeLast(7)];

        _onePoint = [new(start, 420)];
        _flat = Enumerable.Range(0, 24).Select(h => new Reading(start.AddHours(h), 300)).ToList();

        // A large series as plain arrays (the columnar fast path): response times every 13 seconds for a month.
        const int n = 200_000;
        var times = new DateTime[n];
        var values = new double[n];
        var value = 180.0;
        for (var i = 0; i < n; i++)
        {
            times[i] = start.AddDays(-30).AddSeconds(i * 13);
            value += (random.NextDouble() - 0.5) * 2 + (180 - value) * 0.001;
            values[i] = i == 150_000 ? value + 120 : value;
        }

        _big = SeriesData.From(times, values);
    }
}
