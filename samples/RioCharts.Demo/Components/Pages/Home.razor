@page "/"

<PageTitle>RioCharts demo</PageTitle>

<header class="top">
    <div>
        <h1>RioCharts</h1>
        <p class="lead">Line, area and bar series with tooltips, stacking, multiple Y axes, data labels and annotations; responsive and themeable.</p>
    </div>
    <button class="theme" @onclick="() => _dark = !_dark">@(_dark ? "Light" : "Dark") theme</button>
</header>

<main class="@(_dark ? "rio-theme-dark dark-page" : "rio-theme-light")">
    <div class="grid">
        <section>
            <h2>Zero configuration</h2>
            <Chart Items="_supply">
                <LineSeries XValue="r => r.Time" YValue="r => r.Value" />
            </Chart>
            <p class="note">A single series: no legend, time axis picked from the data.</p>
        </section>

        <section>
            <h2>Several series, gaps and toggling</h2>
            <Chart TItem="Reading" Title="Air handling unit" YAxis="_celsius" @bind-HiddenSeries="_hidden">
                <LineSeries Items="_supply" Name="Supply" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" />
                <LineSeries Items="_extract" Name="Extract" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" />
                <LineSeries Items="_outdoor" Name="Outdoor" XValue="r => r.Time" YValue="r => r.Value" />
            </Chart>
            <p class="note">Outdoor has a sensor gap. Click legend items to hide series. Hidden: @(_hidden.Count == 0 ? "none" : string.Join(", ", _hidden))</p>
        </section>

        <section>
            <h2>Area</h2>
            <Chart Items="_energy" YAxis="_kwh">
                <AreaSeries Name="Heating" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" />
            </Chart>
        </section>

        <section>
            <h2>Grouped bars, categories</h2>
            <Chart TItem="QuarterSales" Title="Sales per quarter">
                <BarSeries Items="_sales" Name="2025" XValue="s => s.Quarter" YValue="s => s.Last" />
                <BarSeries Items="_sales" Name="2026" XValue="s => s.Quarter" YValue="s => s.This" />
            </Chart>
            <p class="note">Large numbers are compact (k, M).</p>
        </section>

        <section>
            <h2>Bars and a line over time</h2>
            <Chart TItem="Reading" YAxis="_kwh">
                <BarSeries Items="_daily" Name="Daily use" XValue="r => r.Time" YValue="r => r.Value" />
                <LineSeries Items="_dailyAverage" Name="7-day average" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" />
            </Chart>
            <p class="note">Default z-order: areas, then bars, then lines.</p>
        </section>

        <section>
            <h2>Step line</h2>
            <Chart Items="_setpoints" YAxis="_celsius">
                <LineSeries Name="Setpoint" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Step" />
            </Chart>
        </section>

        <section>
            <h2>Annotations, tooltip and clicks</h2>
            <Chart TItem="Reading" YAxis="_celsius" OnPointClick="PointClicked" OnAnnotationClick="AnnotationClicked">
                <ReferenceBand From="20" To="24" Label="Comfort zone" />
                <ReferenceBand Axis="AnnotationAxis.X" From="_faultStart" To="_faultEnd" Label="Fan fault" Color="#d9480f" />
                <ReferenceLine Value="21" Label="Setpoint 21 °C" />
                <ReferenceLine Axis="AnnotationAxis.X" Value="_now" Label="Now" />
                <LineSeries Items="_supply" Name="Supply" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" Format="0.0 °C" />
                <LineSeries Items="_extract" Name="Extract" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" Format="0.0 °C" />
            </Chart>
            <p class="note">Hover for the shared tooltip; click a point or an annotation. @_clicked</p>
        </section>

        <section>
            <h2>Two Y axes</h2>
            <Chart TItem="Reading" YAxis="_celsius" YAxes="_energyAxis">
                <BarSeries Items="_hourlyEnergy" Name="Energy" XValue="r => r.Time" YValue="r => r.Value" YAxisId="energy" Format="0 kWh" />
                <LineSeries Items="_hourlyOutdoor" Name="Outdoor" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" Format="0.0 °C" />
            </Chart>
            <p class="note">Energy uses the right axis (<code>YAxisId="energy"</code>); the grid follows the left axis.</p>
        </section>

        <section>
            <h2>Stacked bars with data labels</h2>
            <Chart TItem="EnergyMix" Title="Heat supply per month" YAxis="_mwh">
                <BarSeries Items="_mix" Name="District heating" XValue="m => m.Month" YValue="m => m.District" Stack="heat" DataLabels="true" />
                <BarSeries Items="_mix" Name="Heat pump" XValue="m => m.Month" YValue="m => m.HeatPump" Stack="heat" DataLabels="true" />
                <BarSeries Items="_mix" Name="Solar" XValue="m => m.Month" YValue="m => m.Solar" Stack="heat" DataLabels="true" />
            </Chart>
            <p class="note">Labels show inside segments that are big enough. Toggle a series and the stack closes up.</p>
        </section>

        <section>
            <h2>Stacked areas</h2>
            <Chart TItem="Reading" YAxis="_kwh">
                <AreaSeries Items="_heating" Name="Heating" XValue="r => r.Time" YValue="r => r.Value" Stack="use" Curve="CurveType.Monotone" />
                <AreaSeries Items="_ventilation" Name="Ventilation" XValue="r => r.Time" YValue="r => r.Value" Stack="use" Curve="CurveType.Monotone" />
                <AreaSeries Items="_lighting" Name="Lighting" XValue="r => r.Time" YValue="r => r.Value" Stack="use" Curve="CurveType.Monotone" />
            </Chart>
        </section>

        <section>
            <h2>Data labels on bars</h2>
            <Chart TItem="QuarterSales" Tooltip="_singleTooltip">
                <BarSeries Items="_sales" Name="2025" XValue="s => s.Quarter" YValue="s => s.Last" DataLabels="true" />
                <BarSeries Items="_sales" Name="2026" XValue="s => s.Quarter" YValue="s => s.This" DataLabels="true" />
            </Chart>
            <p class="note">This chart uses a per-bar tooltip (<code>Shared = false</code>).</p>
        </section>

        <section>
            <h2>Pie</h2>
            <Chart TItem="Share" Title="Energy use by system" OnPointClick="SliceClicked">
                <PieSeries Items="_use" Name="Energy use" XValue="s => s.Name" YValue="s => s.Value" GroupSmallSlices="0.03" Format="0 MWh" />
            </Chart>
            <p class="note">Slices under 3% are grouped into "Other"; small slices get outside labels. Click a slice or a legend item. @_sliceClicked</p>
        </section>

        <section>
            <h2>Donut</h2>
            <Chart TItem="Share" Legend="_rightLegend">
                <DonutSeries Items="_supplyShare" Name="Heat supply" XValue="s => s.Name" YValue="s => s.Value" />
            </Chart>
            <p class="note">The total sits in the middle; the legend is on the right.</p>
        </section>

        <section>
            <h2>Half donut and nested rings</h2>
            <div class="edge two">
                <Chart TItem="Share" Height="220">
                    <DonutSeries Items="_supplyShare" XValue="s => s.Name" YValue="s => s.Value" StartAngle="-90" EndAngle="90" />
                </Chart>
                <Chart TItem="Share" Height="220">
                    <PieSeries Items="_supplyShare" Name="2026" XValue="s => s.Name" YValue="s => s.Value" InnerRadius="0.35" />
                    <PieSeries Items="_supplyShareLastYear" Name="2025" XValue="s => s.Name" YValue="s => s.Value" />
                </Chart>
            </div>
            <p class="note">Rings: the first series is the outer ring (2026), the inner ring is 2025.</p>
        </section>

        <section>
            <h2>Radial bars</h2>
            <Chart TItem="Share" Title="Component health">
                <RadialBarSeries Items="_health" Name="Health" XValue="s => s.Name" YValue="s => s.Value" Max="100" Format="0'%'" />
            </Chart>
        </section>

        <section class="wide">
            <h2>Zoom, pan and linked charts</h2>
            <Chart TItem="Reading" Height="220" YAxis="_celsius" Zoomable="true" Group="ahu" @bind-VisibleRange="_range">
                <LineSeries Items="_supply" Name="Supply" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" Format="0.0 °C" />
                <LineSeries Items="_extract" Name="Extract" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" Format="0.0 °C" />
            </Chart>
            <Chart TItem="Reading" Height="160" YAxis="_kwh" Zoomable="true" Group="ahu">
                <AreaSeries Items="_energy" Name="Heating" XValue="r => r.Time" YValue="r => r.Value" Curve="CurveType.Monotone" Format="0.0 kWh" />
            </Chart>
            <p class="note">
                Drag to zoom, Shift+drag to pan, Ctrl+wheel to zoom at the pointer, double-click to reset. The two charts share the
                crosshair and the zoom (<code>Group="ahu"</code>). Visible: @(_range is null ? "all" : $"{_range.Min:g} – {_range.Max:g}")
                <button class="small" @onclick="() => _range = ChartRange.Of(new DateTime(2026, 11, 17, 6, 0, 0), new DateTime(2026, 11, 17, 18, 0, 0))">Show 17 Nov 06–18</button>
            </p>
        </section>

        <section class="wide">
            <h2>Columnar fast path: 200 000 points</h2>
            <Chart TItem="double" Height="260" Zoomable="true">
                <LineSeries Name="Sensor" Data="_big" StrokeWidth="1.25" />
            </Chart>
            <p class="note">Passed as arrays with <code>SeriesData.From(times, values)</code>; downsampled with LTTB to the plot width. Zoom in: only the visible points are downsampled, so detail appears.</p>
        </section>

        <section class="wide resizable">
            <h2>Responsive: drag the corner to resize</h2>
            <Chart Items="_supply" Height="220">
                <AreaSeries Name="Supply" XValue="r => r.Time" YValue="r => r.Value" />
            </Chart>
        </section>

        <section>
            <h2>Edge cases</h2>
            <div class="edge">
                <Chart TItem="Reading" Height="140" Title="Empty">
                    <LineSeries Items="_empty" XValue="r => r.Time" YValue="r => r.Value" />
                </Chart>
                <Chart TItem="Reading" Height="140" Title="One point">
                    <LineSeries Items="_onePoint" XValue="r => r.Time" YValue="r => r.Value" />
                </Chart>
                <Chart TItem="Reading" Height="140" Title="All equal">
                    <LineSeries Items="_flat" XValue="r => r.Time" YValue="r => r.Value" />
                </Chart>
            </div>
        </section>

        <section class="custom-palette">
            <h2>Theme tokens</h2>
            <Chart TItem="QuarterSales">
                <LineSeries Items="_sales" Name="2025" XValue="s => s.Quarter" YValue="s => s.Last" />
                <LineSeries Items="_sales" Name="2026" XValue="s => s.Quarter" YValue="s => s.This" />
            </Chart>
            <p class="note">Colors overridden with <code>--rio-series-1</code> and <code>--rio-series-2</code> in CSS.</p>
        </section>
    </div>
</main>

@code {
    private sealed record Reading(DateTime Time, double? Value);
    private sealed record QuarterSales(string Quarter, double Last, double This);
    private sealed record EnergyMix(string Month, double District, double HeatPump, double Solar);
    private sealed record Share(string Name, double Value);

    private readonly LegendSpec _rightLegend = new() { Position = LegendPosition.Right };
    private string _sliceClicked = "";

    private readonly List<Share> _use =
    [
        new("Heating", 412), new("Ventilation", 236), new("Cooling", 148), new("Lighting", 97), new("Pumps", 31),
        new("Elevators", 9), new("Controls", 6),
    ];

    private readonly List<Share> _supplyShare = [new("District heating", 214), new("Heat pump", 96), new("Solar", 38)];
    private readonly List<Share> _supplyShareLastYear = [new("District heating", 251), new("Heat pump", 71), new("Solar", 22)];
    private readonly List<Share> _health = [new("Supply fan", 87), new("Extract fan", 74), new("Filter", 41), new("Heat recovery", 92)];

    private void SliceClicked(PointClickEventArgs<Share> e) => _sliceClicked = $"Clicked {e.Item?.Name}: {e.Item?.Value} MWh.";

    private bool _dark;
    private IReadOnlyCollection<string> _hidden = [];
    private string _clicked = "";
    private ChartRange? _range;

    private readonly AxisSpec _celsius = new() { Title = "°C" };
    private readonly AxisSpec _kwh = new() { Title = "kWh" };
    private readonly AxisSpec _mwh = new() { Title = "MWh" };
    private readonly IReadOnlyList<AxisSpec> _energyAxis = [new() { Id = "energy", Title = "kWh" }];
    private readonly TooltipSpec _singleTooltip = new() { Shared = false };

    private DateTime _faultStart, _faultEnd, _now;
    private List<Reading> _hourlyEnergy = [];
    private List<Reading> _hourlyOutdoor = [];
    private List<Reading> _heating = [];
    private List<Reading> _ventilation = [];
    private List<Reading> _lighting = [];

    private readonly List<EnergyMix> _mix =
    [
        new("Jan", 42, 18, 1), new("Feb", 38, 17, 2), new("Mar", 29, 15, 5), new("Apr", 17, 11, 8),
        new("May", 8, 6, 11), new("Jun", 4, 3, 12),
    ];

    private void PointClicked(PointClickEventArgs<Reading> e) =>
        _clicked = $"Clicked {e.SeriesName}: {e.Item?.Value:0.0} °C at {e.Item?.Time:g}.";

    private void AnnotationClicked(AnnotationClickEventArgs e) =>
        _clicked = $"Clicked annotation '{e.Label}'.";

    private List<Reading> _supply = [];
    private List<Reading> _extract = [];
    private List<Reading> _outdoor = [];
    private List<Reading> _energy = [];
    private List<Reading> _daily = [];
    private List<Reading> _dailyAverage = [];
    private List<Reading> _setpoints = [];
    private readonly List<Reading> _empty = [];
    private List<Reading> _onePoint = [];
    private List<Reading> _flat = [];
    private SeriesData _big = SeriesData.Empty;

    private readonly List<QuarterSales> _sales =
    [
        new("Q1", 182_000, 214_000),
        new("Q2", 236_000, 251_000),
        new("Q3", 198_000, 243_000),
        new("Q4", 271_000, 305_000),
    ];

    protected override void OnInitialized()
    {
        var random = new Random(3);
        var start = new DateTime(2026, 11, 16);

        // Two days of 15-minute readings.
        for (var i = 0; i < 2 * 96; i++)
        {
            var t = start.AddMinutes(15 * i);
            var dayCycle = Math.Sin((t.Hour + t.Minute / 60.0 - 9) / 24 * 2 * Math.PI);
            _outdoor.Add(new Reading(t, i is >= 60 and < 75 ? null : Math.Round(4 + 5 * dayCycle + random.NextDouble(), 1)));
            _supply.Add(new Reading(t, Math.Round(19 + 1.5 * dayCycle + random.NextDouble() * 0.4, 1)));
            _extract.Add(new Reading(t, Math.Round(22 + 0.8 * dayCycle + random.NextDouble() * 0.3, 1)));
            _energy.Add(new Reading(t, Math.Round(Math.Max(0, 14 - 9 * dayCycle + random.NextDouble() * 2), 1)));
        }

        // Five weeks of daily values.
        var days = Enumerable.Range(0, 35).Select(d => start.AddDays(d - 34)).ToList();
        _daily = days.Select(d => new Reading(d, Math.Round(220 + 60 * Math.Sin(d.DayOfYear / 5.0) + random.Next(-25, 25), 0))).ToList();
        _dailyAverage = _daily.Select((r, i) => new Reading(r.Time, _daily.Skip(Math.Max(0, i - 6)).Take(Math.Min(7, i + 1)).Average(x => x.Value))).ToList();

        _setpoints =
        [
            new(start, 21), new(start.AddHours(6), 21), new(start.AddHours(7), 22.5), new(start.AddHours(17), 22.5),
            new(start.AddHours(18), 20), new(start.AddHours(30), 20), new(start.AddHours(31), 22.5), new(start.AddHours(41), 22.5),
            new(start.AddHours(42), 20), new(start.AddHours(48), 20),
        ];

        _faultStart = start.AddHours(26);
        _faultEnd = start.AddHours(31);
        _now = start.AddHours(44);

        // Hourly values over two days.
        for (var h = 0; h < 48; h++)
        {
            var t = start.AddHours(h);
            var dayCycle = Math.Sin((t.Hour - 9) / 24.0 * 2 * Math.PI);
            var outdoor = Math.Round(4 + 5 * dayCycle + random.NextDouble(), 1);
            _hourlyOutdoor.Add(new Reading(t, outdoor));
            _hourlyEnergy.Add(new Reading(t, Math.Round(30 - 2.2 * outdoor + random.NextDouble() * 4, 0)));
            var occupied = t.Hour is >= 7 and < 18;
            _heating.Add(new Reading(t, Math.Round(Math.Max(2, 14 - 1.4 * outdoor + random.NextDouble() * 2), 1)));
            _ventilation.Add(new Reading(t, Math.Round((occupied ? 6 : 2) + random.NextDouble(), 1)));
            _lighting.Add(new Reading(t, Math.Round((occupied ? 3.5 : 0.6) + random.NextDouble() * 0.5, 1)));
        }

        _onePoint = [new(start, 21.5)];
        _flat = Enumerable.Range(0, 24).Select(h => new Reading(start.AddHours(h), 21)).ToList();

        // A large series as plain arrays (the columnar fast path).
        const int n = 200_000;
        var times = new DateTime[n];
        var values = new double[n];
        var value = 20.0;
        for (var i = 0; i < n; i++)
        {
            times[i] = start.AddDays(-30).AddSeconds(i * 13);
            value += (random.NextDouble() - 0.5) * 0.08;
            values[i] = i == 150_000 ? value + 6 : value;
        }

        _big = SeriesData.From(times, values);
    }
}
